# ============================================================
# S3
# ============================================================

def upload_report(csv_data, run_id, label, timestamp):

    mode = (
        "dry-run"
        if DRY_RUN
        else "delete"
    )

    key = (
        f"{REPORT_PREFIX}"
        f"snapshot-report-"
        f"{label}-"
        f"{RETENTION_DAYS}days-"
        f"{mode}-"
        f"{timestamp}-"
        f"{run_id}.csv"
    )

    s3.put_object(
        Bucket=REPORT_BUCKET,
        Key=key,
        Body=csv_data.encode("utf-8"),
        ContentType="text/csv",
        ServerSideEncryption="aws:kms",
        SSEKMSKeyId=KMS_KEY_ID
    )

    # NOTE (audit caveat, not fixed automatically): if this Lambda's own
    # execution role credentials are temporary (the normal case), a
    # presigned URL signed with them stops working once those credentials
    # expire -- which can happen well before PRESIGNED_URL_EXPIRY elapses.
    # Treat PRESIGNED_URL_EXPIRY as an upper bound, not a guarantee.
    presigned_url = (
        s3.generate_presigned_url(
            "get_object",
            Params={
                "Bucket": REPORT_BUCKET,
                "Key": key
            },
            ExpiresIn=PRESIGNED_URL_EXPIRY
        )
    )

    return key, presigned_url


def upload_html_summary(html_data, run_id, timestamp):

    mode = (
        "dry-run"
        if DRY_RUN
        else "delete"
    )

    key = (
        f"{REPORT_PREFIX}"
        f"summary-report-"
        f"{RETENTION_DAYS}days-"
        f"{mode}-"
        f"{timestamp}-"
        f"{run_id}.html"
    )

    s3.put_object(
        Bucket=REPORT_BUCKET,
        Key=key,
        Body=html_data.encode("utf-8"),
        ContentType="text/html",
        ServerSideEncryption="aws:kms",
        SSEKMSKeyId=KMS_KEY_ID
    )

    presigned_url = (
        s3.generate_presigned_url(
            "get_object",
            Params={
                "Bucket": REPORT_BUCKET,
                "Key": key
            },
            ExpiresIn=PRESIGNED_URL_EXPIRY
        )
    )

    return key, presigned_url


# ============================================================
# SNS
# ============================================================

def send_sns(summary_list, reports, summary_report_url, run_id):

    # Kept deliberately short: SNS email is plain text and cannot render
    # a table, and repeating a full per-account breakdown as text got
    # unreadable past a handful of accounts. The full, per-account
    # comparison table lives in the linked HTML summary report instead;
    # this message is just enough to triage from the inbox.

    ok_summaries = [s for s in summary_list if s["status"] == "OK"]
    failed_summaries = [s for s in summary_list if s["status"] != "OK"]

    def total(key):
        return sum(x[key] for x in ok_summaries)

    total_snapshots = total("total_snapshots")
    total_amis = total("total_amis")

    total_eligible_snapshots = total("eligible_snapshots")
    total_eligible_amis = total("eligible_amis")

    total_deleted = total("snapshots_deleted")
    total_delete_failed = total("snapshots_delete_failed")
    total_deregistered = total("amis_deregistered")
    total_deregister_failed = total("amis_deregister_failed")

    mode = (
        "DRY RUN"
        if DRY_RUN
        else "DELETE MODE"
    )

    lines = []

    lines.append("EBS Snapshot Cleanup Report")
    lines.append("================================")
    lines.append(f"RunId: {run_id}")
    lines.append(f"Mode: {mode}")
    lines.append(f"Region: ap-southeast-2")
    lines.append(f"Retention: {RETENTION_DAYS} days")
    lines.append(
        f"Accounts processed OK: {len(ok_summaries)} / "
        f"FAILED: {len(failed_summaries)}"
    )
    lines.append("")

    if failed_summaries:
        lines.append(
            f"*** {len(failed_summaries)} ACCOUNT(S) FAILED TO PROCESS "
            f"-- see summary report for details ***"
        )
        for item in failed_summaries:
            lines.append(f"  - {item['account_id']}: {item['error']}")
        lines.append("")

    lines.append(f"Total snapshots scanned: {total_snapshots}")
    lines.append(f"Total AMIs scanned: {total_amis}")

    if DRY_RUN:
        lines.append(
            f"If DRY_RUN were false, this run would DELETE: "
            f"{total_eligible_snapshots} snapshot(s) and "
            f"DEREGISTER: {total_eligible_amis} AMI(s)."
        )
    else:
        lines.append(
            f"Deleted: {total_deleted} snapshot(s) "
            f"({total_delete_failed} failed) / "
            f"Deregistered: {total_deregistered} AMI(s) "
            f"({total_deregister_failed} failed), "
            f"out of {total_eligible_snapshots} / {total_eligible_amis} eligible."
        )

    lines.append("")
    lines.append(
        f"Full per-account comparison table ({len(summary_list)} accounts):"
    )
    lines.append(f"  {summary_report_url}")
    lines.append("")
    lines.append(f"CSV - snapshots with an AMI ({reports['with_ami']['count']} rows):")
    lines.append(f"  {reports['with_ami']['url']}")
    lines.append(
        f"CSV - orphaned snapshots, no AMI ({reports['orphaned']['count']} rows):"
    )
    lines.append(f"  {reports['orphaned']['url']}")

    message = "\n".join(lines)

    sns.publish(
        TopicArn=SNS_TOPIC_ARN,
        Subject=(
            f"EBS Snapshot Report - {mode} - "
            f"{RETENTION_DAYS} Days - ap-southeast-2"
        ),
        Message=message
    )


# ============================================================
# LAMBDA HANDLER
# ============================================================

def lambda_handler(event, context):

    run_id = getattr(context, "aws_request_id", "local-test")

    logger.info(
        "Starting snapshot cleanup. run_id=%s DRY_RUN=%s "
        "RETENTION_DAYS=%s REGION=%s DEREGISTER_ASSOCIATED_AMIS=%s",
        run_id,
        DRY_RUN,
        RETENTION_DAYS,
        REGION,
        DEREGISTER_ASSOCIATED_AMIS,
    )

    if not SOURCE_ACCOUNTS:

        raise ValueError(
            "SOURCE_ACCOUNTS environment variable is empty"
        )

    all_rows = []
    summaries = []

    # --------------------------------------------------------
    # PROCESS ACCOUNTS (ap-southeast-2 only)
    # --------------------------------------------------------

    for account_id in SOURCE_ACCOUNTS:

        account_name = get_account_name(account_id)

        try:

            rows, summary = process_account_region(
                account_id,
                account_name,
                run_id,
            )

            all_rows.extend(rows)
            summaries.append(summary)

        except Exception as exc:

            logger.exception(
                "Failed processing account=%s region=%s",
                account_id,
                REGION
            )

            summaries.append(
                empty_summary(
                    account_id,
                    account_name,
                    REGION,
                    run_id,
                    status="ERROR",
                    error=str(exc),
                )
            )

    # --------------------------------------------------------
    # SPLIT ROWS: snapshots associated with an AMI vs orphaned
    # (a snapshot backs zero AMIs -> "AmiIds" is empty).
    #
    # This is a straight split of the same per-snapshot schema, not a
    # different report: a snapshot backed by one AMI still shows that one
    # AMI in its own "AmiIds" column, and an AMI backing four snapshots
    # shows up as the same AMI id in each of those four rows -- it never
    # gets its own column per snapshot.
    # --------------------------------------------------------

    rows_with_ami = [row for row in all_rows if row["AmiIds"]]
    rows_orphaned = [row for row in all_rows if not row["AmiIds"]]

    # --------------------------------------------------------
    # CREATE + UPLOAD BOTH CSVs
    # --------------------------------------------------------

    upload_timestamp = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")

    with_ami_key, with_ami_url = upload_report(
        create_csv(rows_with_ami), run_id, "with-ami", upload_timestamp
    )
    orphaned_key, orphaned_url = upload_report(
        create_csv(rows_orphaned), run_id, "orphaned", upload_timestamp
    )

    reports = {
        "with_ami": {
            "key": with_ami_key,
            "url": with_ami_url,
            "count": len(rows_with_ami),
        },
        "orphaned": {
            "key": orphaned_key,
            "url": orphaned_url,
            "count": len(rows_orphaned),
        },
    }

    # --------------------------------------------------------
    # BUILD + UPLOAD HTML SUMMARY (per-account comparison table)
    # --------------------------------------------------------

    mode_label = "DRY RUN" if DRY_RUN else "DELETE MODE"
    generated_at = datetime.now(timezone.utc).isoformat()

    summary_html = build_html_summary(
        summaries, reports, run_id, generated_at, mode_label
    )

    summary_key, summary_url = upload_html_summary(
        summary_html, run_id, upload_timestamp
    )

    # --------------------------------------------------------
    # SNS
    # --------------------------------------------------------

    send_sns(summaries, reports, summary_url, run_id)

    # --------------------------------------------------------
    # LAMBDA RESPONSE
    # --------------------------------------------------------

    accounts_failed = [s for s in summaries if s["status"] != "OK"]

    return {

        "statusCode": 200,
        "runId": run_id,
        "dryRun": DRY_RUN,
        "region": REGION,
        "retentionDays": RETENTION_DAYS,
        "reportBucket": REPORT_BUCKET,
        "rows": len(all_rows),
        "accountsProcessed": len(summaries),
        "accountsFailed": len(accounts_failed),
        "eligibleSnapshots": sum(
            s["eligible_snapshots"] for s in summaries if s["status"] == "OK"
        ),
        "eligibleAmis": sum(
            s["eligible_amis"] for s in summaries if s["status"] == "OK"
        ),
        "summaryReport": {
            "reportKey": summary_key,
            "downloadUrl": summary_url,
        },
        "reports": {
            "withAmi": {
                "reportKey": with_ami_key,
                "downloadUrl": with_ami_url,
                "rows": len(rows_with_ami),
            },
            "orphaned": {
                "reportKey": orphaned_key,
                "downloadUrl": orphaned_url,
                "rows": len(rows_orphaned),
            },
        },
    }
