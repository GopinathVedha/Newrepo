def create_csv(rows):

    buffer = io.StringIO()

    writer = csv.DictWriter(
        buffer,
        fieldnames=CSV_COLUMNS
    )

    writer.writeheader()

    for row in rows:

        writer.writerow(row)

    return buffer.getvalue()


# ============================================================
# S3
# ============================================================

def upload_report(csv_data, run_id):

    timestamp = datetime.now(
        timezone.utc
    ).strftime(
        "%Y%m%d-%H%M%S"
    )

    mode = (
        "dry-run"
        if DRY_RUN
        else "delete"
    )

    key = (
        f"{REPORT_PREFIX}"
        f"snapshot-report-"
        f"{RETENTION_DAYS}days-"
        f"{mode}-"
        f"{timestamp}-"
        f"{run_id}.csv"
    )

    s3.put_object(
        Bucket=REPORT_BUCKET,
        Key=key,
        Body=csv_data.encode("utf-8"),
        ContentType="text/csv",
        ServerSideEncryption="aws:kms",
        SSEKMSKeyId=KMS_KEY_ID
    )

    # NOTE (audit caveat, not fixed automatically): if this Lambda's own
    # execution role credentials are temporary (the normal case), a
    # presigned URL signed with them stops working once those credentials
    # expire -- which can happen well before PRESIGNED_URL_EXPIRY elapses.
    # Treat PRESIGNED_URL_EXPIRY as an upper bound, not a guarantee.
    presigned_url = (
        s3.generate_presigned_url(
            "get_object",
            Params={
                "Bucket": REPORT_BUCKET,
                "Key": key
            },
            ExpiresIn=PRESIGNED_URL_EXPIRY
        )
    )

    return key, presigned_url


# ============================================================
# SNS
# ============================================================

def send_sns(summary_list, url, run_id):

    ok_summaries = [s for s in summary_list if s["status"] == "OK"]
    failed_summaries = [s for s in summary_list if s["status"] != "OK"]

    def total(key):
        return sum(x[key] for x in ok_summaries)

    total_snapshots = total("total_snapshots")
    total_amis = total("total_amis")
    total_old = total("older_snapshots")
    total_gb = total("older_snapshot_gb")

    total_eligible_snapshots = total("eligible_snapshots")
    total_eligible_amis = total("eligible_amis")

    total_deleted = total("snapshots_deleted")
    total_delete_failed = total("snapshots_delete_failed")
    total_deregistered = total("amis_deregistered")
    total_deregister_failed = total("amis_deregister_failed")

    mode = (
        "DRY RUN"
        if DRY_RUN
        else "DELETE MODE"
    )

    lines = []

    lines.append("EBS Snapshot Cleanup Report")
    lines.append("================================")
    lines.append(f"RunId: {run_id}")
    lines.append(f"Mode: {mode}")
    lines.append(f"Region: ap-southeast-2")
    lines.append(f"Retention: {RETENTION_DAYS} days")
    lines.append(f"Accounts processed OK: {len(ok_summaries)}")
    lines.append(f"Accounts FAILED: {len(failed_summaries)}")
    lines.append("")

    if failed_summaries:
        lines.append("*** ACCOUNT PROCESSING FAILURES ***")
        lines.append("-----------------------------------")
        for item in failed_summaries:
            lines.append(
                f"Account {item['account_id']} ({item['region']}): "
                f"{item['error']}"
            )
        lines.append("")

    lines.append("Overall Summary")
    lines.append("---------------")
    lines.append(f"Total snapshots scanned: {total_snapshots}")
    lines.append(f"Total AMIs scanned: {total_amis}")
    lines.append(f"Older than {RETENTION_DAYS} days: {total_old}")
    lines.append(f"Older snapshot volume size: {total_gb:,} GiB")
    lines.append("")

    if DRY_RUN:
        lines.append(
            f"If DRY_RUN were false, this run would DELETE: "
            f"{total_eligible_snapshots} snapshot(s) and "
            f"DEREGISTER: {total_eligible_amis} AMI(s)."
        )
    else:
        lines.append(
            f"Eligible for deletion this run: "
            f"{total_eligible_snapshots} snapshot(s), "
            f"{total_eligible_amis} AMI(s)."
        )
        lines.append(f"Snapshots deleted: {total_deleted}")
        lines.append(f"Snapshot delete failures: {total_delete_failed}")
        lines.append(f"AMIs deregistered: {total_deregistered}")
        lines.append(f"AMI deregister failures: {total_deregister_failed}")

    lines.append("")
    lines.append("Account Summary")
    lines.append("---------------")

    for item in summary_list:

        lines.append(
            f"Account: {item['account_name']} ({item['account_id']}) "
            f"[{item['status']}]"
        )

        if item["status"] != "OK":
            lines.append(f"  Error: {item['error']}")
            lines.append("")
            continue

        lines.append(f"  Region: {item['region']}")
        lines.append(f"  Total snapshots: {item['total_snapshots']}")
        lines.append(f"  Total AMIs: {item['total_amis']}")
        lines.append(
            f"  Older than {RETENTION_DAYS} days: {item['older_snapshots']}"
        )
        lines.append(
            f"  Older snapshot size: {item['older_snapshot_gb']:,} GiB"
        )
        lines.append("  Excluded breakdown:")
        lines.append(
            f"    Not completed: {item['excluded_not_completed']}"
        )
        lines.append(
            f"    AMI pre/post patch: {item['excluded_ami_type']}"
        )
        lines.append(
            f"    AWS Backup protected: {item['excluded_backup_tag']}"
        )
        lines.append(
            f"    Within retention: {item['excluded_within_retention']}"
        )
        lines.append(
            f"    AMI has active dependent snapshot: "
            f"{item['excluded_ami_dependency']}"
        )
        lines.append(
            f"  Eligible (would delete/deregister): "
            f"{item['eligible_snapshots']} snapshot(s), "
            f"{item['eligible_amis']} AMI(s)"
        )
        lines.append(f"  Snapshots deleted: {item['snapshots_deleted']}")
        lines.append(
            f"  Snapshot delete failures: {item['snapshots_delete_failed']}"
        )
        lines.append(f"  AMIs deregistered: {item['amis_deregistered']}")
        lines.append(
            f"  AMI deregister failures: {item['amis_deregister_failed']}"
        )
        lines.append("")

    lines.append("CSV Download:")
    lines.append(url)

    message = "\n".join(lines)

    sns.publish(
        TopicArn=SNS_TOPIC_ARN,
        Subject=(
            f"EBS Snapshot Report - {mode} - "
            f"{RETENTION_DAYS} Days - ap-southeast-2"
        ),
        Message=message
    )


# ============================================================
# LAMBDA HANDLER
# ============================================================

def lambda_handler(event, context):

    run_id = getattr(context, "aws_request_id", "local-test")

    logger.info(
        "Starting snapshot cleanup. run_id=%s DRY_RUN=%s "
        "RETENTION_DAYS=%s REGION=%s DEREGISTER_ASSOCIATED_AMIS=%s",
        run_id,
        DRY_RUN,
        RETENTION_DAYS,
        REGION,
        DEREGISTER_ASSOCIATED_AMIS,
    )

    if not SOURCE_ACCOUNTS:

        raise ValueError(
            "SOURCE_ACCOUNTS environment variable is empty"
        )

    all_rows = []
    summaries = []

    # --------------------------------------------------------
    # PROCESS ACCOUNTS (ap-southeast-2 only)
    # --------------------------------------------------------

    for account_id in SOURCE_ACCOUNTS:

        account_name = get_account_name(account_id)

        try:

            rows, summary = process_account_region(
                account_id,
                account_name,
                run_id,
            )

            all_rows.extend(rows)
            summaries.append(summary)

        except Exception as exc:

            logger.exception(
                "Failed processing account=%s region=%s",
                account_id,
                REGION
            )

            summaries.append(
                empty_summary(
                    account_id,
                    account_name,
                    REGION,
                    run_id,
                    status="ERROR",
                    error=str(exc),
                )
            )

    # --------------------------------------------------------
    # CREATE CSV
    # --------------------------------------------------------

    csv_data = create_csv(all_rows)

    # --------------------------------------------------------
    # UPLOAD TO S3
    # --------------------------------------------------------

    report_key, download_url = upload_report(csv_data, run_id)

    # --------------------------------------------------------
    # SNS
    # --------------------------------------------------------

    send_sns(summaries, download_url, run_id)

    # --------------------------------------------------------
    # LAMBDA RESPONSE
    # --------------------------------------------------------

    accounts_failed = [s for s in summaries if s["status"] != "OK"]

    return {

        "statusCode": 200,
        "runId": run_id,
        "dryRun": DRY_RUN,
        "region": REGION,
        "retentionDays": RETENTION_DAYS,
        "reportBucket": REPORT_BUCKET,
        "reportKey": report_key,
        "rows": len(all_rows),
        "accountsProcessed": len(summaries),
        "accountsFailed": len(accounts_failed),
        "eligibleSnapshots": sum(
            s["eligible_snapshots"] for s in summaries if s["status"] == "OK"
        ),
        "eligibleAmis": sum(
            s["eligible_amis"] for s in summaries if s["status"] == "OK"
        ),
        "downloadUrl": download_url,
    }
