def create_csv(rows):

    buffer = io.StringIO()

    writer = csv.DictWriter(
        buffer,
        fieldnames=CSV_COLUMNS
    )

    writer.writeheader()

    for row in rows:

        writer.writerow(row)

    return buffer.getvalue()


# ============================================================
# HTML SUMMARY (per-account comparison table)
# ============================================================
#
# SNS email delivery is plain text only -- it cannot render an HTML
# table in the message body. So the account-by-account comparison lives
# here, as its own HTML file uploaded next to the CSVs, and the SNS
# email stays short and links to it instead of repeating a long
# text block per account.

ACCOUNT_TABLE_COLUMNS = [
    ("total_snapshots", "Total Snapshots"),
    ("with_ami_snapshots", "With AMI"),
    ("orphaned_snapshots", "Orphaned"),
    ("total_amis", "Total AMIs"),
    ("older_snapshots", f"Older Than {RETENTION_DAYS}d"),
    ("older_snapshot_gb", "Older GiB"),
    ("excluded_not_completed", "Excl: Not Completed"),
    ("excluded_ami_type", "Excl: AMI Pre/Post Patch"),
    ("excluded_backup_tag", "Excl: AWS Backup"),
    ("excluded_within_retention", "Excl: Within Retention"),
    ("excluded_ami_dependency", "Excl: AMI Dependency"),
    ("eligible_snapshots", "Eligible Snapshots"),
    ("eligible_amis", "Eligible AMIs"),
    ("snapshots_deleted", "Snapshots Deleted"),
    ("snapshots_delete_failed", "Delete Failed"),
    ("amis_deregistered", "AMIs Deregistered"),
    ("amis_deregister_failed", "Deregister Failed"),
]


def build_html_summary(summary_list, reports, run_id, generated_at, mode):

    ok_summaries = [s for s in summary_list if s["status"] == "OK"]
    failed_summaries = [s for s in summary_list if s["status"] != "OK"]

    def total(key):
        return sum(x[key] for x in ok_summaries)

    header_cells = "".join(
        f"<th>{html.escape(label)}</th>" for _, label in ACCOUNT_TABLE_COLUMNS
    )

    body_rows = []

    for item in summary_list:

        status_class = "status-ok" if item["status"] == "OK" else "status-error"
        status_label = html.escape(item["status"])

        account_cell = (
            f"<strong>{html.escape(str(item['account_name']))}</strong>"
            f"<br><span class='muted'>{html.escape(str(item['account_id']))}</span>"
        )

        if item["status"] != "OK":
            body_rows.append(
                f"<tr class='{status_class}'>"
                f"<td>{account_cell}</td>"
                f"<td>{status_label}</td>"
                f"<td colspan='{len(ACCOUNT_TABLE_COLUMNS)}'>"
                f"Error: {html.escape(str(item['error']))}</td>"
                f"</tr>"
            )
            continue

        data_cells = "".join(
            f"<td>{item[key]:,}</td>" for key, _ in ACCOUNT_TABLE_COLUMNS
        )

        body_rows.append(
            f"<tr class='{status_class}'>"
            f"<td>{account_cell}</td>"
            f"<td>{status_label}</td>"
            f"{data_cells}"
            f"</tr>"
        )

    if DRY_RUN:
        headline = (
            f"If DRY_RUN were false, this run would DELETE "
            f"<strong>{total('eligible_snapshots'):,}</strong> snapshot(s) and "
            f"DEREGISTER <strong>{total('eligible_amis'):,}</strong> AMI(s)."
        )
    else:
        headline = (
            f"Deleted <strong>{total('snapshots_deleted'):,}</strong> snapshot(s) "
            f"({total('snapshots_delete_failed'):,} failed) and deregistered "
            f"<strong>{total('amis_deregistered'):,}</strong> AMI(s) "
            f"({total('amis_deregister_failed'):,} failed), out of "
            f"{total('eligible_snapshots'):,} / {total('eligible_amis'):,} eligible."
        )

    failed_banner = ""
    if failed_summaries:
        failed_rows = "".join(
            f"<li><strong>{html.escape(str(s['account_id']))}</strong>: "
            f"{html.escape(str(s['error']))}</li>"
            for s in failed_summaries
        )
        failed_banner = (
            f"<div class='banner banner-error'>"
            f"<strong>{len(failed_summaries)} account(s) failed to process:</strong>"
            f"<ul>{failed_rows}</ul></div>"
        )

    return f"""<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>EBS Snapshot Cleanup Report</title>
<style>
  body {{ font-family: -apple-system, Segoe UI, Arial, sans-serif; margin: 24px; color: #1a1a1a; background: #fafafa; }}
  h1 {{ font-size: 20px; margin-bottom: 4px; }}
  .meta {{ color: #555; font-size: 13px; margin-bottom: 16px; }}
  .meta span {{ margin-right: 16px; }}
  .banner {{ padding: 12px 16px; border-radius: 6px; margin-bottom: 16px; font-size: 14px; }}
  .banner-error {{ background: #fdecea; border: 1px solid #f5b5ac; color: #7a1f13; }}
  .banner-info {{ background: #eaf2fd; border: 1px solid #b6d4fb; color: #0b3d78; font-size: 15px; }}
  .downloads {{ margin: 16px 0; font-size: 14px; }}
  .downloads a {{ display: inline-block; margin-right: 20px; }}
  .table-wrap {{ overflow-x: auto; border: 1px solid #ddd; border-radius: 6px; }}
  table {{ border-collapse: collapse; width: 100%; font-size: 13px; white-space: nowrap; }}
  th, td {{ padding: 6px 10px; border-bottom: 1px solid #eee; text-align: right; }}
