import boto3
import json
import logging
import uuid
from datetime import datetime, timedelta
from zoneinfo import ZoneInfo
from botocore.exceptions import ClientError

# ============================================================
# LAMBDA 1 of 2 — "Action" function (MULTI-ACCOUNT / CENTRAL HUB)
#
# Runs in a central account and manages EC2 start/stop across a fleet of
# accounts (including itself) by assuming a cross-account IAM role in each
# spoke account. The account list (with friendly names + role ARNs) is
# read from SSM. All accounts are assumed to share the same region and
# timezone (ap-southeast-2 / Australia-Sydney) per your setup.
#
# Sends an IMMEDIATE SNS report after start/stop actions, then schedules
# Lambda 2 to run the delayed health check + instance-type restore,
# passing only the accounts/instances actually touched this cycle.
# ============================================================

logger = logging.getLogger()
logger.setLevel(logging.INFO)

# All accounts share this region
region = 'ap-southeast-2'

# SNS Topics (all live in the central account)
sns_topic_start_arn = 'arn:aws:sns:ap-southeast-2:050557606111:Autoscheduler_start'
sns_topic_stop_arn = 'arn:aws:sns:ap-southeast-2:050557606111:Autoscheduler_stop'
sns_topic_capacity_arn = 'arn:aws:sns:ap-southeast-2:050557606111:Autoscheduler_capacity_fallback'

# ARN of Lambda 2 ("status/health-check" function), also in the central account
STATUS_LAMBDA_ARN = 'arn:aws:lambda:ap-southeast-2:050557606111:function:ec2_autoscheduler_status'

# IAM role that EventBridge Scheduler assumes to invoke Lambda 2
SCHEDULER_EXECUTION_ROLE_ARN = 'arn:aws:iam::050557606111:role/EC2Autoscheduler-SchedulerInvokeRole'

# How long to wait before checking instance health / sending final report
STATUS_CHECK_DELAY_SECONDS = 180

# SSM parameters (both live in the CENTRAL account)
HOLIDAY_PARAM_NAME = '/autoscheduler/Holidays'
# JSON array of accounts, e.g.:
# [
#   {"account_id": "111111111111", "name": "SPT", "role_arn": null},
#   {"account_id": "222222222222", "name": "DEV", "role_arn": "arn:aws:iam::222222222222:role/EC2AutoschedulerCrossAccountRole"}
# ]
# "role_arn": null means this IS the central account — use local credentials, don't assume a role.
ACCOUNTS_PARAM_NAME = '/autoscheduler/Accounts'

# Tags (unchanged from the single-account version)
ORIGINAL_TYPE_TAG = 'equip:infra:original-instance-type'
EXCEPTION_TAG = 'equip:infra:autoscheduler:exception'
WEEKLY_SCHEDULE_TAG = 'equip:infratest:weeklyschedule'

SIZE_ORDER = [
    'nano', 'micro', 'small', 'medium', 'large',
    'xlarge', '2xlarge', '4xlarge', '8xlarge', '9xlarge',
    '12xlarge', '16xlarge', '18xlarge', '24xlarge', '32xlarge', '48xlarge'
]
WEEKDAY_ABBR = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']

# Central-account-only clients (SNS/SSM/Scheduler/STS always live here,
# regardless of which spoke account an instance belongs to)
sts_client = boto3.client('sts', region_name=region)
sns_client = boto3.client('sns', region_name=region)
ssm_client = boto3.client('ssm', region_name=region)
scheduler_client = boto3.client('scheduler', region_name=region)

# ---------- Global tracking (reset each invocation) ----------
instance_names = {}            # instance_id -> Name tag
instance_account = {}          # instance_id -> {"account_id":.., "name":.., "role_arn":..}
autostart_instance_ids = []    # global, across all accounts (for the immediate report)
autostop_instance_ids = []
db_instances = []
app_instances = []
downgrade_events = []          # (instance_id, name, account_name, original_type, downgraded_type)
start_failures = []            # (instance_id, name, account_name, reason)
skipped_for_holiday = []       # (instance_id, name, account_name)
malformed_schedule_tags = []   # (instance_id, name, account_name, error)
account_assume_failures = []   # (account_id, account_name, error)


# ---------- Helpers ----------

def get_instance_name(instance):
    if instance.tags:
        for tag in instance.tags:
            if tag['Key'] == 'Name':
                return tag['Value']
    return 'Unnamed'


def get_instance_role(instance):
    if instance.tags:
        for tag in instance.tags:
            if tag['Key'] == 'equip:infra:role':
                return tag['Value'].lower()
    return 'unknown'


def get_tag_value(instance, key):
    if instance.tags:
        for tag in instance.tags:
            if tag['Key'] == key:
                return tag['Value']
    return None


def is_weekend(local_dt):
    return local_dt.weekday() >= 5


def get_public_holidays():
    try:
        response = ssm_client.get_parameter(Name=HOLIDAY_PARAM_NAME)
        dates = {d.strip() for d in response['Parameter']['Value'].split(',') if d.strip()}
        logger.info(f"Loaded {len(dates)} holiday date(s) from SSM parameter {HOLIDAY_PARAM_NAME}")
        return dates
    except ClientError as e:
        logger.warning(f"Could not read holiday list from SSM ({HOLIDAY_PARAM_NAME}): {e}. "
                        f"Proceeding as if no holidays are configured for today.")
        return set()


def get_accounts_config():
    """Loads the account fleet from SSM. Fails LOUD (returns empty list +
    caller alerts) rather than silently guessing a scope, since getting
    this wrong means either skipping accounts or acting on the wrong ones."""
    try:
        response = ssm_client.get_parameter(Name=ACCOUNTS_PARAM_NAME)
        accounts = json.loads(response['Parameter']['Value'])
        logger.info(f"Loaded {len(accounts)} account(s) from SSM parameter {ACCOUNTS_PARAM_NAME}")
        return accounts
    except (ClientError, json.JSONDecodeError, TypeError) as e:
        logger.error(f"Could not read/parse account list from SSM ({ACCOUNTS_PARAM_NAME}): {e}")
        return []


def get_account_session(role_arn):
    """None => central account's own credentials (no assume-role needed)."""
    if not role_arn:
        return boto3.Session()
    creds = sts_client.assume_role(
        RoleArn=role_arn,
        RoleSessionName='ec2-autoscheduler-action'
    )['Credentials']
    return boto3.Session(
        aws_access_key_id=creds['AccessKeyId'],
        aws_secret_access_key=creds['SecretAccessKey'],
        aws_session_token=creds['SessionToken'],
    )


def get_exception_type(instance):
    value = get_tag_value(instance, EXCEPTION_TAG)
    return value.strip().lower() if value else None


def resolve_daily_schedule(instance, today_abbr, plain_autostart, plain_autostop,
                            instance_id, instance_name, account_name):
    raw = get_tag_value(instance, WEEKLY_SCHEDULE_TAG)
    if not raw:
        return plain_autostart, plain_autostop
    try:
        schedule = json.loads(raw)
        schedule = {k.strip()[:3].capitalize(): v for k, v in schedule.items()}
    except (json.JSONDecodeError, AttributeError, TypeError) as e:
        logger.error(f"Malformed {WEEKLY_SCHEDULE_TAG} tag on {instance_id} ({instance_name}, "
                      f"{account_name}): {e}. Skipping start/stop for this instance today.")
        malformed_schedule_tags.append((instance_id, instance_name, account_name, str(e)))
        return '', ''
    day_entry = schedule.get(today_abbr)
    if not day_entry:
        return '', ''
    return day_entry.get('start', ''), day_entry.get('stop', '')


def send_sns_notification(message, topic_arn, subject='EC2 Scheduler Notification'):
    try:
        response = sns_client.publish(TopicArn=topic_arn, Message=message, Subject=subject)
        logger.info(f"SNS notification sent to {topic_arn} (MessageId: {response.get('MessageId')})")
    except Exception as e:
        logger.error(f"Failed to send SNS notification to {topic_arn}: {e}")


def get_action_status_table(instance_ids, action_type):
    lines = ["Account ID     | Account Name | Server Name     | Action",
             "-------------- | ------------ | --------------- | -------"]
    for iid in instance_ids:
        acct = instance_account.get(iid, {})
        lines.append(f"{acct.get('account_id', '?'):<14} | {acct.get('name', '?'):<12} | "
                      f"{instance_names.get(iid, 'Unnamed'):<15} | {action_type}")
    return "\n".join(lines)


def get_event_table(events, columns):
    header = " | ".join(columns)
    sep = " | ".join(["-" * len(c) for c in columns])
    lines = [header, sep]
    for row in events:
        lines.append(" | ".join(str(x) for x in row))
    return "\n".join(lines)


def get_downgrade_candidates(instance_type):
    try:
        family, size = instance_type.split('.', 1)
    except ValueError:
        return []
    if size not in SIZE_ORDER:
        return []
    idx = SIZE_ORDER.index(size)
    if idx == 0:
        return []
    return [f"{family}.{s}" for s in reversed(SIZE_ORDER[:idx])]


def is_capacity_error(client_error):
    code = client_error.response.get('Error', {}).get('Code', '')
    return code in ('InsufficientInstanceCapacity', 'InsufficientHostCapacity', 'InsufficientCapacityOnHost')


def is_invalid_type_error(client_error):
    error = client_error.response.get('Error', {})
    return error.get('Code', '') == 'InvalidParameterValue' and 'do not exist' in error.get('Message', '').lower()


def start_instance_with_capacity_fallback(ec2_resource, ec2_client, instance_id, account_name):
    instance = ec2_resource.Instance(instance_id)
    name = instance_names.get(instance_id, get_instance_name(instance))

    original_type = get_tag_value(instance, ORIGINAL_TYPE_TAG)
    if not original_type:
        original_type = instance.instance_type

    attempt_types = [original_type] + get_downgrade_candidates(original_type)

    for attempt_type in attempt_types:
        try:
            if attempt_type != instance.instance_type:
                ec2_client.modify_instance_attribute(InstanceId=instance_id, InstanceType={'Value': attempt_type})
            ec2_client.start_instances(InstanceIds=[instance_id])
            logger.info(f"Started instance {instance_id} ({name}, {account_name}) as {attempt_type}")

            if attempt_type != original_type:
                ec2_client.create_tags(Resources=[instance_id],
                                        Tags=[{'Key': ORIGINAL_TYPE_TAG, 'Value': original_type}])
                downgrade_events.append((instance_id, name, account_name, original_type, attempt_type))
            return True

        except ClientError as e:
            if is_invalid_type_error(e):
                logger.info(f"{attempt_type} does not exist for this family ({instance_id}/{name}/"
                            f"{account_name}) — skipping to next smaller size")
                continue
            if is_capacity_error(e):
                logger.warning(f"Capacity issue starting {instance_id} ({name}, {account_name}) as "
                                f"{attempt_type}, trying next smaller type")
                continue
            logger.error(f"Error starting instance {instance_id} ({name}, {account_name}): {e}")
            start_failures.append((instance_id, name, account_name, str(e)))
            return False

    start_failures.append((instance_id, name, account_name,
                            "No capacity available for original type or any smaller type in the family"))
    logger.error(f"Instance {instance_id} ({name}, {account_name}) could not be started at any size")
    return False


def schedule_status_check(payload, delay_seconds=STATUS_CHECK_DELAY_SECONDS):
    run_at = (datetime.utcnow() + timedelta(seconds=delay_seconds)).strftime('%Y-%m-%dT%H:%M:%S')
    schedule_name = f"ec2-autoscheduler-status-{uuid.uuid4().hex[:10]}"
    scheduler_client.create_schedule(
        Name=schedule_name,
        ScheduleExpression=f"at({run_at})",
        FlexibleTimeWindow={'Mode': 'OFF'},
        Target={'Arn': STATUS_LAMBDA_ARN, 'RoleArn': SCHEDULER_EXECUTION_ROLE_ARN, 'Input': json.dumps(payload)},
        ActionAfterCompletion='DELETE'
    )
    logger.info(f"Scheduled status-check Lambda as '{schedule_name}' for {run_at} UTC")


# ---------- Per-account processing ----------

def process_account(acct, trigger_type, ct_sec, today_abbr, is_skip_day, holiday_today,
                     message_lines, accounts_involved):
    account_id = acct['account_id']
    account_name = acct.get('name', account_id)
    role_arn = acct.get('role_arn')

    try:
        session = get_account_session(role_arn)
        ec2_resource = session.resource('ec2', region_name=region)
        ec2_client = session.client('ec2', region_name=region)
    except ClientError as e:
        logger.error(f"Could not assume role for account {account_id} ({account_name}): {e}")
        account_assume_failures.append((account_id, account_name, str(e)))
        return False, False

    acct_autostart_ids, acct_autostop_ids = [], []
    acct_db_instances, acct_app_instances = [], []

    try:
        for instance in ec2_resource.instances.all():
            instance_id = instance.id
            name = get_instance_name(instance)
            instance_names[instance_id] = name
            instance_account[instance_id] = {'account_id': account_id, 'name': account_name, 'role_arn': role_arn}

            scheduler_flag = autostart_flag = autostop_flag = ''
            if instance.tags:
                for tag in instance.tags:
                    key, value = tag['Key'], tag['Value']
                    if key == 'equip:infra:autoscheduler':
                        scheduler_flag = value.lower()
                    elif key == 'equip:infratest:autostarttime':
                        autostart_flag = value
                    elif key == 'equip:infratest:autostoptime':
                        autostop_flag = value

            if scheduler_flag != 'enabled':
                continue

            exception_type = get_exception_type(instance)
            autostart_flag, autostop_flag = resolve_daily_schedule(
                instance, today_abbr, autostart_flag, autostop_flag, instance_id, name, account_name
            )

            try:
                if autostart_flag and ':' in autostart_flag:
                    hh, mm = map(int, autostart_flag.split(':'))
                    sta_sec = hh * 3600 + mm * 60
                    if 0 <= (ct_sec - sta_sec) < 300 and instance.state['Name'] == 'stopped':
                        if is_skip_day and exception_type != 'true':
                            skipped_for_holiday.append((instance_id, name, account_name))
                        else:
                            role = get_instance_role(instance)
                            if trigger_type == 'db' and role == 'db':
                                acct_db_instances.append(instance_id)
                            elif trigger_type == 'app' and role == 'app':
                                acct_app_instances.append(instance_id)
                            elif trigger_type == 'all':
                                if role == 'db':
                                    acct_db_instances.append(instance_id)
                                elif role == 'app':
                                    acct_app_instances.append(instance_id)
                            acct_autostart_ids.append(instance_id)

                if autostop_flag and ':' in autostop_flag:
                    hh, mm = map(int, autostop_flag.split(':'))
                    sto_sec = hh * 3600 + mm * 60
                    if 0 <= (ct_sec - sto_sec) < 300 and instance.state['Name'] == 'running':
                        if exception_type == 'nonstop':
                            logger.info(f"Skipping stop for {instance_id} ({name}, {account_name}) — nonstop")
                        else:
                            acct_autostop_ids.append(instance_id)
            except Exception as e:
                logger.error(f"Error parsing time for {instance_id} ({account_name}): {e}")
    except Exception as e:
        logger.error(f"Error evaluating instances in account {account_id} ({account_name}): {e}")
        return False, False

    had_start, had_stop = False, False

    if acct_autostart_ids:
        had_start = True
        db_instances.extend(acct_db_instances)
        app_instances.extend(acct_app_instances)
        autostart_instance_ids.extend(acct_autostart_ids)
        started_ids = []
        for iid in acct_autostart_ids:
            if start_instance_with_capacity_fallback(ec2_resource, ec2_client, iid, account_name):
                started_ids.append(iid)

        message_lines.append(f"\n==============================\n🔄 [{account_name}] Instance Start Actions"
                              f"\n==============================")
        started_db = [i for i in acct_db_instances if i in started_ids]
        started_app = [i for i in acct_app_instances if i in started_ids]
        if started_db:
            message_lines.append("\nStarted Database Servers:\n" + get_action_status_table(started_db, "Started"))
        if started_app:
            message_lines.append("\nStarted Application Servers:\n" + get_action_status_table(started_app, "Started"))

    if acct_autostop_ids:
        had_stop = True
        autostop_instance_ids.extend(acct_autostop_ids)
        try:
            ec2_client.stop_instances(InstanceIds=acct_autostop_ids)
            logger.info(f"Stop requested for {account_name}: {acct_autostop_ids}")
            message_lines.append(f"\n==============================\n🔻 [{account_name}] Instance Stop Actions"
                                  f"\n==============================")
            message_lines.append("\nStopped Instances:\n" + get_action_status_table(acct_autostop_ids, "Stopped"))
        except Exception as e:
            logger.error(f"Error stopping instances in {account_name}: {e}")

    if had_start or had_stop:
        accounts_involved[account_id] = {
            "name": account_name,
            "role_arn": role_arn,
            "autostart_instance_ids": acct_autostart_ids if had_start else [],
            "autostop_instance_ids": acct_autostop_ids if had_stop else [],
            "instance_names": {iid: instance_names[iid] for iid in (acct_autostart_ids + acct_autostop_ids)},
        }

    return had_start, had_stop


# ---------- Main handler ----------

def lambda_handler(event, context):
    logger.info(f"Lambda 1 (action) invoked. Event: {json.dumps(event)}")

    trigger_type = event.get("trigger", "all")

    for lst in (downgrade_events, start_failures, skipped_for_holiday,
                malformed_schedule_tags, account_assume_failures,
                autostart_instance_ids, autostop_instance_ids, db_instances, app_instances):
        lst.clear()

    sydney_now = datetime.now(ZoneInfo("Australia/Sydney"))
    ct_sec = sydney_now.hour * 3600 + sydney_now.minute * 60
    timestamp = sydney_now.strftime("%Y-%m-%d %H:%M %Z")
    today_str = sydney_now.strftime("%Y-%m-%d")
    today_abbr = WEEKDAY_ABBR[sydney_now.weekday()]

    public_holidays = get_public_holidays()
    weekend_today = is_weekend(sydney_now)
    holiday_today = today_str in public_holidays
    is_skip_day = weekend_today or holiday_today

    message_lines = [f"🚀 EC2 Autoscheduler Report (All Accounts)\n\n📅 Timestamp: {timestamp}\n"]
    if is_skip_day:
        reason = "Public Holiday" if holiday_today else "Weekend"
        message_lines.append(
            f"📌 Today is a {reason} — normal auto-start is skipped fleet-wide except for "
            f"instances tagged '{EXCEPTION_TAG} = true'.\n"
        )

    accounts = get_accounts_config()
    if not accounts:
        send_sns_notification(
            f"❌ EC2 Autoscheduler could not load the account list from SSM parameter "
            f"{ACCOUNTS_PARAM_NAME}. No accounts were processed this cycle — nothing started "
            f"or stopped anywhere.",
            sns_topic_capacity_arn, subject='EC2 Scheduler - Account Config Load FAILED'
        )
        return

    accounts_involved = {}
    any_start, any_stop = False, False

    for acct in accounts:
        had_start, had_stop = process_account(
            acct, trigger_type, ct_sec, today_abbr, is_skip_day, holiday_today,
            message_lines, accounts_involved
        )
        any_start = any_start or had_start
        any_stop = any_stop or had_stop

    if account_assume_failures:
        message_lines.append(
            "\n❌ Could Not Access These Accounts (role assumption failed):\n"
            + get_event_table(account_assume_failures, ["Account ID", "Account Name", "Error"])
        )

    if skipped_for_holiday:
        reason = "Public Holiday" if holiday_today else "Weekend"
        message_lines.append(
            f"\n⏭️ Skipped Auto-Start ({reason}, no '{EXCEPTION_TAG} = true' tag):\n"
            + get_event_table(skipped_for_holiday, ["Instance ID", "Name", "Account"])
        )

    if malformed_schedule_tags:
        message_lines.append(
            f"\n⚠️ Malformed '{WEEKLY_SCHEDULE_TAG}' Tag (no action taken today):\n"
            + get_event_table(malformed_schedule_tags, ["Instance ID", "Name", "Account", "Error"])
        )

    if downgrade_events:
        message_lines.append(
            "\n⚠️ Capacity Downgrades (will auto-restore to original type on next stop):\n"
            + get_event_table(downgrade_events, ["Instance ID", "Name", "Account", "Original Type", "Started As"])
        )
    if start_failures:
        message_lines.append(
            "\n❌ Failed to Start (no capacity at any size in family):\n"
            + get_event_table(start_failures, ["Instance ID", "Name", "Account", "Reason"])
        )
    if downgrade_events or start_failures:
        capacity_lines = [f"⚠️ EC2 Capacity Fallback Report\n\n📅 Timestamp: {timestamp}\n"]
        if downgrade_events:
            capacity_lines.append("Instances downgraded due to capacity shortage:\n"
                + get_event_table(downgrade_events, ["Instance ID", "Name", "Account", "Original Type", "Started As"]))
        if start_failures:
            capacity_lines.append("\nInstances that FAILED to start:\n"
                + get_event_table(start_failures, ["Instance ID", "Name", "Account", "Reason"]))
        send_sns_notification("\n".join(capacity_lines), sns_topic_capacity_arn,
                               subject='EC2 Scheduler - Capacity Fallback Alert')

    full_action_report = "\n".join(message_lines)
    logger.info(full_action_report)

    notify_start = any_start or bool(skipped_for_holiday)
    if notify_start:
        send_sns_notification(full_action_report, sns_topic_start_arn, subject='EC2 Scheduler - Start Action Report')
    if any_stop:
        send_sns_notification(full_action_report, sns_topic_stop_arn, subject='EC2 Scheduler - Stop Action Report')

    if not accounts_involved:
        logger.info("No start/stop actions this cycle across any account; skipping status-check scheduling.")
        return

    payload = {
        "timestamp": timestamp,
        "had_starts": any_start,
        "accounts_involved": accounts_involved,  # only accounts actually touched this cycle
    }
    try:
        schedule_status_check(payload)
    except Exception as e:
        logger.error(f"Failed to schedule the Lambda 2 status-check: {e}")
        send_sns_notification(
            f"⚠️ EC2 Autoscheduler: actions completed and the report above was sent, but the "
            f"follow-up health-check / instance-type-restore step (Lambda 2) could NOT be "
            f"scheduled.\n\nError: {e}\n\nCapacity-downgraded instances will NOT be restored "
            f"until this is fixed.",
            sns_topic_capacity_arn, subject='EC2 Scheduler - Status Check Scheduling FAILED'
        )
