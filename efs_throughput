#!/usr/bin/env python3
"""
EFS throughput sizing report (times shown in Sydney local time, AEST/AEDT).

For each EFS file system it prints:
  - throughput / performance mode and current provisioned value
  - storage size (total, Standard, IA, Archive) and the free baseline from Standard storage
  - MeteredIOBytes as MiB/s: window average, p50 / p95 / p99, max,
    and the highest 15-minute sustained average (with when it happened)
  - raw read / write throughput split (DataReadIOBytes / DataWriteIOBytes)
  - PercentIOLimit (General Purpose mode only)
  - the 5 busiest periods
  - an hour-of-day profile (average and max per Sydney hour) to show peak hours
  - a suggested starting value for Provisioned throughput

Usage:
  python3 efs_throughput_report.py                         # all file systems, last 14 days
  python3 efs_throughput_report.py --fs-id fs-0123abcd     # one file system
  python3 efs_throughput_report.py --days 30               # longer window (uses 5-min data)
  python3 efs_throughput_report.py --tz Asia/Kolkata       # show times in another zone
  python3 efs_throughput_report.py --csv-prefix sydney_efs # CSV file name prefix

CSV output (written to the current folder every run, in addition to the screen report):
  <prefix>_summary.csv     one row per file system with all the key figures
  <prefix>_hourly.csv      hour-of-day profile per file system (local time)
  <prefix>_timeseries.csv  every data point: local + UTC time, metered/read/write MiB/s,
                           PercentIOLimit — open in Excel to chart or pivot

Required IAM permissions:
  elasticfilesystem:DescribeFileSystems
  cloudwatch:GetMetricData
"""

import argparse
import csv
import math
import os
from collections import defaultdict
from datetime import datetime, timedelta, timezone
from zoneinfo import ZoneInfo

import boto3

MIB = 1024 ** 2
GIB = 1024 ** 3
TIB = 1024 ** 4
BASELINE_MIBPS_PER_TIB = 50   # baseline throughput from Standard storage
HEADROOM = 1.25               # 25% headroom on top of sustained peak
SUSTAINED_WINDOW_MIN = 15     # minutes used for the "sustained peak" figure


def fetch_metric(cw, fs_id, metric, stat, period, start, end):
    """Return {timestamp: value} for one EFS metric, following pagination."""
    query = [{
        "Id": "m",
        "MetricStat": {
            "Metric": {
                "Namespace": "AWS/EFS",
                "MetricName": metric,
                "Dimensions": [{"Name": "FileSystemId", "Value": fs_id}],
            },
            "Period": period,
            "Stat": stat,
        },
        "ReturnData": True,
    }]
    points, token = {}, None
    while True:
        kwargs = dict(MetricDataQueries=query, StartTime=start, EndTime=end,
                      ScanBy="TimestampAscending")
        if token:
            kwargs["NextToken"] = token
        resp = cw.get_metric_data(**kwargs)
        for result in resp["MetricDataResults"]:
            points.update(zip(result["Timestamps"], result["Values"]))
        token = resp.get("NextToken")
        if not token:
            return points


def percentile(sorted_vals, p):
    if not sorted_vals:
        return 0.0
    k = (len(sorted_vals) - 1) * p / 100
    lo, hi = math.floor(k), math.ceil(k)
    return sorted_vals[lo] + (sorted_vals[hi] - sorted_vals[lo]) * (k - lo)


def to_mibps(points, period):
    """Convert per-period byte sums into an ordered list of (timestamp, MiB/s)."""
    return [(ts, v / period / MIB) for ts, v in sorted(points.items())]


def sustained_peak(series, period):
    """Highest rolling average over SUSTAINED_WINDOW_MIN minutes, and when it started."""
    n = max(1, (SUSTAINED_WINDOW_MIN * 60) // period)
    if not series:
        return 0.0, None
    if len(series) < n:
        ts, v = max(series, key=lambda x: x[1])
        return v, ts
    vals = [v for _, v in series]
    window = sum(vals[:n])
    best, best_i = window, 0
    for i in range(n, len(vals)):
        window += vals[i] - vals[i - n]
        if window > best:
            best, best_i = window, i - n + 1
    return best / n, series[best_i][0]


def fmt_gib(b):
    return f"{b / GIB:,.1f} GiB"


def fmt_ts(ts, tz):
    # %Z prints AEST or AEDT automatically depending on daylight saving
    return ts.astimezone(tz).strftime("%Y-%m-%d %a %H:%M %Z")


def report(efs_fs, cw, days, period, tz):
    fs_id = efs_fs["FileSystemId"]
    name = efs_fs.get("Name", "-")
    size = efs_fs["SizeInBytes"]
    standard = size.get("ValueInStandard", size["Value"])
    baseline = standard / TIB * BASELINE_MIBPS_PER_TIB

    end = datetime.now(timezone.utc)
    start = end - timedelta(days=days)
    window_seconds = (end - start).total_seconds()

    metered = fetch_metric(cw, fs_id, "MeteredIOBytes", "Sum", period, start, end)
    reads = fetch_metric(cw, fs_id, "DataReadIOBytes", "Sum", period, start, end)
    writes = fetch_metric(cw, fs_id, "DataWriteIOBytes", "Sum", period, start, end)
    io_limit = {}
    if efs_fs.get("PerformanceMode") == "generalPurpose":
        io_limit = fetch_metric(cw, fs_id, "PercentIOLimit", "Maximum", period, start, end)

    series = to_mibps(metered, period)
    vals = sorted(v for _, v in series)
    # Average over the whole window (periods with no I/O count as zero)
    avg = sum(metered.values()) / window_seconds / MIB
    p50, p95, p99 = (percentile(vals, p) for p in (50, 95, 99))
    peak = vals[-1] if vals else 0.0
    sustained, sustained_at = sustained_peak(series, period)

    read_vals = sorted(v for _, v in to_mibps(reads, period))
    write_vals = sorted(v for _, v in to_mibps(writes, period))

    # Hour-of-day profile in the chosen time zone
    by_hour = defaultdict(list)
    for ts, v in series:
        by_hour[ts.astimezone(tz).hour].append(v)

    # Suggested provisioned value: the larger of sustained peak and p99, plus headroom
    target = max(sustained, p99) * HEADROOM
    suggested = max(1, math.ceil(target / 10) * 10)

    line = "=" * 72
    print(line)
    print(f"File system     : {fs_id}  ({name})")
    print(f"Throughput mode : {efs_fs['ThroughputMode']}"
          + (f"  (provisioned {efs_fs['ProvisionedThroughputInMibps']:.0f} MiB/s)"
             if efs_fs.get("ProvisionedThroughputInMibps") else ""))
    print(f"Performance mode: {efs_fs.get('PerformanceMode')}")
    print(f"Window          : {fmt_ts(start, tz)}  ->  {fmt_ts(end, tz)}")
    print(f"                  {days} days, {period}s data points ({len(series)} points)")
    print()
    print("Storage")
    print(f"  Total         : {fmt_gib(size['Value'])}")
    print(f"  Standard      : {fmt_gib(standard)}")
    print(f"  IA            : {fmt_gib(size.get('ValueInIA', 0))}")
    print(f"  Archive       : {fmt_gib(size.get('ValueInArchive', 0))}")
    print(f"  Free baseline : {baseline:,.1f} MiB/s  (50 MiB/s per TiB of Standard)")
    print()
    print("Metered throughput (MiB/s)  — this is what counts against your limit")
    print(f"  Average       : {avg:,.1f}")
    print(f"  p50 / p95 / p99: {p50:,.1f} / {p95:,.1f} / {p99:,.1f}")
    print(f"  Max (1 period): {peak:,.1f}")
    print(f"  Sustained peak: {sustained:,.1f}  (best {SUSTAINED_WINDOW_MIN}-min average"
          + (f", starting {fmt_ts(sustained_at, tz)})" if sustained_at else ")"))
    print()
    print("Raw data throughput (MiB/s)  — p99 / max")
    print(f"  Read          : {percentile(read_vals, 99):,.1f} / {max(read_vals, default=0):,.1f}")
    print(f"  Write         : {percentile(write_vals, 99):,.1f} / {max(write_vals, default=0):,.1f}")
    if io_limit:
        print(f"  PercentIOLimit max: {max(io_limit.values()):.1f}%  "
              "(near 100% = IOPS bottleneck, more throughput won't help)")
    print()
    print(f"Top 5 busiest periods ({tz.key})")
    for ts, v in sorted(series, key=lambda x: x[1], reverse=True)[:5]:
        print(f"  {fmt_ts(ts, tz)}  {v:,.1f} MiB/s")
    print()
    print(f"Hour-of-day profile ({tz.key}), metered MiB/s")
    print("  Hour     Avg      p95      Max   ")
    top_hour_avg = max((sum(v) / len(v) for v in by_hour.values()), default=0) or 1
    for h in range(24):
        hv = by_hour.get(h, [])
        if not hv:
            print(f"  {h:02d}:00   -")
            continue
        h_avg = sum(hv) / len(hv)
        bar = "#" * round(20 * h_avg / top_hour_avg)
        print(f"  {h:02d}:00 {h_avg:8,.1f} {percentile(sorted(hv), 95):8,.1f} "
              f"{max(hv):8,.1f}  {bar}")
    print()
    print(f"Suggested starting Provisioned throughput: {suggested} MiB/s")
    print(f"  (max of sustained peak and p99, +{int((HEADROOM - 1) * 100)}% headroom)")
    if baseline >= suggested:
        print("  Note: your free baseline already covers this, so Provisioned adds no "
              "throughput cost and Bursting may be enough.")
    else:
        print(f"  Billed portion ≈ {suggested - baseline:,.1f} MiB/s above the free baseline.")
    if p99 > 0 and peak / max(p99, 0.001) > 5:
        print("  Note: max is far above p99 — the workload is spiky. Elastic may be "
              "cheaper than provisioning for these peaks.")
    print()

    # ---- rows for the CSV files ----
    r2 = lambda x: round(x, 2)
    summary_row = {
        "file_system_id": fs_id,
        "name": name,
        "throughput_mode": efs_fs["ThroughputMode"],
        "current_provisioned_mibps": efs_fs.get("ProvisionedThroughputInMibps", ""),
        "performance_mode": efs_fs.get("PerformanceMode"),
        "window_start_local": fmt_ts(start, tz),
        "window_end_local": fmt_ts(end, tz),
        "days": days,
        "period_seconds": period,
        "total_gib": r2(size["Value"] / GIB),
        "standard_gib": r2(standard / GIB),
        "ia_gib": r2(size.get("ValueInIA", 0) / GIB),
        "archive_gib": r2(size.get("ValueInArchive", 0) / GIB),
        "free_baseline_mibps": r2(baseline),
        "metered_avg_mibps": r2(avg),
        "metered_p50_mibps": r2(p50),
        "metered_p95_mibps": r2(p95),
        "metered_p99_mibps": r2(p99),
        "metered_max_mibps": r2(peak),
        "sustained_peak_15min_mibps": r2(sustained),
        "sustained_peak_start_local": fmt_ts(sustained_at, tz) if sustained_at else "",
        "read_p99_mibps": r2(percentile(read_vals, 99)),
        "read_max_mibps": r2(max(read_vals, default=0)),
        "write_p99_mibps": r2(percentile(write_vals, 99)),
        "write_max_mibps": r2(max(write_vals, default=0)),
        "percent_io_limit_max": r2(max(io_limit.values())) if io_limit else "",
        "suggested_provisioned_mibps": suggested,
        "billed_above_baseline_mibps": r2(max(0, suggested - baseline)),
    }

    hourly_rows = []
    for h in range(24):
        hv = by_hour.get(h, [])
        hourly_rows.append({
            "file_system_id": fs_id,
            "hour_local": f"{h:02d}:00",
            "data_points": len(hv),
            "avg_mibps": r2(sum(hv) / len(hv)) if hv else "",
            "p95_mibps": r2(percentile(sorted(hv), 95)) if hv else "",
            "max_mibps": r2(max(hv)) if hv else "",
        })

    read_map = dict(to_mibps(reads, period))
    write_map = dict(to_mibps(writes, period))
    ts_rows = []
    for ts, v in series:
        local = ts.astimezone(tz)
        ts_rows.append({
            "file_system_id": fs_id,
            "time_local": local.strftime("%Y-%m-%d %H:%M"),
            "tz": local.strftime("%Z"),
            "weekday": local.strftime("%a"),
            "time_utc": ts.astimezone(timezone.utc).strftime("%Y-%m-%d %H:%M"),
            "metered_mibps": r2(v),
            "read_mibps": r2(read_map.get(ts, 0.0)),
            "write_mibps": r2(write_map.get(ts, 0.0)),
            "percent_io_limit": r2(io_limit[ts]) if ts in io_limit else "",
        })

    return summary_row, hourly_rows, ts_rows


def write_csv(path, rows):
    if not rows:
        return
    with open(path, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=list(rows[0].keys()))
        writer.writeheader()
        writer.writerows(rows)
    print(f"Saved {os.path.abspath(path)}  ({len(rows)} rows)")


def main():
    parser = argparse.ArgumentParser(description="EFS throughput sizing report")
    parser.add_argument("--region", default="ap-southeast-2")
    parser.add_argument("--fs-id", help="Only report on this file system")
    parser.add_argument("--days", type=int, default=14,
                        help="Look-back window (1-min data is kept 15 days, "
                             "5-min data 63 days)")
    parser.add_argument("--tz", default="Australia/Sydney",
                        help="Time zone for displayed times (default Australia/Sydney)")
    parser.add_argument("--csv-prefix", default="efs_report",
                        help="Prefix for the CSV files (default efs_report)")
    args = parser.parse_args()
    tz = ZoneInfo(args.tz)

    # CloudWatch keeps 1-minute data for 15 days; beyond that use 5-minute data
    period = 60 if args.days <= 15 else 300
    if args.days > 63:
        print("Warning: beyond 63 days only 1-hour data exists; using 3600s period.")
        period = 3600

    efs = boto3.client("efs", region_name=args.region)
    cw = boto3.client("cloudwatch", region_name=args.region)

    summary, hourly, timeseries = [], [], []
    kwargs = {"FileSystemId": args.fs_id} if args.fs_id else {}
    for page in efs.get_paginator("describe_file_systems").paginate(**kwargs):
        for fs in page["FileSystems"]:
            try:
                s, h, t = report(fs, cw, args.days, period, tz)
            except Exception as e:  # keep going so the other file systems still get saved
                print(f"ERROR on {fs['FileSystemId']}: {e}\n")
                continue
            summary.append(s)
            hourly.extend(h)
            timeseries.extend(t)

    write_csv(f"{args.csv_prefix}_summary.csv", summary)
    write_csv(f"{args.csv_prefix}_hourly.csv", hourly)
    write_csv(f"{args.csv_prefix}_timeseries.csv", timeseries)


if __name__ == "__main__":
    main()
