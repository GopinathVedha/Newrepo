import boto3
import json
import logging
import uuid
from datetime import datetime, timedelta
from botocore.exceptions import ClientError

# ============================================================
# LAMBDA 2 of 2 — "Status" function (MULTI-ACCOUNT / CENTRAL HUB)
#
# Invoked ~3 minutes after Lambda 1, carrying ONLY the accounts and
# instance IDs actually touched that cycle. Restores capacity-downgraded
# instances to their original type, and checks health for just the
# started instances.
#
# SELF-HEALING: if a started instance genuinely fails its health check
# (impaired — not just still-initializing), this function automatically
# reboots it once, then schedules a one-time re-check of just that
# instance ~5 minutes later. If it's healthy by then, a "recovered" note
# is sent — no human involved. If it's still failing, it escalates to a
# "Manual Intervention Required" alert instead of rebooting again, so
# this can never loop.
# ============================================================

logger = logging.getLogger()
logger.setLevel(logging.INFO)

region = 'ap-southeast-2'

sns_topic_capacity_arn = 'arn:aws:sns:ap-southeast-2:050557606111:Autoscheduler_capacity_fallback'
sns_topic_health_arn = 'arn:aws:sns:ap-southeast-2:050557606111:Autoscheduler_health_check'

# Role EventBridge Scheduler assumes to invoke this function again for a re-check
SCHEDULER_EXECUTION_ROLE_ARN = 'arn:aws:iam::050557606111:role/EC2Autoscheduler-SchedulerInvokeRole'
REBOOT_RECHECK_DELAY_SECONDS = 300  # 5 minutes after the reboot

ORIGINAL_TYPE_TAG = 'equip:infra:original-instance-type'

sts_client = boto3.client('sts', region_name=region)
sns_client = boto3.client('sns', region_name=region)
scheduler_client = boto3.client('scheduler', region_name=region)


def get_account_session(role_arn):
    if not role_arn:
        return boto3.Session()
    creds = sts_client.assume_role(RoleArn=role_arn, RoleSessionName='ec2-autoscheduler-status')['Credentials']
    return boto3.Session(
        aws_access_key_id=creds['AccessKeyId'],
        aws_secret_access_key=creds['SecretAccessKey'],
        aws_session_token=creds['SessionToken'],
    )


def get_tag_value(instance, key):
    if instance.tags:
        for tag in instance.tags:
            if tag['Key'] == key:
                return tag['Value']
    return None


def send_sns_notification(message, topic_arn, subject='EC2 Scheduler Notification'):
    try:
        response = sns_client.publish(TopicArn=topic_arn, Message=message, Subject=subject)
        logger.info(f"SNS notification sent to {topic_arn} (MessageId: {response.get('MessageId')})")
    except Exception as e:
        logger.error(f"Failed to send SNS notification to {topic_arn}: {e}")


def get_event_table(events, columns):
    header = " | ".join(columns)
    sep = " | ".join(["-" * len(c) for c in columns])
    lines = [header, sep]
    for row in events:
        lines.append(" | ".join(str(x) for x in row))
    return "\n".join(lines)


def classify_health(status_entry):
    """Returns 'ok', 'impaired', 'initializing', or 'unknown'.
    Only 'impaired' should ever trigger a reboot — 'initializing' just
    means the instance hasn't finished booting yet, which is normal."""
    if not status_entry:
        return 'unknown'
    system = status_entry['SystemStatus']['Status']
    instance_check = status_entry['InstanceStatus']['Status']
    if system == 'ok' and instance_check == 'ok':
        return 'ok'
    if 'impaired' in (system, instance_check):
        return 'impaired'
    if 'initializing' in (system, instance_check):
        return 'initializing'
    return 'unknown'


def restore_original_type(ec2_client, ec2_resource, instance_id, name, account_name, restore_events, restore_failures):
    instance = ec2_resource.Instance(instance_id)
    original_type = get_tag_value(instance, ORIGINAL_TYPE_TAG)
    if not original_type or original_type == instance.instance_type:
        return
    try:
        ec2_client.modify_instance_attribute(InstanceId=instance_id, InstanceType={'Value': original_type})
        logger.info(f"Restored {instance_id} ({name}, {account_name}) from {instance.instance_type} to {original_type}")
        restore_events.append((instance_id, name, account_name, instance.instance_type, original_type))
        ec2_client.delete_tags(Resources=[instance_id], Tags=[{'Key': ORIGINAL_TYPE_TAG}])
    except ClientError as e:
        logger.error(f"Failed to restore {instance_id} ({name}, {account_name}): {e}")
        restore_failures.append((instance_id, name, account_name, str(e)))


def schedule_recheck(function_arn, payload, delay_seconds=REBOOT_RECHECK_DELAY_SECONDS):
    run_at = (datetime.utcnow() + timedelta(seconds=delay_seconds)).strftime('%Y-%m-%dT%H:%M:%S')
    schedule_name = f"ec2-autoscheduler-reboot-recheck-{uuid.uuid4().hex[:10]}"
    scheduler_client.create_schedule(
        Name=schedule_name,
        ScheduleExpression=f"at({run_at})",
        FlexibleTimeWindow={'Mode': 'OFF'},
        Target={'Arn': function_arn, 'RoleArn': SCHEDULER_EXECUTION_ROLE_ARN, 'Input': json.dumps(payload)},
        ActionAfterCompletion='DELETE'
    )
    logger.info(f"Scheduled reboot re-check as '{schedule_name}' for {run_at} UTC")


def handle_reboot_recheck(event):
    """Second-pass invocation: check ONLY the one instance that was rebooted."""
    info = event['recheck']
    account_name = info['account_name']
    role_arn = info.get('role_arn')
    instance_id = info['instance_id']
    instance_name = info.get('instance_name', 'Unnamed')

    try:
        session = get_account_session(role_arn)
        ec2_client = session.client('ec2', region_name=region)
        status_resp = ec2_client.describe_instance_status(InstanceIds=[instance_id], IncludeAllInstances=True)
        category = classify_health(status_resp['InstanceStatuses'][0]) if status_resp['InstanceStatuses'] else 'unknown'
    except Exception as e:
        logger.error(f"Reboot re-check failed for {instance_id} ({account_name}): {e}")
        send_sns_notification(
            f"❌ Could not re-check {instance_name} ({account_name}, {instance_id}) after its "
            f"automatic reboot.\n\nError: {e}\n\nPlease check it manually.",
            sns_topic_capacity_arn, subject='EC2 Scheduler - Reboot Recheck FAILED'
        )
        return

    if category == 'ok':
        logger.info(f"{instance_id} ({account_name}) recovered after auto-reboot")
        send_sns_notification(
            f"✅ {instance_name} ({account_name}, {instance_id}) recovered after an automatic "
            f"reboot and is now passing 2/2 health checks. No action needed.",
            sns_topic_health_arn, subject='EC2 Scheduler - Recovered After Auto-Reboot'
        )
    else:
        logger.warning(f"{instance_id} ({account_name}) still unhealthy ({category}) after auto-reboot")
        send_sns_notification(
            f"🚨 {instance_name} ({account_name}, {instance_id}) is STILL failing its health check "
            f"(status: {category}) after an automatic reboot.\n\n"
            f"No further automatic action will be taken — this needs manual investigation.",
            sns_topic_capacity_arn, subject='EC2 Scheduler - Manual Intervention Required'
        )


# ---------- Main handler ----------

def lambda_handler(event, context):
    logger.info(f"Lambda 2 (status) invoked. Event: {json.dumps(event)}")

    # Branch 1: this is a follow-up re-check after an automatic reboot
    if 'recheck' in event:
        handle_reboot_recheck(event)
        return

    # Branch 2: normal invocation from Lambda 1
    try:
        timestamp = event.get("timestamp", "")
        had_starts = event.get("had_starts", False)
        accounts_involved = event.get("accounts_involved", {})

        restore_events, restore_failures = [], []
        health_sections = []
        auto_reboot_triggered = []     # (instance_id, name, account)
        reboot_failures = []           # (instance_id, name, account, reason)
        account_access_failures = []

        for account_id, info in accounts_involved.items():
            account_name = info.get('name', account_id)
            role_arn = info.get('role_arn')
            autostop_ids = info.get('autostop_instance_ids', [])
            autostart_ids = info.get('autostart_instance_ids', [])
            instance_names = info.get('instance_names', {})

            try:
                session = get_account_session(role_arn)
                ec2_resource = session.resource('ec2', region_name=region)
                ec2_client = session.client('ec2', region_name=region)
            except ClientError as e:
                logger.error(f"Could not assume role for account {account_id} ({account_name}): {e}")
                account_access_failures.append((account_id, account_name, str(e)))
                continue

            # --- Restore capacity-downgraded instances ---
            for instance_id in autostop_ids:
                try:
                    instance = ec2_resource.Instance(instance_id)
                    instance.reload()
                    if instance.state['Name'] == 'stopped':
                        restore_original_type(ec2_client, ec2_resource, instance_id,
                                               instance_names.get(instance_id, 'Unnamed'), account_name,
                                               restore_events, restore_failures)
                    else:
                        original_type = get_tag_value(instance, ORIGINAL_TYPE_TAG)
                        if original_type:
                            logger.info(f"{instance_id} ({account_name}) not yet stopped; will retry next cycle")
                except Exception as e:
                    logger.error(f"Error checking/restoring {instance_id} ({account_name}): {e}")

            # --- Health check + auto-reboot on genuine failure (only started instances) ---
            if had_starts and autostart_ids:
                try:
                    desc = ec2_client.describe_instances(InstanceIds=autostart_ids)
                    state_by_id = {inst['InstanceId']: inst['State']['Name']
                                   for res in desc['Reservations'] for inst in res['Instances']}
                    status_resp = ec2_client.describe_instance_status(InstanceIds=autostart_ids, IncludeAllInstances=True)
                    status_by_id = {st['InstanceId']: st for st in status_resp['InstanceStatuses']}
                except Exception as e:
                    logger.error(f"Could not describe status for {account_name}: {e}")
                    continue

                table_lines = ["     Instance ID     |     Server Name     |     Status      |   Health Check",
                                "------------------- | ------------------- | --------------- | ----------------"]
                for iid in autostart_ids:
                    name = instance_names.get(iid, 'Unnamed')
                    status_entry = status_by_id.get(iid)
                    category = classify_health(status_entry)
                    health_label = {
                        'ok': '2/2 Passed', 'impaired': 'IMPAIRED', 'initializing': 'Initializing',
                    }.get(category, 'N/A')
                    table_lines.append(f"{iid:<19} | {name:<19} | {state_by_id.get(iid, 'unknown'):<15} | {health_label}")

                    if category == 'impaired':
                        try:
                            ec2_client.reboot_instances(InstanceIds=[iid])
                            logger.warning(f"AUTO-REBOOT triggered for {iid} ({name}, {account_name}) — failed health check")
                            auto_reboot_triggered.append((iid, name, account_name))
                            schedule_recheck(context.invoked_function_arn, {
                                "recheck": {
                                    "account_id": account_id, "account_name": account_name,
                                    "role_arn": role_arn, "instance_id": iid, "instance_name": name,
                                }
                            })
                        except Exception as e:
                            logger.error(f"Failed to reboot {iid} ({name}, {account_name}): {e}")
                            reboot_failures.append((iid, name, account_name, str(e)))

                health_sections.append(f"\n[{account_name}] {len(autostart_ids)} instance(s) checked:\n"
                                        + "\n".join(table_lines))

        if account_access_failures:
            send_sns_notification(
                "❌ EC2 Autoscheduler status check could not access these accounts:\n"
                + get_event_table(account_access_failures, ["Account ID", "Account Name", "Error"]),
                sns_topic_capacity_arn, subject='EC2 Scheduler - Status Check Account Access FAILED'
            )

        if restore_events or restore_failures:
            capacity_lines = [f"♻️ EC2 Instance Type Restore Report\n\n📅 Timestamp: {timestamp}\n"]
            if restore_events:
                capacity_lines.append("Instances restored back to their original instance type:\n"
                    + get_event_table(restore_events, ["Instance ID", "Name", "Account", "Ran As", "Restored To"]))
            if restore_failures:
                capacity_lines.append("\nInstances that FAILED to restore (will retry next stop cycle):\n"
                    + get_event_table(restore_failures, ["Instance ID", "Name", "Account", "Reason"]))
            send_sns_notification("\n".join(capacity_lines), sns_topic_capacity_arn,
                                   subject='EC2 Scheduler - Instance Type Restore Report')

        if auto_reboot_triggered or reboot_failures:
            reboot_lines = [f"🔁 EC2 Autoscheduler — Automatic Reboot Triggered\n\n📅 Timestamp: {timestamp}\n"]
            if auto_reboot_triggered:
                reboot_lines.append(
                    "These instances failed their health check and were automatically rebooted.\n"
                    "A follow-up check will run in ~5 minutes and only escalate to an alert if still failing:\n"
                    + get_event_table(auto_reboot_triggered, ["Instance ID", "Name", "Account"])
                )
            if reboot_failures:
                reboot_lines.append(
                    "\nThese instances failed their health check but the automatic reboot ITSELF failed "
                    "(needs manual attention now):\n"
                    + get_event_table(reboot_failures, ["Instance ID", "Name", "Account", "Reason"])
                )
            send_sns_notification("\n".join(reboot_lines), sns_topic_capacity_arn,
                                   subject='EC2 Scheduler - Automatic Reboot Triggered')

        if had_starts and health_sections:
            message = (f"♻️ EC2 Autoscheduler — Follow-up Health Check\n\n📅 Timestamp: {timestamp}\n"
                       + "".join(health_sections))
            logger.info(message)
            send_sns_notification(message, sns_topic_health_arn, subject='EC2 Scheduler - Follow-up Health Check')
        else:
            logger.info("No start actions this cycle — skipping the health-check email.")

    except Exception as e:
        logger.exception(f"Unhandled error in Lambda 2 status-check handler: {e}")
        send_sns_notification(
            f"❌ EC2 Autoscheduler Lambda 2 (status/restore) hit an unhandled error.\n\nError: {e}\n\n"
            f"Check CloudWatch Logs for this function for the full traceback.",
            sns_topic_capacity_arn, subject='EC2 Scheduler - Status Lambda FAILED'
        )
        raise
