"""EC2 AutoScheduler — Lambda 2 (Status / Restore / Reconciliation).

Handler: ec2_autoscheduler_status.lambda_handler
Handles follow-up health, verification of stops, guarded original-type
restoration, bounded retries and periodic tag reconciliation. See DEPLOYMENT.md.
"""
import json
import logging
import os
import re
import uuid
from datetime import datetime, timedelta, timezone

import boto3
from botocore.exceptions import ClientError

log = logging.getLogger(__name__)
log.setLevel(logging.INFO)
REGION = 'ap-southeast-2'
SNS_CAPACITY = 'arn:aws:sns:ap-southeast-2:050557606111:Autoscheduler_capacity_fallback'
SNS_HEALTH = 'arn:aws:sns:ap-southeast-2:050557606111:Autoscheduler_health_check'
SNS_STOP = 'arn:aws:sns:ap-southeast-2:050557606111:Autoscheduler_stop'
SCHEDULER_ROLE_ARN = 'arn:aws:iam::050557606111:role/EC2Autoscheduler-SchedulerInvokeRole'
ACCOUNTS_SSM = '/autoscheduler/Accounts'
TAG_ORIGINAL = 'equip:infra:original-instance-type'
MAX_RESTORE_ATTEMPTS = 8
MAX_HEALTH_ATTEMPTS = 6
RESTORE_RETRY_SECONDS = 180
HEALTH_RETRY_SECONDS = 180
RECOVERY_RECHECK_SECONDS = 180
MAX_RECOVERY_STOP_ATTEMPTS = 8
BATCH_SIZE = 100

sts = boto3.client('sts', region_name=REGION)
sns = boto3.client('sns', region_name=REGION)
ssm = boto3.client('ssm', region_name=REGION)
scheduler = boto3.client('scheduler', region_name=REGION)
cloudwatch = boto3.client('cloudwatch', region_name=REGION)


def metric(name, value=1):
    try:
        cloudwatch.put_metric_data(Namespace='EC2AutoScheduler', MetricData=[{
            'MetricName': name, 'Value': value, 'Unit': 'Count',
            'Dimensions': [{'Name': 'Function', 'Value': 'Status'}]}])
    except Exception:
        log.exception('METRIC_DELIVERY_FAILED %s', name)


def notify(topic, subject, message, cycle):
    body = message
    try:
        response = sns.publish(TopicArn=topic, Subject=subject[:100], Message=body)
        log.info('SNS_SENT subject=%s message_id=%s cycle=%s', subject, response.get('MessageId'), cycle)
        return True
    except Exception:
        log.exception('SNS_PUBLISH_FAILED subject=%s cycle=%s topic=%s', subject, cycle, topic)
        metric('NotificationFailures')
        return False


def get_session(role_arn):
    if not role_arn:
        return boto3.Session()
    credentials = sts.assume_role(RoleArn=role_arn, RoleSessionName='ec2-autoscheduler-status')['Credentials']
    return boto3.Session(aws_access_key_id=credentials['AccessKeyId'],
                         aws_secret_access_key=credentials['SecretAccessKey'],
                         aws_session_token=credentials['SessionToken'])


def get_ec2(acct):
    return get_session(acct.get('role_arn')).client('ec2', region_name=REGION)


def get_instance(ec2, iid):
    response = ec2.describe_instances(InstanceIds=[iid])
    matches = [x for reservation in response.get('Reservations', [])
               for x in reservation.get('Instances', [])]
    if len(matches) != 1:
        raise RuntimeError(f'Expected one record for {iid}; got {len(matches)}')
    return matches[0]


def instance_tags(live):
    return {tag['Key']: tag['Value'] for tag in live.get('Tags', [])}


def format_line(acct, name, iid, explanation):
    return f'- {acct} | {name} | {iid} | {explanation}'


def validated_accounts():
    raw = json.loads(ssm.get_parameter(Name=ACCOUNTS_SSM)['Parameter']['Value'])
    if not isinstance(raw, list) or not raw:
        raise ValueError('SSM account list must be a nonempty JSON array')
    central = sts.get_caller_identity()['Account']
    valid, failures, seen = [], [], set()
    for item in raw:
        if not isinstance(item, dict):
            failures.append('Malformed account entry')
            continue
        aid = str(item.get('account_id', ''))
        role = item.get('role_arn')
        if not re.fullmatch(r'\d{12}', aid) or aid in seen:
            failures.append(f'Invalid or duplicate account ID: {aid}')
            continue
        if role is None:
            if aid != central:
                failures.append(f'{aid}: null role cannot target external account')
                continue
        elif not isinstance(role, str) or not re.fullmatch(
                rf'arn:aws[a-z-]*:iam::{aid}:role/[\w+=,.@/\-]+', role):
            failures.append(f'{aid}: role ARN invalid')
            continue
        seen.add(aid)
        valid.append({'account_id': aid, 'name': str(item.get('name') or aid), 'role_arn': role})
    return valid, failures


def create_recheck(kind, acct, iid, name, cycle, attempt=1, rebooted=False, delay=180):
    payload = {'mode': 'recheck', 'cycle_id': cycle,
               'recheck': {'kind': kind, 'account_id': acct['account_id'],
                           'account_name': acct['name'], 'role_arn': acct.get('role_arn'),
                           'instance_id': iid, 'instance_name': name, 'attempt': attempt,
                           'rebooted': rebooted, 'recovery_attempted': rebooted, 'instance_role': acct.get('instance_role', 'unknown')}}
    run_at = (datetime.now(timezone.utc) + timedelta(seconds=delay)).strftime('%Y-%m-%dT%H:%M:%S')
    target = {'Arn': os.environ.get('AWS_LAMBDA_FUNCTION_ARN') or STATUS_LAMBDA_ARN,
              'RoleArn': SCHEDULER_ROLE_ARN, 'Input': json.dumps(payload, separators=(',', ':')),
              'RetryPolicy': {'MaximumRetryAttempts': 3, 'MaximumEventAgeInSeconds': 3600}}
    dlq = os.environ.get('AUTOSCHEDULER_SCHEDULER_DLQ_ARN', '').strip()
    if dlq:
        target['DeadLetterConfig'] = {'Arn': dlq}
    else:
        log.warning('SCHEDULER_DLQ_UNCONFIGURED status Lambda; configure env var for reliable recovery')
    name_schedule = f'ec2-autoscheduler-recheck-{uuid.uuid4().hex[:14]}'
    scheduler.create_schedule(Name=name_schedule, ScheduleExpression=f'at({run_at})',
                              ScheduleExpressionTimezone='UTC',
                              FlexibleTimeWindow={'Mode': 'OFF'}, Target=target,
                              ActionAfterCompletion='DELETE')
    return name_schedule


# The original deployed function name, unchanged.
STATUS_LAMBDA_ARN = 'arn:aws:lambda:ap-southeast-2:050557606111:function:ec2_autoscheduler_status'


def restore(ec2, acct, iid, name, cycle, attempt=0, verify_stop=False):
    """Return (outcome, message): VERIFIED, CLEANED, NONE, PENDING or FAILED.

    Never remove the original-type tag before verifying EC2 reports the
    original instance type. A running downgraded instance is never modified.
    """
    account_name = acct['name']
    try:
        live = get_instance(ec2, iid)
        state, current = live['State']['Name'], live['InstanceType']
        original = instance_tags(live).get(TAG_ORIGINAL)
        if original and state == 'running' and current == original and not verify_stop:
            ec2.delete_tags(Resources=[iid], Tags=[{'Key': TAG_ORIGINAL}])
            return 'CLEANED', format_line(account_name, name, iid, 'Stale original-type tag removed; already original type')
        # Ordinary stop operations do not require a restoration recheck.
        # Only instances carrying the original-type tag need to be tracked
        # until stopped, because the type can only be modified while stopped.
        if not original:
            log.info('RESTORE_NOT_REQUIRED account=%s server=%s instance=%s state=%s cycle=%s',
                     account_name, name, iid, state, cycle)
            return 'NONE', ''
        if state == 'running' and not verify_stop:
            # Periodic reconciliation must not stop or resize running servers.
            return 'NONE', ''
        if state not in ('stopped',):
            if attempt < MAX_RESTORE_ATTEMPTS:
                create_recheck('restore', acct, iid, name, cycle, attempt + 1,
                               delay=RESTORE_RETRY_SECONDS)
                log.info('RESTORE_WAITING account=%s server=%s instance=%s state=%s retry=%s/%s cycle=%s', account_name, name, iid, state, attempt+1, MAX_RESTORE_ATTEMPTS, cycle)
                return 'PENDING', format_line(account_name, name, iid, f'EC2 {state}; restore recheck {attempt+1}/{MAX_RESTORE_ATTEMPTS} scheduled')
            metric('RestoreFailures')
            return 'FAILED', format_line(account_name, name, iid, f'EC2 remained {state} after {attempt} retries; MANUAL ACTION')
        if not original:
            return 'STOPPED', format_line(account_name, name, iid, 'STOP VERIFIED; no original-type tag')
        if current == original:
            ec2.delete_tags(Resources=[iid], Tags=[{'Key': TAG_ORIGINAL}])
            return 'CLEANED', format_line(account_name, name, iid, f'Already {original}; stale original-type tag removed')
        ec2.modify_instance_attribute(InstanceId=iid, InstanceType={'Value': original})
        verified = get_instance(ec2, iid)
        if verified['State']['Name'] != 'stopped' or verified['InstanceType'] != original:
            raise RuntimeError(f'Post-restore verification failed: state={verified["State"]["Name"]}, type={verified["InstanceType"]}')
        log.info('RESTORE_SUCCESS account=%s server=%s instance=%s previous_type=%s original_type=%s cycle=%s',
                 account_name, name, iid, current, original, cycle)
        metric('RestorationsVerified')
        try:
            ec2.delete_tags(Resources=[iid], Tags=[{'Key': TAG_ORIGINAL}])
        except Exception as cleanup_exc:
            log.exception('RESTORED_BUT_TAG_CLEANUP_FAILED instance=%s', iid)
            try:
                create_recheck('restore', acct, iid, name, cycle, attempt + 1,
                               delay=RESTORE_RETRY_SECONDS)
                cleanup_note = 'tag cleanup retry scheduled'
            except Exception as schedule_exc:
                metric('SchedulerFailures')
                cleanup_note = f'tag cleanup requires MANUAL ACTION: {schedule_exc}'
            return 'VERIFIED_CLEANUP_PENDING', format_line(account_name, name, iid,
                      f'RESTORED AND VERIFIED {current} -> {original}; tag deletion failed ({cleanup_exc}); {cleanup_note}')
        return 'VERIFIED', format_line(account_name, name, iid,
                                       f'RESTORED {current} -> {original}; stopped; tag removed; no action required')
    except Exception as exc:
        log.exception('RESTORE_ERROR account=%s instance=%s cycle=%s', account_name, iid, cycle)
        if attempt < MAX_RESTORE_ATTEMPTS:
            try:
                create_recheck('restore', acct, iid, name, cycle, attempt + 1,
                               delay=RESTORE_RETRY_SECONDS)
                log.warning('RESTORE_RETRY account=%s server=%s instance=%s retry=%s/%s reason=%s cycle=%s', account_name, name, iid, attempt+1, MAX_RESTORE_ATTEMPTS, exc, cycle)
                return 'PENDING', format_line(account_name, name, iid, f'Restore error: {exc}; retry {attempt+1}/{MAX_RESTORE_ATTEMPTS} scheduled')
            except Exception as schedule_exc:
                metric('SchedulerFailures')
                metric('RestoreFailures')
                return 'FAILED', format_line(account_name, name, iid,
                                             f'Restore failed ({exc}); retry could NOT be scheduled ({schedule_exc})')
        metric('RestoreFailures')
        return 'FAILED', format_line(account_name, name, iid,
                                     f'Restore failed after {attempt} retries: {exc}; original-type tag should be retained')


def status_entries(ec2, ids):
    """Chunk EC2 DescribeInstanceStatus requests; isolate failures per batch."""
    states, checks, errors = {}, {}, {}
    for ix in range(0, len(ids), BATCH_SIZE):
        batch = ids[ix:ix+BATCH_SIZE]
        try:
            res = ec2.describe_instances(InstanceIds=batch)
            for reservation in res.get('Reservations', []):
                for instance in reservation.get('Instances', []):
                    states[instance['InstanceId']] = instance['State']['Name']
            checks_resp = ec2.describe_instance_status(InstanceIds=batch, IncludeAllInstances=True)
            for entry in checks_resp.get('InstanceStatuses', []):
                checks[entry['InstanceId']] = entry
        except Exception as exc:
            log.exception('HEALTH_BATCH_API_ERROR ids=%s', batch)
            # Per-instance retry permits a bad ID to not suppress the others.
            for iid in batch:
                try:
                    single = ec2.describe_instances(InstanceIds=[iid])
                    inst = single['Reservations'][0]['Instances'][0]
                    states[iid] = inst['State']['Name']
                    result = ec2.describe_instance_status(InstanceIds=[iid], IncludeAllInstances=True)
                    if result.get('InstanceStatuses'):
                        checks[iid] = result['InstanceStatuses'][0]
                except Exception as individual_exc:
                    errors[iid] = str(individual_exc)
    return states, checks, errors


def health_category(state, check):
    if state != 'running':
        return 'initializing' if state in ('pending', 'stopping') else 'unknown'
    if not check:
        return 'unknown'
    sys_status = check.get('SystemStatus', {}).get('Status', 'unknown')
    inst_status = check.get('InstanceStatus', {}).get('Status', 'unknown')
    if sys_status == inst_status == 'ok':
        return 'ok'
    if 'impaired' in (sys_status, inst_status):
        return 'impaired'
    if 'initializing' in (sys_status, inst_status):
        return 'initializing'
    return 'unknown'


def health_table(lines):
    headers = ['Account', 'Server Name', 'Action', 'EC2 2/2 Health Check Status']
    rows = []
    for line in lines:
        fields = [v.strip() for v in line.removeprefix('- ').split(' | ', 3)]
        if len(fields) != 4:
            continue
        account, server, _iid, details = fields
        role = 'UNKNOWN'
        for part in details.split(' | '):
            if part.startswith('ROLE='):
                role = part.split('=', 1)[1]
        if 'API error=' in details:
            health = 'NOT CHECKED - API ERROR: ' + details.split('API error=', 1)[1].split(' | ')[0][:80]
        elif 'RECOVERED' in details:
            health = 'OK (Recovered)'
        elif 'MANUAL' in details or 'CRITICAL' in details or 'FAILED' in details:
            health = 'FAILED - Manual Action'
        elif 'EC2 2/2=OK' in details:
            health = 'OK'
        elif 'EC2 2/2=IMPAIRED' in details:
            health = 'IMPAIRED'
        else:
            health = 'Pending / Recheck'
        rows.append([account, server, f'Started ({role})', health])
    widths = [min(max(len(str(row[i])) for row in [headers] + rows), 80 if i == 3 else 33) for i in range(4)]
    def fmt(row):
        return ' | '.join(str(item)[:widths[i]].ljust(widths[i]) for i, item in enumerate(row))
    return '\n'.join([fmt(headers), '-+-'.join('-'*x for x in widths)] + [fmt(row) for row in rows])


def inspect_health(ec2, acct, iid, name, cycle, attempt=0, rebooted=False,
                   state=None, check=None, error=None):
    """Only INSTANCE status 'impaired' triggers a single Stop/Start recovery.

    Initializing, unknown, non-running and system-only failures do not trigger
    stop/start. They receive bounded rechecks followed by manual escalation.
    """
    account = acct['name']
    if state is None and error is None:
        states, checks, errors = status_entries(ec2, [iid])
        state, check, error = states.get(iid, 'unknown'), checks.get(iid), errors.get(iid)
    category = 'unknown' if error else health_category(state, check)
    instance_status = (check or {}).get('InstanceStatus', {}).get('Status', 'unknown')
    system_status = (check or {}).get('SystemStatus', {}).get('Status', 'unknown')
    role = acct.get('instance_role', 'unknown').upper()
    info = format_line(account, name, iid, f'ROLE={role} | state={state} | EC2 2/2={category.upper()} | System={system_status} | Instance={instance_status}')
    if error:
        info += f' | API error={error}'
    if category == 'ok':
        if rebooted:
            info += ' | RECOVERED after one Stop/Start'
        return 'ok', info, None
    if rebooted and category == 'impaired':
        metric('HealthUnresolved')
        return 'critical', info + ' | MANUAL ACTION: health still impaired after one Stop/Start', info
    # An instance status failure (not system-only) is eligible for one recovery.
    if state == 'running' and instance_status == 'impaired' and not rebooted:
        try:
            ec2.stop_instances(InstanceIds=[iid])
        except Exception as exc:
            metric('HealthUnresolved')
            return 'critical', info + f' | MANUAL ACTION: Stop request FAILED: {exc}', info + f' | Stop request FAILED: {exc}'
        try:
            create_recheck('recovery_stop', acct, iid, name, cycle, attempt=0,
                           rebooted=True, delay=RECOVERY_RECHECK_SECONDS)
            return 'recovering', info + ' | Stop requested for one recovery; follow-up scheduled', None
        except Exception as exc:
            metric('SchedulerFailures'); metric('HealthUnresolved')
            return 'critical', info + f' | MANUAL ACTION: stop requested but recovery scheduling FAILED: {exc}', info
    if attempt >= MAX_HEALTH_ATTEMPTS:
        metric('HealthUnresolved')
        return 'critical', info + f' | MANUAL ACTION: unresolved after {attempt} health rechecks', info
    try:
        create_recheck('health', acct, iid, name, cycle, attempt + 1,
                       rebooted=rebooted, delay=HEALTH_RETRY_SECONDS)
        return 'pending', info + f' | Recheck {attempt+1}/{MAX_HEALTH_ATTEMPTS} scheduled', None
    except Exception as exc:
        metric('SchedulerFailures'); metric('HealthUnresolved')
        return 'critical', info + f' | MANUAL ACTION: health recheck scheduling FAILED: {exc}', info


def handle_recovery_recheck(ec2, acct, iid, name, cycle, kind, attempt):
    """Resume exactly one stop/start cycle using bounded one-time Scheduler events."""
    try:
        live = get_instance(ec2, iid)
        state = live['State']['Name']
        if kind == 'recovery_stop':
            if state == 'stopped':
                # Do not invoke capacity fallback or modify original-type tag.
                ec2.start_instances(InstanceIds=[iid])
                create_recheck('health', acct, iid, name, cycle, attempt=0,
                               rebooted=True, delay=RECOVERY_RECHECK_SECONDS)
                return 'START REQUESTED; recovery health recheck scheduled'
            if state in ('stopping',) and attempt < MAX_RECOVERY_STOP_ATTEMPTS:
                create_recheck('recovery_stop', acct, iid, name, cycle, attempt=attempt+1,
                               rebooted=True, delay=RECOVERY_RECHECK_SECONDS)
                return f'STOPPING; recheck {attempt+1}/{MAX_RECOVERY_STOP_ATTEMPTS} scheduled'
            return f'MANUAL ACTION: recovery stop state={state} after attempt={attempt}'
        raise ValueError('Unsupported recovery phase')
    except Exception as exc:
        metric('HealthUnresolved')
        return f'MANUAL ACTION: recovery {kind} failed: {exc}'

def send_restoration_report(outcomes, cycle):
    """Email only final verified restorations / actionable failures.

    Ordinary stop checks, internal retries, and non-restoration tag cleanup
    are excluded. Instance IDs stay in CloudWatch logs for diagnosis.
    """
    groups = {'VERIFIED': [], 'FAILED': [], 'VERIFIED_CLEANUP_PENDING': []}
    for outcome, detail in outcomes:
        if outcome not in groups or not detail:
            continue
        parts = [part.strip() for part in detail.removeprefix('- ').split(' | ', 3)]
        if len(parts) != 4:
            log.warning('RESTORE_REPORT_ROW_INVALID outcome=%s detail=%s', outcome, detail)
            continue
        account, server, instance_id, explanation = parts
        if outcome == 'VERIFIED':
            display = 'Restored original instance type'
        elif outcome == 'VERIFIED_CLEANUP_PENDING':
            display = 'Restored; tag cleanup requires attention'
        else:
            display = 'Restoration failed - manual action required'
        groups[outcome].append((account, server, display))
        log.info('RESTORE_REPORT_RESULT outcome=%s account=%s server=%s instance=%s detail=%s cycle=%s',
                 outcome, account, server, instance_id, explanation, cycle)
    for outcome, subject in [('VERIFIED', 'SUCCESS'),
                             ('VERIFIED_CLEANUP_PENDING', 'ATTENTION'),
                             ('FAILED', 'FAILED')]:
        if not groups[outcome]:
            continue
        headers = ('Account', 'Server Name', 'Status')
        rows = groups[outcome]
        widths = [min(max(len(str(r[i])) for r in [headers] + rows), 46) for i in range(3)]
        def fmt(r):
            return ' | '.join(str(v)[:widths[i]].ljust(widths[i]) for i, v in enumerate(r))
        table = '\n'.join([fmt(headers), '-+-'.join('-' * w for w in widths)] +
                          [fmt(row) for row in rows])
        notify(SNS_CAPACITY, f'[EC2 Scheduler][RESTORE][{subject}] {len(rows)} instance(s)',
               table, cycle)


def run_status(event, cycle):
    accounts = event.get('accounts_involved') or {}
    if not isinstance(accounts, dict):
        raise ValueError('accounts_involved must be an object')
    all_restores, lines_health, urgent, errors, recoveries = [], [], [], [], []
    for account_id, raw in accounts.items():
        account = {'account_id': account_id, 'name': raw.get('name', account_id),
                   'role_arn': raw.get('role_arn')}
        start_ids = list(dict.fromkeys(raw.get('autostart_instance_ids') or []))
        stop_ids = list(dict.fromkeys((raw.get('autostop_instance_ids') or []) +
                                          (raw.get('restore_instance_ids') or [])))
        names = raw.get('instance_names') or {}
        roles = raw.get('instance_roles') or {}
        try:
            ec2 = get_ec2(account)
            # Force an API call to surface failed role assumption before reporting.
            if not hasattr(ec2, 'describe_instances'):
                raise RuntimeError('EC2 client unavailable')
        except Exception as exc:
            errors.append(f'{account["name"]} ({account_id}) | assume-role/client failed: {exc}')
            metric('AccountFailures')
            # Don't silently drop attempted start health from summary.
            lines_health.extend(format_line(account['name'], names.get(iid, 'Unnamed'), iid,
                                            f'ROLE={roles.get(iid, "unknown").upper()} | NOT CHECKED | cross-account access failure') for iid in start_ids)
            continue
        for iid in stop_ids:
            outcome = restore(ec2, account, iid, names.get(iid, 'Unnamed'), cycle,
                              verify_stop=iid in raw.get('autostop_instance_ids', []))
            all_restores.append(outcome)
            log.info('STOP_FOLLOWUP account=%s server=%s instance=%s restore_outcome=%s cycle=%s', account['name'], names.get(iid, 'Unnamed'), iid, outcome[0], cycle)
        if start_ids:
            states, checks, api_errors = status_entries(ec2, start_ids)
            for iid in start_ids:
                category, line, urgent_line = inspect_health(
                    ec2, {**account, 'instance_role': roles.get(iid, 'unknown')}, iid, names.get(iid, 'Unnamed'), cycle,
                    state=states.get(iid, 'unknown'), check=checks.get(iid), error=api_errors.get(iid))
                lines_health.append(line)
                log.info('HEALTH_RESULT account=%s server=%s instance=%s role=%s outcome=%s detail=%s cycle=%s', account['name'], names.get(iid, 'Unnamed'), iid, roles.get(iid, 'unknown'), category, line, cycle)
                if urgent_line:
                    urgent.append(urgent_line)
                if category == 'recovering':
                    recoveries.append(line)
    send_restoration_report(all_restores, cycle)
    if recoveries:
        notify(SNS_HEALTH, f'[EC2 Scheduler][HEALTH][STOP-START] {len(recoveries)} instance(s)',
               'EC2 instance status failed: one Stop/Start recovery was requested.\n' + '\n'.join(recoveries), cycle)
    if lines_health:
        summary = f'FOLLOW-UP EC2 HEALTH REPORT | {len(lines_health)} start request(s)\n' + health_table(lines_health)
        if errors:
            summary += '\n\nACCOUNT/API ERRORS:\n' + '\n'.join(errors)
        notify(SNS_HEALTH, '[EC2 Scheduler][HEALTH][FOLLOW-UP] ' + str(len(lines_health)) + ' instance(s)',
               summary, cycle)
    if urgent or errors:
        notify(SNS_HEALTH, '[EC2 Scheduler][HEALTH/ACCOUNT][ATTENTION]',
               'MANUAL ATTENTION / AUTOMATION ERROR:\n' + '\n'.join(urgent + errors), cycle)
    return {'restorations': len(all_restores), 'health_checked': len(lines_health),
            'errors': len(errors), 'urgent': len(urgent)}


def run_recheck(event, cycle):
    raw = event['recheck']
    acct = {'account_id': raw['account_id'], 'name': raw['account_name'],
            'role_arn': raw.get('role_arn'), 'instance_role': raw.get('instance_role', 'unknown')}
    iid, name, kind = raw['instance_id'], raw.get('instance_name', 'Unnamed'), raw['kind']
    attempt = int(raw.get('attempt', 0))
    try:
        ec2 = get_ec2(acct)
        if kind == 'restore':
            outcome = restore(ec2, acct, iid, name, cycle, attempt=attempt, verify_stop=True)
            log.info('RESTORE_RECHECK_RESULT account=%s server=%s instance=%s attempt=%s outcome=%s cycle=%s', acct['name'], name, iid, attempt, outcome[0], cycle)
            send_restoration_report([outcome], cycle)
            return {'kind': kind, 'outcome': outcome[0]}
        if kind == 'recovery_stop':
            outcome = handle_recovery_recheck(ec2, acct, iid, name, cycle, kind, attempt)
            if 'MANUAL ACTION' in outcome:
                notify(SNS_HEALTH, '[EC2 Scheduler][HEALTH][MANUAL INTERVENTION]',
                       format_line(acct['name'], name, iid, outcome), cycle)
            return {'kind': kind, 'outcome': outcome}
        if kind == 'health':
            category, line, urgent = inspect_health(ec2, acct, iid, name, cycle,
                                                     attempt=attempt, rebooted=bool(raw.get('recovery_attempted', raw.get('rebooted'))))
            if category != 'pending':
                notify(SNS_HEALTH, f'[EC2 Scheduler][HEALTH][{category.upper()}]', line, cycle)
            if urgent:
                notify(SNS_HEALTH, '[EC2 Scheduler][HEALTH][MANUAL INTERVENTION]', urgent, cycle)
            return {'kind': kind, 'outcome': category}
        raise ValueError(f'Unsupported recheck kind: {kind}')
    except Exception as exc:
        log.exception('RECHECK_FAILED kind=%s instance=%s cycle=%s', kind, iid, cycle)
        metric('AccountFailures')
        notify(SNS_CAPACITY, '[EC2 Scheduler][RECHECK][FAILED]',
               f'Unable to recheck {iid} ({name}, {acct["name"]}), kind={kind}, attempt={attempt}: {exc}', cycle)
        raise


def run_reconcile(cycle):
    """External EventBridge rule invokes {"mode":"reconcile"} every 15 minutes.

    Deliberately does not start/stop any EC2 instance. Only stopped tagged
    instances are resized back, and stopping ones get bounded retry.
    """
    accounts, config_errors = validated_accounts()
    results, errors = [], list(config_errors)
    for acct in accounts:
        try:
            ec2 = get_ec2(acct)
            pages = ec2.get_paginator('describe_instances').paginate(
                Filters=[{'Name': 'tag-key', 'Values': [TAG_ORIGINAL]}])
            for page in pages:
                for reservation in page.get('Reservations', []):
                    for instance in reservation.get('Instances', []):
                        iid = instance['InstanceId']
                        state = instance['State']['Name']
                        # Never resize a running EC2 instance; leave tag for shutdown.
                        original = instance_tags(instance).get(TAG_ORIGINAL)
                        # Avoid racing an Action Lambda that has JUST written
                        # the safety tag but has not yet resized the server.
                        # If already original, do not clean the tag in the
                        # periodic job; normal start/stop handles stale tags.
                        if original and original != instance['InstanceType'] and state in ('stopped', 'stopping'):
                            name = instance_tags(instance).get('Name', 'Unnamed')
                            results.append(restore(ec2, acct, iid, name, cycle))
        except Exception as exc:
            errors.append(f'{acct["name"]} ({acct["account_id"]}): {exc}')
            metric('AccountFailures')
            log.exception('RECONCILIATION_ACCOUNT_FAILED account=%s', acct['name'])
    send_restoration_report(results, cycle)
    if errors:
        notify(SNS_CAPACITY, '[EC2 Scheduler][RECONCILE][FAILED]',
               'Some accounts could not be reconciled:\n' + '\n'.join(errors), cycle)
    return {'examined': len(results), 'errors': len(errors)}


def lambda_handler(event, context):
    event = event or {}
    cycle = str(event.get('cycle_id') or uuid.uuid4().hex[:12])
    mode = event.get('mode') or ('recheck' if 'recheck' in event else 'status')
    log.info('STATUS_INVOKED mode=%s cycle=%s', mode, cycle)
    try:
        if mode == 'recheck':
            return run_recheck(event, cycle)
        if mode == 'reconcile':
            return run_reconcile(cycle)
        if mode == 'status':
            return run_status(event, cycle)
        raise ValueError(f'Unsupported status mode: {mode}')
    except Exception as exc:
        log.exception('STATUS_LAMBDA_FAILED mode=%s cycle=%s', mode, cycle)
        metric('StatusFailures')
        notify(SNS_CAPACITY, '[EC2 Scheduler][STATUS LAMBDA][FAILED]',
               f'Mode: {mode}\nError: {exc}\nCheck CloudWatch logs for cycle {cycle}.', cycle)
        raise
