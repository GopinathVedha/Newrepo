                html.append(f"""<div class="section">
  <h2>{html_escape(fs['name'])} / {html_escape(svm['name'])} / {html_escape(v['name'])} ({v['id']}) &mdash; Daily Detail</h2>
  <p class="note">Tiering policy: {v['tiering_policy']} &middot; Snapshot policy: {v['snapshot_policy']} &middot; Storage efficiency: {'Enabled' if v['storage_efficiency'] else 'Disabled'}
  {' &middot; <span class="badge warn">CloudWatch history unavailable - showing current snapshot only</span>' if not v['cw_has_data'] else ''}</p>
  <div class="table-scroll"><table id="{tbl_id}" class="striped">
    <tr><th>Date</th><th>Capacity</th><th>Used</th><th>Free</th><th>Util %</th><th>Snapshot Size</th></tr>
""")
                for row in v["daily"]:
                    cls, _ = util_class(row["util_pct"])
                    util_disp = f'<span class="pill-util {cls}">{row["util_pct"]:.1f}%</span>' if row["util_pct"] is not None else "N/A"
                    snap_disp = fmt_bytes(row["snapshot"]) if row["snapshot"] is not None else "N/A"
                    html.append(
                        f'<tr><td>{row["date"].isoformat()}</td><td>{fmt_bytes(row["capacity"])}</td>'
                        f'<td>{fmt_bytes(row["used"])}</td><td>{fmt_bytes(row["free"])}</td><td>{util_disp}</td><td class="text">{snap_disp}</td></tr>'
                    )
                html.append(f'</table></div><button class="csv-btn" onclick="tableToCSV(\'{tbl_id}\',\'fsx_{v["id"]}_daily.csv\')">Download CSV</button></div>')

    # Month-over-month comparison + 12-month trend, if history is available
    if history is not None and this_month_key and prev_month_key:
        resource_rows = [(v["id"], f'{v["fs_name"]} / {v["svm_name"]} / {v["name"]}') for v in all_volumes]
        metric_specs = [
            ("avg_used", "Avg Used Space", fmt_bytes),
            ("avg_free", "Avg Free Space", fmt_bytes),
            ("avg_util_pct", "Avg Utilization %", lambda v: f"{v:.1f}%"),
            ("avg_snapshot", "Avg Snapshot Size", fmt_bytes),
        ]
        html.append(f"""<div class="section">
  <h2>Month-over-Month Comparison</h2>
  <p class="note">This report's month ({html_escape(this_month_key)}) compared to the prior month ({html_escape(prev_month_key)}), per volume. Red/up means the value grew, green/down means it shrank - whether that's good or bad depends on the metric (growth in Used Space is expected; growth in Avg Utilization % toward capacity limits is a warning sign).</p>
  {render_month_over_month_table(history, resource_rows, metric_specs, this_month_key, prev_month_key, "fsx-mom-table")}
</div>
<div class="section">
  <h2>12-Month Trend</h2>
  <p class="note">One table per metric, one row per volume, one column per month. Builds up automatically each month this report runs - expect fewer columns until it has been running for a year.</p>
""")
        for field, label, fmt in metric_specs:
            html.append(f'<h3 style="font-size:13px; margin:18px 0 8px;">{html_escape(label)}</h3>')
            html.append(render_trend_table(history, resource_rows, field, label, fmt, f"fsx-trend-{field}"))
        html.append("</div>")

    html.append(f"""
<div class="footer">
  <span>FSx ONTAP Monthly Report &middot; auto-generated &middot; for audit / capacity-planning use</span>
  <span>Report period {start_date.isoformat()} to {end_date.isoformat()}</span>
</div>
</div>
<script>{CSV_EXPORT_JS}</script>
</body></html>""")

    return "".join(html)


# ---------------------------------------------------------------------------
# Handler
# ---------------------------------------------------------------------------

def lambda_handler(event, context):
    start_date, end_date = get_previous_month_range()
    generated_at = datetime.datetime.utcnow().strftime("%Y-%m-%d %H:%M UTC")

    data, excluded_root_count = build_report_data(start_date, end_date)

    # Rolling 12-month history: load, add this month's per-volume averages,
    # prune to 12 months, save. Stored under the same S3 prefix this
    # report already has write access to - no new IAM permission needed.
    history_key = "fsx-report/_history/fsx-history.json"
    history = load_history(s3, BUCKET, history_key)
    this_month_key = month_key(start_date)
    prev_month_key = previous_month_key(start_date)
    for fs in data:
        for svm in fs["svms"]:
            for v in svm["volumes"]:
                label = f'{fs["name"]} / {svm["name"]} / {v["name"]}'
                metrics = {
                    "avg_used": v["avg_used"],
                    "avg_free": v["avg_free"],
                    "avg_util_pct": v["avg_util"],
                    "avg_snapshot": v["avg_snapshot"],
                    "avg_capacity": v["avg_capacity"],
                    "growth_bytes": v["growth_bytes"],
                }
                update_history(history, v["id"], label, this_month_key, metrics)
    save_history(s3, BUCKET, history_key, history, kms_key_id=KMS_KEY_ID)

    html_report = render_html(
        data, start_date, end_date, generated_at, excluded_root_count,
        history=history, this_month_key=this_month_key, prev_month_key=prev_month_key,
    )

    key = f"fsx-report/{start_date.strftime('%Y')}/{start_date.strftime('%m')}/fsx-report-{start_date.strftime('%Y-%m')}.html"
    s3_uri = upload_html_to_s3(s3, BUCKET, key, html_report, kms_key_id=KMS_KEY_ID)

    url = generate_presigned_url(BUCKET, key, REGION, SIGNING_SECRET_ID)

    subject = f"FSx ONTAP Monthly Report - {start_date.strftime('%B %Y')}"
    message = (
        f"The FSx for NetApp ONTAP monthly capacity & performance report for "
        f"{start_date.strftime('%B %Y')} is ready.\n\n"
        f"Report link (valid 7 days):\n{url}\n\n"
        f"S3 location: {s3_uri}\n"
    )
    publish_sns(sns, TOPIC_ARN, subject, message)

    return {"statusCode": 200, "body": f"Report uploaded to {s3_uri} and notification sent."}
