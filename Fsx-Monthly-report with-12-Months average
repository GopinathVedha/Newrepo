def util_class(pct):
    """Return CSS class + badge tier for a utilization percentage."""
    if pct is None:
        return "", "n/a"
    if pct >= 90:
        return "bad", "bad"
    if pct >= 75:
        return "warn", "warn"
    return "ok", "ok"


def fmt_bytes(n, suffix="B"):
    if n is None:
        return "N/A"
    n = float(n)
    for unit in ["", "K", "M", "G", "T", "P"]:
        if abs(n) < 1024.0:
            return f"{n:3.1f} {unit}{suffix}"
        n /= 1024.0
    return f"{n:.1f} E{suffix}"


def html_escape(s):
    if s is None:
        return ""
    return (
        str(s)
        .replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace('"', "&quot;")
    )


# ---------------------------------------------------------------------------
# Rolling monthly history (month-over-month + 12-month trend)
#
# Stored as a single small JSON file in S3, in the SAME bucket/prefix the
# report already writes to (so no new IAM permissions are needed - the
# existing s3:PutObject/GetObject on "{report-type}-report/*" covers it).
# Structure:
#   {
#     "<resource_key>": {
#       "meta": {"label": "..."},
#       "months": {
#         "2026-06": {"avg_used": 123, "avg_util_pct": 45.6, ...},
#         "2026-07": {...}
#       }
#     },
#     ...
#   }
# Pruned to the last MAX_HISTORY_MONTHS entries per resource on every save.
# ---------------------------------------------------------------------------

MAX_HISTORY_MONTHS = 12


def month_key(d):
    return d.strftime("%Y-%m")


def previous_month_key(d):
    first_of_month = d.replace(day=1)
    prev_month_last_day = first_of_month - datetime.timedelta(days=1)
    return month_key(prev_month_last_day)


def load_history(s3_client, bucket, key):
    try:
        resp = s3_client.get_object(Bucket=bucket, Key=key)
        return json.loads(resp["Body"].read())
    except ClientError as e:
        if e.response.get("Error", {}).get("Code") in ("NoSuchKey", "404"):
            return {}
        print(f"History load failed for {key}: {e} - starting with empty history")
        return {}
    except Exception as e:
        print(f"History load failed for {key}: {e} - starting with empty history")
        return {}


def save_history(s3_client, bucket, key, history, kms_key_id=None):
    body = json.dumps(history, indent=2, default=str).encode("utf-8")
    put_kwargs = dict(Bucket=bucket, Key=key, Body=body, ContentType="application/json")
    if kms_key_id:
        put_kwargs["ServerSideEncryption"] = "aws:kms"
        put_kwargs["SSEKMSKeyId"] = kms_key_id
    else:
        put_kwargs["ServerSideEncryption"] = "AES256"
    s3_client.put_object(**put_kwargs)


def update_history(history, resource_key, label, this_month_key, metrics):
    """Adds/overwrites this month's metrics for one resource, then prunes
    that resource's month list down to MAX_HISTORY_MONTHS entries."""
    entry = history.setdefault(resource_key, {"meta": {}, "months": {}})
    entry["meta"]["label"] = label
    entry["months"][this_month_key] = metrics
    months_sorted = sorted(entry["months"].keys())
    if len(months_sorted) > MAX_HISTORY_MONTHS:
        for old in months_sorted[:-MAX_HISTORY_MONTHS]:
            del entry["months"][old]
    return history


def render_month_over_month_table(history, resource_rows, metric_specs,
                                   this_month_key, prev_month_key, table_id):
    """
    resource_rows: list of (resource_key, display_label) in desired row order
    metric_specs: list of (field_name, display_label, formatter_fn)
    Renders: Resource | Metric | <prev month> | <this month> | Change
    """
    rows_html = []
    for resource_key, display_label in resource_rows:
        months = history.get(resource_key, {}).get("months", {})
        prev = months.get(prev_month_key)
        curr = months.get(this_month_key)
        for field, metric_label, fmt in metric_specs:
            prev_val = prev.get(field) if prev else None
            curr_val = curr.get(field) if curr else None
            prev_disp = fmt(prev_val) if prev_val is not None else "N/A"
            curr_disp = fmt(curr_val) if curr_val is not None else "N/A"
            if prev_val is not None and curr_val is not None and isinstance(prev_val, (int, float)) and isinstance(curr_val, (int, float)):
                delta = curr_val - prev_val
                pct = (delta / prev_val * 100.0) if prev_val not in (0, None) else None
                arrow = "&#9650;" if delta > 0 else ("&#9660;" if delta < 0 else "&#8212;")
                color = "var(--bad)" if delta > 0 else ("var(--good)" if delta < 0 else "var(--ink-soft)")
                pct_str = f" ({pct:+.1f}%)" if pct is not None else ""
                change_disp = f'<span style="color:{color}">{arrow} {fmt(abs(delta))}{pct_str}</span>'
            else:
                change_disp = "N/A"
            rows_html.append(
                f'<tr><td class="text">{html_escape(display_label)}</td><td class="text">{html_escape(metric_label)}</td>'
                f'<td>{prev_disp}</td><td>{curr_disp}</td><td>{change_disp}</td></tr>'
            )

    return f"""<div class="table-scroll"><table id="{table_id}" class="striped">
    <tr><th>Resource</th><th>Metric</th><th>{html_escape(prev_month_key)}</th><th>{html_escape(this_month_key)} (this report)</th><th>Change</th></tr>
    {''.join(rows_html)}
    </table></div>
    <button class="csv-btn" onclick="tableToCSV('{table_id}','{table_id}.csv')">Download CSV</button>"""


def render_trend_table(history, resource_rows, field, metric_label, fmt, table_id, max_months=MAX_HISTORY_MONTHS):
    """
    One row per resource, one column per month (oldest to newest, up to
    max_months), for a single metric field. Produces one table per metric
    rather than one giant wide table with every metric interleaved, since
    that stays readable at up to 12 months x several metrics.
    """
    all_months = set()
    for resource_key, _ in resource_rows:
        all_months.update(history.get(resource_key, {}).get("months", {}).keys())
    months_sorted = sorted(all_months)[-max_months:]

    if not months_sorted:
        return '<p class="note">No history yet for this metric - it will start building from this month\'s run.</p>'

    header_cells = "".join(f"<th>{m}</th>" for m in months_sorted)
    rows_html = []
    for resource_key, display_label in resource_rows:
        months = history.get(resource_key, {}).get("months", {})
        cells = []
        for m in months_sorted:
            val = months.get(m, {}).get(field)
            cells.append(f"<td>{fmt(val) if val is not None else 'N/A'}</td>")
        rows_html.append(f'<tr><td class="text">{html_escape(display_label)}</td>{"".join(cells)}</tr>')

    return f"""<div class="table-scroll"><table id="{table_id}" class="striped">
    <tr><th>Resource</th>{header_cells}</tr>
    {''.join(rows_html)}
    </table></div>
    <button class="csv-btn" onclick="tableToCSV('{table_id}','{table_id}.csv')">Download CSV</button>
    <p class="note">{html_escape(metric_label)} - up to the last {max_months} months. History builds up over time; expect fewer columns until the report has run for a year.</p>"""

