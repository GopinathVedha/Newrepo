# --------------------------------------------------------------------------
# AWS helpers
# --------------------------------------------------------------------------
def assume_spoke_role(sts_client, account_id, role_name, external_id=None):
    """Assume the read-only inventory role in a spoke account and return a boto3 Session."""
    role_arn = f"arn:aws:iam::{account_id}:role/{role_name}"
    kwargs = {
        "RoleArn": role_arn,
        "RoleSessionName": "ec2-inventory-collector",
        "DurationSeconds": 3600,
    }
    if external_id:
        kwargs["ExternalId"] = external_id

    resp = sts_client.assume_role(**kwargs)
    creds = resp["Credentials"]
    return boto3.Session(
        aws_access_key_id=creds["AccessKeyId"],
        aws_secret_access_key=creds["SecretAccessKey"],
        aws_session_token=creds["SessionToken"],
    )


def get_regions_for_session(session, requested_regions):
    """Return the list of regions to scan. 'ALL' triggers dynamic discovery."""
    if len(requested_regions) == 1 and requested_regions[0].upper() == "ALL":
        ec2 = session.client("ec2", region_name="us-east-1",
                              config=Config(retries={"max_attempts": 5, "mode": "standard"}))
        resp = ec2.describe_regions(AllRegions=False)
        return sorted(r["RegionName"] for r in resp["Regions"])
    return requested_regions


def extract_name_tag(tags):
    if not tags:
        return ""
    for t in tags:
        if t.get("Key") == "Name":
            return t.get("Value", "")
    return ""


# Tag key holding the per-instance "Role" value shown right after Instance Name.
ROLE_TAG_KEY = "equip:server:role"


def extract_tag_value(tags, key):
    """Return the value of a specific tag key, or '-' if the instance doesn't have it."""
    if not tags:
        return "-"
    for t in tags:
        if t.get("Key") == key:
            val = t.get("Value", "")
            return val if val else "-"
    return "-"


def extract_ip_addresses(instance):
    """Collect ALL private + public IPs across ALL network interfaces into one
    comma-separated string, so multi-NIC / multi-IP instances stay on a single row."""
    ips = []

    # Primary addresses (covers single-NIC instances even if ENI list is sparse)
    if instance.get("PrivateIpAddress"):
        ips.append(instance["PrivateIpAddress"])
    if instance.get("PublicIpAddress"):
        ips.append(instance["PublicIpAddress"])

    # All ENIs / all secondary private+public IPs
    for eni in instance.get("NetworkInterfaces", []):
        for priv in eni.get("PrivateIpAddresses", []):
            addr = priv.get("PrivateIpAddress")
            if addr and addr not in ips:
                ips.append(addr)
            assoc = priv.get("Association", {})
            pub = assoc.get("PublicIp")
            if pub and pub not in ips:
                ips.append(pub)

    return ", ".join(ips) if ips else "-"


def extract_os(instance):
    """Best-effort OS detection: PlatformDetails is the most descriptive field
    boto3/EC2 provides (e.g. 'Windows', 'Linux/UNIX', 'Red Hat Enterprise Linux')."""
    platform_details = instance.get("PlatformDetails")
    if platform_details:
        return platform_details
    # Fallback for older API responses that only set 'Platform' = 'windows'
    if instance.get("Platform", "").lower() == "windows":
        return "Windows"
    return "Linux/UNIX"


def collect_instances_for_account(session, account_id, env_name, regions):
    rows = []
    for region in regions:
        try:
            ec2 = session.client("ec2", region_name=region,
                                  config=Config(retries={"max_attempts": 5, "mode": "standard"}))
            paginator = ec2.get_paginator("describe_instances")
            for page in paginator.paginate():
                for reservation in page.get("Reservations", []):
                    for inst in reservation.get("Instances", []):
                        rows.append({
                            "ENV": env_name,
                            "AccountId": account_id,
                            "InstanceName": extract_name_tag(inst.get("Tags")) or "-",
                            "Role": extract_tag_value(inst.get("Tags"), ROLE_TAG_KEY),
                            "InstanceId": inst.get("InstanceId", "-"),
                            "InstanceType": inst.get("InstanceType", "-"),
                            "IPAddress": extract_ip_addresses(inst),
                            "OS": extract_os(inst),
                            "Zone": inst.get("Placement", {}).get("AvailabilityZone", "-"),
                            "Status": inst.get("State", {}).get("Name", "-"),
                            "Region": region,
                        })
        except ClientError as e:
            log.warning("  [%s] region %s: %s", env_name, region, e.response["Error"]["Message"])
        except BotoCoreError as e:
            log.warning("  [%s] region %s: %s", env_name, region, e)
    return rows


def gather_all_accounts(regions, external_id=None, hub_session=None):
    hub_session = hub_session or boto3.Session()
    sts = hub_session.client("sts")

    all_rows = []
    for account_id, env_name in ACCOUNTS.items():
        log.info("Processing account %s (%s)...", account_id, env_name)
        try:
            spoke_session = assume_spoke_role(sts, account_id, SPOKE_ROLE_NAME, external_id)
        except (ClientError, BotoCoreError) as e:
            log.error("  Could not assume role in %s (%s): %s", account_id, env_name, e)
            continue

        target_regions = get_regions_for_session(spoke_session, regions)
        rows = collect_instances_for_account(spoke_session, account_id, env_name, target_regions)
        log.info("  Found %d instance(s) across %d region(s)", len(rows), len(target_regions))
        all_rows.extend(rows)

    return all_rows


