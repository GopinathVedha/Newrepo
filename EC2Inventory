def build_csv(rows):
    buf = io.StringIO()
    writer = csv.DictWriter(buf, fieldnames=[c[0] for c in COLUMNS])
    writer.writerow({c[0]: c[1] for c in COLUMNS})
    for r in rows:
        writer.writerow({c[0]: r.get(c[0], "") for c in COLUMNS})
    return buf.getvalue()


def upload_to_s3(bucket, html_content, csv_content, prefix="EC2Inventory"):
    now = datetime.now(timezone.utc)
    year, month, day = now.strftime("%Y"), now.strftime("%m"), now.strftime("%d")
    stamp = now.strftime("%H%M%S")

    key_prefix = f"{prefix}/{year}/{month}/{day}"
    html_key = f"{key_prefix}/ec2_inventory_{stamp}.html"
    csv_key = f"{key_prefix}/ec2_inventory_{stamp}.csv"

    s3 = boto3.client("s3")
    s3.put_object(Bucket=bucket, Key=html_key, Body=html_content.encode("utf-8"),
                   ContentType="text/html")
    s3.put_object(Bucket=bucket, Key=csv_key, Body=csv_content.encode("utf-8"),
                   ContentType="text/csv")

    log.info("Uploaded report to s3://%s/%s", bucket, html_key)
    log.info("Uploaded CSV to    s3://%s/%s", bucket, csv_key)
    return html_key, csv_key


# --------------------------------------------------------------------------
# Core runner - shared by both the CLI entry point and the Lambda handler
# --------------------------------------------------------------------------
def run_inventory(bucket=None, regions=None, external_id=None,
                   output_dir="/tmp", upload=True, write_local=True):
    """Gather inventory, build the report, optionally write it locally and
    upload it to S3. Returns a summary dict (used by lambda_handler for its
    response body, and printed/logged by the CLI)."""
    regions = regions or DEFAULT_REGIONS

    rows = gather_all_accounts(regions, external_id=external_id)

    generated_at = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
    html_content = build_html(rows, generated_at)
    csv_content = build_csv(rows)

    result = {
        "instance_count": len(rows),
        "accounts_processed": len(ACCOUNTS),
        "generated_at": generated_at,
        "local_html_path": None,
        "local_csv_path": None,
        "s3_html_key": None,
        "s3_csv_key": None,
        "bucket": bucket,
    }

    if write_local:
        # /tmp is the only writable filesystem inside AWS Lambda; it also
        # works fine for local/CLI runs.
        local_html = f"{output_dir.rstrip('/')}/ec2_inventory.html"
        local_csv = f"{output_dir.rstrip('/')}/ec2_inventory.csv"
        with open(local_html, "w", encoding="utf-8") as f:
            f.write(html_content)
        with open(local_csv, "w", encoding="utf-8") as f:
            f.write(csv_content)
        log.info("Wrote local report: %s", local_html)
        log.info("Wrote local csv:    %s", local_csv)
        result["local_html_path"] = local_html
        result["local_csv_path"] = local_csv

    if upload:
        if not bucket:
            raise ValueError("bucket is required when upload=True")
        html_key, csv_key = upload_to_s3(bucket, html_content, csv_content)
        result["s3_html_key"] = html_key
        result["s3_csv_key"] = csv_key

    log.info("Done. %d total instance(s) across %d account(s).", len(rows), len(ACCOUNTS))
    return result


# --------------------------------------------------------------------------
# AWS Lambda entry point
# --------------------------------------------------------------------------
def lambda_handler(event, context):
    """
    AWS Lambda handler. Configure via environment variables:
        BUCKET_NAME   - S3 bucket to upload the report to (required)
        REGIONS       - comma-separated region list, or "ALL" (optional)
        EXTERNAL_ID   - STS ExternalId for assuming spoke roles (optional)

    Or override any of these per-invocation via the event payload, e.g. an
    EventBridge Scheduler input transformer or a manual test event:
        {
          "bucket": "my-inventory-bucket",
          "regions": "us-east-1,ap-south-1",
          "external_id": "ec2-inventory-8f3a1c"
        }
    """
    event = event or {}

    bucket = event.get("bucket") or os.environ.get("BUCKET_NAME")
    if not bucket:
        raise ValueError(
            "No S3 bucket configured. Set the BUCKET_NAME environment variable "
            "or pass {'bucket': '...'} in the invocation event."
        )

    regions_raw = event.get("regions") or os.environ.get("REGIONS")
    regions = [r.strip() for r in regions_raw.split(",")] if regions_raw else DEFAULT_REGIONS

    external_id = event.get("external_id") or os.environ.get("EXTERNAL_ID") or EXTERNAL_ID

    # Lambda's filesystem is read-only except /tmp, and there's no reason to
    # persist a local copy in the execution environment anyway - S3 is the
    # durable output. write_local=True is harmless (helps for debugging via
    # CloudWatch-adjacent tooling) but can be turned off if you want the
    # fastest possible run.
    result = run_inventory(
        bucket=bucket,
        regions=regions,
        external_id=external_id,
        output_dir="/tmp",
        upload=True,
        write_local=True,
    )

    return {
        "statusCode": 200,
        "body": {
            "message": "EC2 inventory report generated successfully.",
            "instance_count": result["instance_count"],
            "accounts_processed": result["accounts_processed"],
            "generated_at": result["generated_at"],
            "s3_html": f"s3://{bucket}/{result['s3_html_key']}",
            "s3_csv": f"s3://{bucket}/{result['s3_csv_key']}",
        },
    }


# --------------------------------------------------------------------------
# CLI entry point
# --------------------------------------------------------------------------
def main():
    parser = argparse.ArgumentParser(description="Multi-account EC2 inventory report generator.")
    parser.add_argument("--bucket", help="S3 bucket to upload the report to (required unless --no-upload).")
    parser.add_argument("--regions", nargs="+", default=DEFAULT_REGIONS,
                         help="Regions to scan, or 'ALL' to auto-discover enabled regions per account.")
    parser.add_argument("--external-id", default=EXTERNAL_ID,
                         help="STS ExternalId to use when assuming spoke roles (optional).")
    parser.add_argument("--output-dir", default=".", help="Local directory to write the report to.")
    parser.add_argument("--no-upload", action="store_true", help="Skip S3 upload, write locally only.")
    args = parser.parse_args()

    if not args.no_upload and not args.bucket:
        parser.error("--bucket is required unless --no-upload is set")

    run_inventory(
        bucket=args.bucket,
        regions=args.regions,
        external_id=args.external_id,
        output_dir=args.output_dir,
        upload=not args.no_upload,
        write_local=True,
    )


if __name__ == "__main__":
    sys.exit(main())
