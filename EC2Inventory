def esc(v):
    return html.escape(str(v), quote=True)


def build_html(rows, generated_at):
    envs = sorted(set(r["ENV"] for r in rows)) if rows else list(ACCOUNTS.values())
    oses = sorted(set(r["OS"] for r in rows)) if rows else []

