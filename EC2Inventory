    os_options = "\n".join(f'<option value="{esc(o)}">{esc(o)}</option>' for o in oses)

    env_legend = "\n".join(
        f'<span class="legend-chip" style="background:{ENV_COLORS.get(e, DEFAULT_ENV_COLOR)}">{esc(e)}</span>'
        for e in ACCOUNTS.values()
    )

    header_cells = "\n".join(f"<th>{esc(label)}</th>" for _, label in COLUMNS)

    body_rows = []
    for r in rows:
        env_color = ENV_COLORS.get(r["ENV"], DEFAULT_ENV_COLOR)
        status_color = STATUS_COLORS.get(str(r["Status"]).lower(), "#616161")
        os_lower = str(r["OS"]).lower()
        os_class = "windows" if "windows" in os_lower else "linux"

        cells = f"""
        <td><span class="env-badge" style="background:{env_color}">{esc(r['ENV'])}</span></td>
        <td>{esc(r['AccountId'])}</td>
        <td>{esc(r['InstanceName'])}</td>
        <td>{esc(r.get('Role', '-'))}</td>
        <td class="mono">{esc(r['InstanceId'])}</td>
        <td>{esc(r['InstanceType'])}</td>
        <td class="mono ip-cell">{esc(r['IPAddress'])}</td>
        <td>{esc(r['OS'])}</td>
        <td>{esc(r['Zone'])}</td>
        <td><span class="status-badge" style="background:{status_color}">{esc(r['Status'])}</span></td>
        """
        body_rows.append(
            f'<tr data-env="{esc(r["ENV"])}" data-os="{esc(r["OS"])}" data-osclass="{os_class}">{cells}</tr>'
        )

    body_html = "\n".join(body_rows) if body_rows else (
        f'<tr><td colspan="{len(COLUMNS)}" class="no-data">No instances found.</td></tr>'
    )

