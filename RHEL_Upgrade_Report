def now_utc():
    return dt.datetime.now(UTC)


def fmt_time(d):
    return d.astimezone(UTC).strftime('%Y-%m-%d %H:%M UTC')


def iso_time(d):
    return d.astimezone(UTC).isoformat().replace('+00:00', 'Z')


def format_sydney_time(value):
    """Format an aware datetime in Australia/Sydney, showing AEDT/AEST and offset."""
    return value.astimezone(SYDNEY).strftime('%Y-%m-%d %H:%M:%S %Z (UTC%z)')


def iso_sydney_time(value):
    return value.astimezone(SYDNEY).isoformat(timespec='seconds')


def parse_time(value):
    """Parse an internally stored ISO-8601 UTC timestamp."""
    if not isinstance(value, str):
        raise ValueError('Stored timestamp must be an ISO-8601 UTC string')
    try:
        parsed = dt.datetime.fromisoformat(value.replace('Z', '+00:00'))
        if parsed.tzinfo is None or parsed.utcoffset() != dt.timedelta(0):
            raise ValueError()
        return parsed.astimezone(UTC)
    except (ValueError, TypeError):
        raise ValueError('Invalid stored UTC timestamp %r' % value)


def parse_sydney_time(value):
    """Return (UTC datetime, Sydney-aware datetime) for a Sydney wall-clock input.

    Accepts e.g. 2026-11-20T14:30:00 (timezone inferred as AEDT) or an explicit
    Sydney offset e.g. 2026-11-20T14:30:00+11:00. Rejects UTC/Z input, invalid
    offsets, nonexistent DST wall times, and ambiguous fall-back wall times.
    """
    if not isinstance(value, str) or not value.strip():
        raise ValueError('Upgrade completion time must be a Sydney local ISO-8601 timestamp')
    try:
        parsed = dt.datetime.fromisoformat(value.strip().replace('Z', '+00:00'))
    except (ValueError, TypeError):
        raise ValueError('Invalid Sydney time %r; example: 2026-11-20T14:30:00' % value)

    if parsed.tzinfo is not None:
        # An explicit offset is accepted only if it describes that same Sydney
        # wall-clock time on that date. A UTC Z suffix is therefore rejected.
        local = parsed.astimezone(SYDNEY)
        if local.replace(tzinfo=None) != parsed.replace(tzinfo=None):
            raise ValueError(
                'Timestamp %r is not expressed as Australia/Sydney local time. '
                'Use local time without Z, or the correct Sydney offset (+11:00 AEDT / +10:00 AEST).' % value)
        return local.astimezone(UTC), local

    # A naive value is a Sydney wall-clock time. Round-trip both fold values to
    # detect daylight-saving gaps and repeated times during the autumn transition.
    candidates = []
    for fold in (0, 1):
        candidate = parsed.replace(tzinfo=SYDNEY, fold=fold)
        round_trip = candidate.astimezone(UTC).astimezone(SYDNEY)
        if round_trip.replace(tzinfo=None) == parsed:
            if not any(existing.utcoffset() == candidate.utcoffset() for existing in candidates):
                candidates.append(candidate)
    if not candidates:
        raise ValueError(
            'Sydney local time %r does not exist because clocks move forward for daylight saving. '
            'Choose a valid local time.' % value)
    if len(candidates) > 1:
        raise ValueError(
            'Sydney local time %r is ambiguous because clocks move back from AEDT to AEST. '
            'Provide the correct explicit Sydney offset (+11:00 or +10:00).' % value)
    local = candidates[0]
    return local.astimezone(UTC), local


def ceil_period(x):
    ts = x.timestamp()
    return dt.datetime.fromtimestamp(math.ceil(ts / PERIOD) * PERIOD, UTC)


def floor_period(x):
    ts = x.timestamp()
    return dt.datetime.fromtimestamp(math.floor(ts / PERIOD) * PERIOD, UTC)


def clean_batch(value):
    if not isinstance(value, str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,79}', value):
        raise ValueError('batch_id must be 1-80 letters/digits, _, - or .; first character alphanumeric')
    return value


def unique_hosts(values):
    if not isinstance(values, list) or not values:
        raise ValueError('Run 1 requires a nonempty hostnames JSON array')
    if len(values) != len(set(values)):
        raise ValueError('hostnames contains duplicate values')
    limit = int(os.environ.get('MAX_HOSTS', '20'))
    if len(values) > limit:
        raise ValueError('Maximum %s hosts per batch; split into smaller batches' % limit)
    for host in values:
        if (not isinstance(host,str) or not host.strip() or len(host)>128
                or not re.fullmatch(r'[^*?\x00-\x1f\x7f]{1,128}',host)):
            raise ValueError('Invalid EC2 Name tag %r (1-128 visible characters; * and ? wildcards not allowed)' % host)
    return values


def setting(name, required=False, default=None):
    value = os.environ.get(name, default)
    if required and not value:
        raise ValueError('Missing Lambda environment variable: ' + name)
    return value


def s3_args(body, content_type):
    return {'Body': body, 'ContentType': content_type, 'ServerSideEncryption':'aws:kms',
            'SSEKMSKeyId': setting('KMS_KEY_ARN', True)}


def key_for(prefix, batch, filename):
    return '/'.join(p for p in (prefix.strip('/'), batch, filename) if p)


def s3_key_exists(s3, bucket, key):
    # A targeted ListObjects avoids relying on HeadObject's 403-vs-404 behavior
    # when s3:ListBucket permission is constrained by the bucket prefix.
    response=s3.list_objects_v2(Bucket=bucket,Prefix=key,MaxKeys=1)
    return any(obj.get('Key')==key for obj in response.get('Contents',[]))


def read_state(s3, bucket, prefix, batch, phase):
    key = key_for(prefix, batch, '.state/phase-%d.json' % phase)
    try:
        result = s3.get_object(Bucket=bucket, Key=key)
        return json.loads(result['Body'].read())
    except ClientError as e:
        code = e.response.get('Error',{}).get('Code')
        if code in ('NoSuchKey','404'):
            raise ValueError('Missing preceding Phase %d. Run phases in order for batch %s' % (phase,batch))
        raise


def write(s3, bucket, key, data, typ):
    payload = data.encode('utf-8') if isinstance(data,str) else data
    s3.put_object(Bucket=bucket, Key=key, **s3_args(payload, typ))
    LOG.info('Wrote S3 object s3://%s/%s', bucket, key)


def resolve_instances(ec2, hostnames):
    result = {}
    all_found = defaultdict(list)
    paginator = ec2.get_paginator('describe_instances')
    for page in paginator.paginate(Filters=[{'Name':'tag:Name','Values':hostnames}]):
        for r in page.get('Reservations',[]):
            for inst in r.get('Instances',[]):
                tags = {x['Key']:x['Value'] for x in inst.get('Tags',[])}
                name = tags.get('Name')
                if name in hostnames and inst.get('State',{}).get('Name') != 'terminated':
                    all_found[name].append(inst)
    for host in hostnames:
        matches = all_found.get(host,[])
        if len(matches) != 1:
            raise ValueError('Name tag %r must match exactly one non-terminated EC2 instance; found %d' % (host,len(matches)))
        inst = matches[0]
        if inst['State']['Name'] != 'running':
            raise ValueError('%s (%s) is %s, must be running for live OS checks' %
                             (host,inst['InstanceId'],inst['State']['Name']))
        result[host] = {'instance_id':inst['InstanceId'],
                        'instance_type':inst.get('InstanceType',''),
                        'state':inst['State']['Name'],
                        'availability_zone':inst.get('Placement',{}).get('AvailabilityZone','')}
    return result


def volume_map(ec2, instance_id):
    volumes=[]
    paginator=ec2.get_paginator('describe_volumes')
    for page in paginator.paginate(Filters=[{'Name':'attachment.instance-id','Values':[instance_id]}]):
        for vol in page.get('Volumes',[]):
            volumes.append({'volume_id':vol['VolumeId'], 'type':vol['VolumeType'],
                            'size_gib':vol.get('Size'), 'iops':vol.get('Iops'),
                            'throughput_mib_s':vol.get('Throughput')})
    return sorted(volumes, key=lambda v:v['volume_id'])


def query_os_snapshots(ssm, host_data, services_by_host, includes_by_host=None, excludes_by_host=None, tracked_by_host=None):
    includes_by_host=includes_by_host or {}
    excludes_by_host=excludes_by_host or {}
    tracked_by_host=tracked_by_host or {}
    commands={}
    outputs={}
    for host, info in host_data.items():
        svcs = list(dict.fromkeys(DEFAULT_SERVICES + services_by_host.get(host, [])))
        py=(SSM_PY.replace('__SERVICES__', repr(svcs))
                .replace('__INCLUDES__',repr(includes_by_host.get(host,[])))
                .replace('__EXCLUDES__',repr(excludes_by_host.get(host,[])))
                .replace('__TRACKED__',repr(tracked_by_host.get(host,[])))
                .replace('__MAX_DISCOVERED__',str(int(setting('MAX_DISCOVERED_SERVICES',default='80')))))
        shell = ("PYBIN=$(command -v python3 || true)\n"
                 "if [ -z \"$PYBIN\" ] && [ -x /usr/libexec/platform-python ]; then PYBIN=/usr/libexec/platform-python; fi\n"
                 "if [ -z \"$PYBIN\" ]; then echo 'Python interpreter missing' >&2; exit 3; fi\n"
                 "\"$PYBIN\" - <<'PY_RHEL_AUDIT'\n" + py + "\nPY_RHEL_AUDIT")
        try:
            res=ssm.send_command(InstanceIds=[info['instance_id']],
                                 DocumentName='AWS-RunShellScript',
                                 Comment='Read-only RHEL OS upgrade assessment',
                                 Parameters={'commands':[shell]},
                                 TimeoutSeconds=90)
            commands[host]=res['Command']['CommandId']
        except Exception as e:
            outputs[host]={'status':'SSM_SEND_FAILED','error':str(e)[:450], 'snapshot':None}
    deadline=time.monotonic()+min(240,max(10,int(setting('SSM_WAIT_SECONDS', default='100'))))
    pending=set(commands)
    while pending and time.monotonic()<deadline:
        for host in list(pending):
            try:
                res=ssm.get_command_invocation(CommandId=commands[host],
                                               InstanceId=host_data[host]['instance_id'])
            except ClientError as e:
                if e.response.get('Error',{}).get('Code')=='InvocationDoesNotExist':
                    continue
                outputs[host]={'status':'SSM_POLL_FAILED','error':str(e)[:450],'snapshot':None}
                pending.remove(host)
                continue
            st=res.get('Status','Unknown')
            if st in ('Pending','InProgress','Delayed','Cancelling'):
                continue
            pending.remove(host)
            raw=res.get('StandardOutputContent','')
            marker='RHEL_OS_REPORT_ZLIB='
            pos=raw.find(marker)
            if st=='Success' and pos>=0:
                try:
                    packed=base64.b64decode(raw[pos+len(marker):].splitlines()[0],validate=True)
                    inflater=zlib.decompressobj()
                    decoded=inflater.decompress(packed,400000)
                    if not inflater.eof or len(decoded)>390000:
                        raise ValueError('Compressed inventory exceeds safe limits or is incomplete')
                    outputs[host]={'status':'Success','snapshot':json.loads(decoded)}
                    continue
                except (ValueError,IndexError,zlib.error) as e:
                    err='Invalid/truncated compressed SSM snapshot: '+str(e)
            else:
                err=(res.get('StandardErrorContent') or 'No audit ZLIB JSON returned')[:450]
            outputs[host]={'status':st,'error':err,'snapshot':None}
        if pending: time.sleep(3)
    for host in pending:
        outputs[host]={'status':'SSM_TIMEOUT','error':'SSM Run Command did not complete before polling deadline',
                       'snapshot':None}
    return outputs


def list_agent_metrics(cw, namespace, instance_id):
    results=[]
    try:
        pages=cw.get_paginator('list_metrics').paginate(
            Namespace=namespace, Dimensions=[{'Name':'InstanceId','Value':instance_id}])
        for page in pages:
            for metric in page.get('Metrics',[]):
                d={x['Name']:x['Value'] for x in metric.get('Dimensions',[])}
                if d.get('InstanceId')==instance_id:
                    results.append({'name':metric['MetricName'],'dimensions':d})
                if len(results)>=3000:
                    return results
    except Exception as e:
        LOG.warning('CWAgent ListMetrics failed for %s: %s',instance_id,e)
    return results


def spec(namespace,name,label,unit,stat,convert,direction,dimensions,category='CloudWatch'):
    return {'namespace':namespace,'name':name,'label':label,'unit':unit,
            'stat':stat,'convert':convert,'direction':direction,
            'dimensions':dict(dimensions),'category':category}


def choose_agent(entries, name, preference=None):
    choices=[x for x in entries if x['name']==name]
    if not choices: return None
    def weight(x):
        d=x['dimensions']
        if preference=='cpu':
            # Do NOT choose one of the per-core series as the system-wide CPU.
            # 'cpu-total' is preferred over an InstanceId rollup and individual cores.
            if d.get('cpu')=='cpu-total': penalty=0
            elif 'cpu' not in d: penalty=40
            else: penalty=500
        else:
            penalty=0
        return penalty+len(d)
    return min(choices,key=weight)['dimensions']


def first_agent(discovered, aliases, preference=None):
    for name in aliases:
        dimensions=choose_agent(discovered,name,preference)
        if dimensions:
            return name, dimensions
    return None, None


def metric_specs(cw, iid, volumes, agent_ns):
    specs=[]
    for name,label,unit,stat,convert,direction in EC2_METRICS:
        specs.append(spec('AWS/EC2',name,label,unit,stat,convert,direction,
                          {'InstanceId':iid},'EC2'))
    discovered=list_agent_metrics(cw,agent_ns,iid)
    for aliases,label,unit,direction,convert in AGENT_SIMPLE:
        pref='cpu' if aliases[0].startswith('Cpu') else None
        name,dims=first_agent(discovered,aliases,pref)
        if name:
            specs.append(spec(agent_ns,name,label,unit,'Average',convert,
                              direction,dims,'Guest OS'))
    # Filesystem metrics MUST be the original path-specific series, not the
    # InstanceId-only rollup. Otherwise an entire set of mounts can be summed.
    for aliases,label,unit,direction,convert in AGENT_DISK:
        bypath={}
        for name in aliases:
            candidates=[e for e in discovered if e['name']==name]
            for e in candidates:
                d=e['dimensions']; path=d.get('path')
                if not path or d.get('fstype') in IGNORE_FSTYPES:continue
                if path not in bypath or len(d)<len(bypath[path][1]):
                    bypath[path]=(name,d)
            if bypath:break
        for path in sorted(bypath, key=lambda v:(v!='/','/'+v))[:35]:
            real_name,dims=bypath[path]
            specs.append(spec(agent_ns,real_name,label+': '+path,unit,
                              'Average',convert,direction,dims,'Guest OS'))
    for name,label,unit,stat,convert,direction in AGENT_DISKIO:
        devices={}
        for e in discovered:
            if e['name']!=name:continue
            d=e['dimensions'];dev=d.get('name') or d.get('device') or 'aggregate'
            if dev not in devices or len(d)<len(devices[dev]): devices[dev]=d
        for dev,dims in sorted(devices.items())[:12]:
            specs.append(spec(agent_ns,name,label+' ['+dev+']',unit,stat,convert,
                              direction,dims,'Guest disk I/O'))
    for aliases,label,unit,convert in AGENT_NET_BYTES:
        interfaces={}
        for name in aliases:
            for e in discovered:
                if e['name']!=name:continue
                d=e['dimensions'];nic=d.get('interface') or d.get('device') or 'aggregate'
                if nic not in interfaces or len(d)<len(interfaces[nic][1]):
                    interfaces[nic]=(name,d)
            if interfaces:break
        for nic,(real_name,dims) in sorted(interfaces.items())[:12]:
            specs.append(spec(agent_ns,real_name,label+' ['+nic+']',unit,
                              'Sum',convert,'neutral',dims,'Guest network'))
    for name,label,unit,direction in AGENT_NETWORK:
        devs={}
        for e in discovered:
            if e['name']!=name:continue
            d=e['dimensions'];nic=d.get('interface') or d.get('device') or 'aggregate'
            if nic not in devs or len(d)<len(devs[nic]):devs[nic]=d
        for nic,dims in sorted(devs.items())[:12]:
            specs.append(spec(agent_ns,name,label+' ['+nic+']',unit,
                              'Sum','identity',direction,dims,'Guest network'))
    for vol in volumes[:35]:
        for name,label,unit,stat,convert,direction in EBS_METRICS:
            specs.append(spec('AWS/EBS',name,label+' ['+vol['volume_id']+']',unit,
                              stat,convert,direction,{'VolumeId':vol['volume_id']},'EBS'))
    return specs, len(discovered)


def scale(value, convert):
    if convert=='to_mib': return value/(1024**2)
    if convert=='to_mib_second': return value/(1024**2)/PERIOD
    if convert=='to_gib': return value/(1024**3)
    if convert=='per_second': return value/PERIOD
    return value


def fetch_metrics(cw, specs, start, end):
    if start>=end:
        return {}, ['Measurement window has no completed hourly interval; invoke again after >=1 hour']
    raw={}
    warnings=[]
    for off in range(0,len(specs),50):
        subset=specs[off:off+50]
        queries=[]
        for i,one in enumerate(subset):
            queries.append({'Id':'m%d'%i,
                'MetricStat':{'Metric':{'Namespace':one['namespace'],
                                        'MetricName':one['name'],
                                        'Dimensions':[{'Name':k,'Value':v}
                                                      for k,v in sorted(one['dimensions'].items())]},
                              'Period':PERIOD,'Stat':one['stat']},
                'ReturnData':True})
        token=None
        data=defaultdict(dict)
        try:
            while True:
                kwargs={'MetricDataQueries':queries,'StartTime':start,'EndTime':end,
                        'ScanBy':'TimestampAscending', 'MaxDatapoints':100800}
                if token: kwargs['NextToken']=token
                response=cw.get_metric_data(**kwargs)
                for res in response.get('MetricDataResults',[]):
                    if res.get('StatusCode') in ('InternalError','Forbidden'):
                        warnings.append('CloudWatch returned '+res['StatusCode']+' for '+res['Id'])
                    for t,v in zip(res.get('Timestamps',[]),res.get('Values',[])):
                        if isinstance(v,(int,float)) and math.isfinite(v):
                            data[res['Id']][iso_time(t)]=float(v)
                token=response.get('NextToken')
                if not token: break
        except Exception as e:
            warnings.append('CloudWatch GetMetricData failed: '+str(e)[:350])
        for i,one in enumerate(subset):
            points=sorted([[t,v] for t,v in data.get('m%d'%i,{}).items()])
            raw[off+i]=points
    return raw, warnings


def percentile(vals,p):
    if not vals: return None
    nums=sorted(vals)
    position=(len(nums)-1)*p/100
    a=int(position);b=min(a+1,len(nums)-1)
    return nums[a]+(nums[b]-nums[a])*(position-a)


def summarize_points(points,unit,start,end):
    count=len(points)
    values=[float(x[1]) for x in points]
    expected=max(0,round((end-start).total_seconds()/PERIOD))
    return {'unit':unit,'mean':round(statistics.mean(values),4) if values else None,
            'min':round(min(values),4) if values else None,
            'max':round(max(values),4) if values else None,
            'p95':round(percentile(values,95),4) if values else None,
            'latest':round(values[-1],4) if values else None,
            'samples':count,'expected_samples':expected,
            'coverage_pct':round(100*count/expected,1) if expected else 0,
            'points':[[t,round(v,6)] for t,v in points]}


def complete_metrics(cw,iid,volumes,start,end,agent_ns):
    specs,discovered=metric_specs(cw,iid,volumes,agent_ns)
    raw,warnings=fetch_metrics(cw,specs,start,end)
    output=[]
    by_vol=defaultdict(dict)
    by_guest_disk=defaultdict(dict)
    for i,s in enumerate(specs):
        pts=raw.get(i,[])
        if s['category']=='EBS':
            vol=s['dimensions']['VolumeId']
            by_vol[vol][s['name']]=pts
        if s['category']=='Guest disk I/O':
            dev=s['dimensions'].get('name') or s['dimensions'].get('device') or 'aggregate'
            by_guest_disk[dev][s['name']]=pts
        if s['name'] in ('VolumeTotalReadTime','VolumeTotalWriteTime'):
            continue  # used to compute weighted operation latency, not a user-facing metric
        scaled=[[t,scale(v,s['convert'])] for t,v in pts]
        item={k:s[k] for k in ('name','label','unit','category','direction')}
        item['metric_key']=s['namespace']+'|'+s['name']+'|'+json.dumps(s['dimensions'],sort_keys=True)
        item.update(summarize_points(scaled,s['unit'],start,end))
        output.append(item)
    for device,d in by_guest_disk.items():
        for side in ('read','write'):
            ops_name='diskio_reads' if side=='read' else 'diskio_writes'
            tm_name='diskio_'+side+'_time'
            ops={t:v for t,v in d.get(ops_name,[])}
            times={t:v for t,v in d.get(tm_name,[])}
            latencies=[[t,times[t]/v] for t,v in sorted(ops.items()) if t in times and v>0]
            if not latencies:continue
            item={'name':'Guest'+side.title()+'Latency','label':'Guest '+side+' latency ['+device+']',
                  'unit':'ms/op','category':'Guest disk I/O','direction':'lower',
                  'metric_key':'DERIVED|Guest'+side.title()+'Latency|'+device}
            item.update(summarize_points(latencies,'ms/op',start,end))
            output.append(item)
    for vol,d in by_vol.items():
        for side in ('Read','Write'):
            ops={t:v for t,v in d.get('Volume'+side+'Ops',[])}
            durations={t:v for t,v in d.get('VolumeTotal'+side+'Time',[])}
            latencies=[[t, 1000*durations[t]/v] for t,v in sorted(ops.items())
                       if t in durations and v>0]
            if not latencies: continue
            item={'name':'EBS'+side+'Latency', 'label':'EBS '+side.lower()+' latency ['+vol+']',
                  'unit':'ms/op','category':'EBS','direction':'lower',
                  'metric_key':'DERIVED|EBS'+side+'Latency|'+vol}
            item.update(summarize_points(latencies,'ms/op',start,end))
            output.append(item)
    return output,warnings,discovered


def check(level, name, detail, group='OS'):
    return {'status':level,'check':name,'detail':str(detail),'group':group}


def expected_version(phase,server_type):
    return {1:'8.8', 2:'9.6'}[phase]


def non_os_byname(snap):
    return {x.get('name'):x for x in (snap or {}).get('non_os_services',[])
            if isinstance(x,dict) and x.get('name')}


def validate_non_os_services(snap, previous, baseline, phase):
    """Read-only status checks; a Phase-1 active service becomes a required baseline."""
    checks=[]
    inventory=(snap or {}).get('service_discovery',{})
    if not inventory:
        return [check('WARN','Non-default service discovery','Inventory unavailable','Non-OS Services')]
    errors=inventory.get('errors') or []
    if errors or inventory.get('truncated'):
        checks.append(check('WARN','Service inventory completeness',
            '; '.join(errors) or 'Discovery inventory was truncated','Non-OS Services'))
    else:
        checks.append(check('PASS','Automatic non-OS service discovery',
            '%d non-core services found; %d common RHEL services filtered out'%(
            len((snap or {}).get('non_os_services',[])),inventory.get('filtered_core_os',0)),
            'Non-OS Services'))
    current=non_os_byname(snap)
    if not current and not errors:
        checks.append(check('WARN','Non-OS service inventory empty',
           'No non-core running or enabled units found; verify service discovery is expected','Non-OS Services'))
    for name,svc in current.items():
        st=svc.get('active_state','unknown')
        if st=='failed':
            checks.append(check('FAIL','Non-OS service failed: '+name,
                    'systemd state=failed; unit package='+str(svc.get('rpm_package','')), 'Non-OS Services'))
        elif phase==1 and st!='active' and svc.get('enablement','').startswith('enabled') and svc.get('unit_type')!='oneshot':
            checks.append(check('WARN','Enabled non-OS service not running: '+name,
                    'systemd state='+st+'; confirm it is expected to run continuously','Non-OS Services'))
    if phase>1:
        base=non_os_byname(baseline)
        prior=non_os_byname(previous)
        for name,svc in sorted(base.items()):
            if svc.get('active_state')!='active' or svc.get('unit_type')=='oneshot':continue
            newest=current.get(name)
            status=newest.get('active_state','missing') if newest else 'missing'
            if status!='active':
                checks.append(check('FAIL','Baseline non-OS service stopped/missing: '+name,
                    'Phase 1=active; current='+status+'; verify before approving upgrade','Non-OS Services'))
            else:
                checks.append(check('PASS','Baseline non-OS service running: '+name,
                    'Active in Phase 1 and Phase '+str(phase),'Non-OS Services'))
            if newest and svc.get('enablement','').startswith('enabled') and not newest.get('enablement','').startswith('enabled'):
                checks.append(check('WARN','Non-OS service startup state changed: '+name,
                    'Phase 1='+svc.get('enablement','')+'; current='+newest.get('enablement',''), 'Non-OS Services'))
        # Newly appearing packages can be legitimate, but warrant review.
        added=sorted(set(current)-set(base))
        if added:
            checks.append(check('WARN','New non-OS services since Phase 1',
                   ', '.join(added[:20])+' (verify expected additions)','Non-OS Services'))
    return checks


def validate_host(host, record, previous, baseline):
    checks=[]
    p=record['phase']; snap=record.get('snapshot');prev=(previous or {}).get('snapshot')
    metrics=record.get('metrics',[])
    exp=expected_version(p,record['server_type'])
    if not snap:
        checks.append(check('FAIL','SSM OS snapshot',record.get('ssm_error','SSM snapshot unavailable')))
    else:
        checks.append(check('PASS','SSM OS snapshot','Collected via Systems Manager'))
        osinfo=snap.get('os_release',{})
        ver=osinfo.get('VERSION_ID','unknown')
        name=osinfo.get('ID','unknown')
        checks.append(check('PASS' if name=='rhel' and ver==exp else 'FAIL',
                            'Expected RHEL version','Detected %s %s; expected RHEL %s'%(name,ver,exp)))
        services=snap.get('services',{})
        checks.extend(validate_non_os_services(snap,prev,(baseline or {}).get('snapshot'),p))
        for svc in record.get('critical_services',[]):
            st=services.get(svc,'unknown')
            checks.append(check('PASS' if st=='active' else 'FAIL','Required service: '+svc,
                                'systemctl is-active: '+st))
        failed=snap.get('failed_units',[])
        checks.append(check('WARN' if failed else 'PASS','Failed systemd units',
                            '%d failed; %s'%(len(failed),'; '.join(failed[:3])) if failed else 'None'))
        ntp=snap.get('ntp_synchronized','')
        checks.append(check('PASS' if ntp=='yes' else 'WARN','NTP time synchronization',ntp or 'unknown'))
        fstab=snap.get('fstab_verification',{})
        checks.append(check('PASS' if fstab.get('rc')==0 else 'WARN','/etc/fstab verification',
                            fstab.get('out') or fstab.get('err') or 'No response'))
        mounts=snap.get('mounts',[])
        if not mounts:
            checks.append(check('FAIL','Filesystem inventory','No filesystem entries collected'))
        for mount in mounts:
            used=mount.get('used_pct')
            if used is None: continue
            if used>=95: st='FAIL'
            elif used>=85: st='WARN'
            else: st='PASS'
            checks.append(check(st,'Filesystem capacity: '+mount['mount'],'%.1f%% used, %.1f GiB free'%
                                (used,mount.get('free_bytes',0)/1024**3),'Storage'))
        for inode in snap.get('inodes',[]):
            pct=inode.get('inodes_used_pct',0)
            if pct>=95:severity='FAIL'
            elif pct>=85:severity='WARN'
            else:severity='PASS'
            checks.append(check(severity,'Filesystem inode utilization: '+inode['mount'],
                                '%.1f%% used, %s free inodes'%(pct,inode.get('inodes_free',0)),'Storage'))
        if previous:
            old_volumes={v['volume_id']:v for v in previous.get('volumes',[])}
            new_volumes={v['volume_id']:v for v in record.get('volumes',[])}
            for volume_id in sorted(set(old_volumes)-set(new_volumes)):
                checks.append(check('WARN','Previously attached EBS volume missing: '+volume_id,
                                    'Check whether storage was intentionally detached','Storage'))
            for volume_id in sorted(set(new_volumes)-set(old_volumes)):
                checks.append(check('WARN','New EBS volume attached: '+volume_id,
                                    'Check whether the new volume is expected','Storage'))
        if prev:
            old_mounts={m['mount']:m for m in prev.get('mounts',[])}
            new_mounts={m['mount']:m for m in mounts}
            for mount,old in old_mounts.items():
                if mount not in new_mounts:
                    checks.append(check('FAIL','Previously mounted filesystem: '+mount,
                                        'Missing in current snapshot','Storage'))
                elif old.get('fstype')!=new_mounts[mount].get('fstype'):
                    checks.append(check('WARN','Filesystem type changed: '+mount,
                                        '%s -> %s'%(old.get('fstype'),new_mounts[mount].get('fstype')),'Storage'))
            if snap.get('selinux')!=prev.get('selinux'):
                checks.append(check('WARN','SELinux mode change','%s -> %s'%
                                    (prev.get('selinux'),snap.get('selinux')),'Security'))
            else:
                checks.append(check('PASS','SELinux mode unchanged',snap.get('selinux','unknown'),'Security'))
            if snap.get('firewalld')!=prev.get('firewalld'):
                checks.append(check('WARN','firewalld service state changed',
                                    '%s -> %s'%(prev.get('firewalld'),snap.get('firewalld')),'Security'))
            for svc,prior in prev.get('services',{}).items():
                latest=services.get(svc,'unknown')
                if prior=='active' and latest!='active' and svc not in record.get('critical_services',[]):
                    checks.append(check('WARN','Previously active service stopped: '+svc,
                                        '%s -> %s'%(prior,latest),'OS'))
            if snap.get('dns_resolvers')!=prev.get('dns_resolvers'):
                checks.append(check('WARN','DNS resolver configuration changed',
                                    'Compare /etc/resolv.conf and resolver reachability','Network'))
            if bool(snap.get('default_route_v4'))!=bool(prev.get('default_route_v4')):
                checks.append(check('WARN','IPv4 default route presence changed',
                                    'Review network routing','Network'))
        interfaces=snap.get('network_interfaces',[])
        for nic in interfaces:
            errs=sum(nic.get(f,0) for f in ('rx_errors','rx_drops','tx_errors','tx_drops'))
            checks.append(check('WARN' if errs else 'PASS','NIC errors/drops since reboot: '+nic['interface'],
                                'RX errors=%s, RX drops=%s, TX errors=%s, TX drops=%s (boot-reset counters)'%
                                (nic['rx_errors'],nic['rx_drops'],nic['tx_errors'],nic['tx_drops']),'Network'))
        if snap.get('kernel_error_examples'):
            checks.append(check('WARN','Kernel boot errors','Kernel error-level messages exist; inspect excerpts','Logs'))
        else:
            checks.append(check('PASS','Kernel boot errors','No error-level messages found in sampled boot log','Logs'))
        if snap.get('journal_error_examples'):
            checks.append(check('WARN','System journal errors','Error-level messages exist; inspect excerpts','Logs'))
        else:
            checks.append(check('PASS','System journal errors','No error-level messages found in sampled boot log','Logs'))
    index={m['name']:m for m in metrics if m.get('category')=='EC2'}
    for name in ('StatusCheckFailed','StatusCheckFailed_Instance','StatusCheckFailed_System'):
        m=index.get(name)
        if m and m['max'] is not None:
            checks.append(check('FAIL' if m['max']>0 else 'PASS',m['label'],
                                'Maximum hourly check failure flag: '+str(m['max']),'CloudWatch'))
    mandatory=[
        (('CPUUtilization',), 'EC2 CPU utilization'),
        (('MemUsedPercent','mem_used_percent'), 'CWAgent memory used'),
        (('SwapUsedPercent','swap_used_percent'), 'CWAgent swap usage'),
        (('DiskUsedPercent','disk_used_percent'), 'CWAgent filesystem used'),
        (('CpuIOWaitPercent','cpu_usage_iowait'), 'CWAgent CPU I/O wait'),
        (('diskio_reads',), 'CWAgent guest disk reads'),
        (('diskio_writes',), 'CWAgent guest disk writes'),
        (('NetBytesIn','net_bytes_recv'), 'CWAgent guest network received'),
        (('NetBytesOut','net_bytes_sent'), 'CWAgent guest network sent'),
        (('net_drop_in',), 'CWAgent inbound network drops'),
        (('net_drop_out',), 'CWAgent outbound network drops'),
    ]
    for aliases,label in mandatory:
        matches=[m for m in metrics if m['name'] in aliases]
        if not matches or not any(m['samples']>0 for m in matches):
            checks.append(check('WARN','Historical metric missing: '+label,
                                'No hourly points for configured metric '+aliases[0]+
                                '; check CWAgent dimensions and data collection','CloudWatch'))
    if record['window']['hours']<1:
        checks.append(check('WARN','Collection interval',
                            'No completed hour of metrics is available; HTML is diagnostic only','CloudWatch'))
    elif p>1 and record['window']['hours']<24:
        checks.append(check('WARN','Post-upgrade observation window',
                            '%d completed hours since upgrade; use >=24 h, ideally 5-7 days of normal workload'%record['window']['hours'],
                            'Performance'))
    for m in metrics:
        if m['samples']==0: continue
        if m['coverage_pct']<75:
            checks.append(check('WARN','Metric coverage: '+m['label'],
                                '%.1f%% of completed hourly periods have data'%m['coverage_pct'],'CloudWatch'))
        if m['name'] in ('net_drop_in','net_drop_out','net_err_in','net_err_out') and m['mean'] is not None and m['mean']>0:
            checks.append(check('WARN','Historical network errors/drops: '+m['label'],
                                'Average %.2f errors/drops per hour'%m['mean'],'Network'))
        if m['name'] in ('MemUsedPercent','mem_used_percent') and m['mean'] is not None and m['mean']>=90:
            checks.append(check('WARN','High average memory utilization','%.1f%%'%m['mean'],'Performance'))
        if m['name']=='CPUUtilization' and m['mean'] is not None and m['mean']>=85:
            checks.append(check('WARN','High average CPU utilization','%.1f%%'%m['mean'],'Performance'))
    if previous and p>1:
        old_metrics={m['metric_key']:m for m in previous.get('metrics',[])}
        compared=0
        for m in metrics:
            old=old_metrics.get(m['metric_key'])
            if old and old.get('mean') is not None and m.get('mean') is not None:
                compared+=1
        if compared==0:
            checks.append(check('WARN','Pre/post comparison coverage',
                                'No common metric with datapoints across preceding phase and this phase',
                                'Performance'))
    if baseline and p==3:
        b_metrics={m['metric_key']:m for m in baseline.get('metrics',[])}
        for m in metrics:
            ref=b_metrics.get(m['metric_key'])
            if not ref or ref.get('mean') is None or m.get('mean') is None: continue
            before=ref['mean']; after=m['mean']
            if before<=0 or m.get('direction')=='neutral': continue
            delta=(after-before)/abs(before)*100
            unfavorable=delta if m['direction']=='lower' else -delta
            limit=10 if m['name'] in ('MemUsedPercent','mem_used_percent') else 15 if m['name']=='CPUUtilization' else 20
            if unfavorable>limit:
                checks.append(check('WARN','Performance change: '+m['label'],
                                    '%+.1f%% relative to Phase 1 (threshold %.0f%%; workload must match)'%
                                    (delta,limit),'Performance'))
    return checks


def status_of(checks):
    return 'FAIL' if any(c['status']=='FAIL' for c in checks) else ('WARN' if any(c['status']=='WARN' for c in checks) else 'PASS')


def esc(v):
    return html.escape(str(v if v is not None else '—'),quote=True)


def num(x, places=2):
    if x is None:return '—'
    return '{:,.{}f}'.format(x,places)


def sparkline(points):
    if len(points)<2:return '<span class="muted">—</span>'
    values=[v for _,v in points]
    vmin=min(values);vmax=max(values);rng=vmax-vmin or 1.0
    picked=points[::max(1,len(points)//64)]
    last=points[-1]
    if picked[-1]!=last:picked.append(last)
    coords=['%.1f,%.1f'%(i*110/max(1,len(picked)-1),27-(v-vmin)/rng*24)
            for i,(_,v) in enumerate(picked)]
    return '<svg aria-label="Metric trend" viewBox="0 0 112 30" width="112" height="30"><polyline fill="none" stroke="#2563eb" stroke-width="1.7" points="%s"/></svg>'%(' '.join(coords))


def table(headers,rows):
    return '<div class="table-wrap"><table><thead><tr>'+''.join('<th>'+esc(x)+'</th>' for x in headers)+\
           '</tr></thead><tbody>'+''.join('<tr>'+''.join('<td>'+cell+'</td>' for cell in row)+'</tr>' for row in rows)+\
           '</tbody></table></div>'


def badge(value):
    v=value if value in ('PASS','WARN','FAIL') else 'WARN'
    return '<span class="badge %s">%s</span>'%(v.lower(),esc(value))


