    body+='<h3>Before/after outcome by instance</h3>'+table(
        ['Hostname','Instance ID','Role','Before (RHEL 8.8)','After (RHEL 9.6)','Overall','FAIL checks','WARN checks'],perhost)
    body+='<p class="warning"><strong>Interpretation:</strong> The baseline window is the 15 days before Phase 1. The post-upgrade window starts at the declared per-host final-upgrade completion time and ends when Phase 2 runs. Windows and workloads may differ. Trends are evidence for investigation, not automatic proof that the OS caused a change. No application/database performance validation is included.</p></div>'

    for host in all_hosts:
        h=[baseline['hosts'][host],after['hosts'][host]]
        title_status=status_of([c for r in h for c in r['checks']])
        body+='<section class="card"><h2>'+esc(host)+' '+badge(title_status)+'</h2>'
        body+='<p class="muted">'+esc(h[0]['instance_id'])+' | '+esc(h[0]['server_type'].upper())+' | Metric comparison uses hourly means, not matched workload.</p>'
        if h[1].get('upgrade_completed_at_sydney'):
            try:
                local_start=parse_sydney_time(h[1]['upgrade_completed_at_sydney'])[0]
                body+='<p><strong>Final RHEL 9.6 upgrade completion:</strong> '+esc(format_sydney_time(local_start))+' | UTC '+esc(iso_time(local_start))+'</p>'
            except Exception:
                body+='<p><strong>Final upgrade completion (Sydney input):</strong> '+esc(h[1].get('upgrade_completed_at_sydney'))+'</p>'
        metric_maps=[]
        metric_keys=[]
        for rec in h:
            d={m['metric_key']:m for m in rec['metrics']};metric_maps.append(d);metric_keys.extend(d)
        metric_rows=[]
        for key in dict.fromkeys(metric_keys):
            m1=metric_maps[0].get(key);m2=metric_maps[1].get(key)
            m=m1 or m2
            before=m1.get('mean') if m1 else None
            post=m2.get('mean') if m2 else None
            change=phase_metric_diff(m1,m2)
            metric_rows.append([esc(m['category']),esc(m['label']),esc(m['unit']),
                                esc(num(before)),esc(num(post)),
                                esc(('%+.1f%%'%change) if change is not None else '—'),
                                esc(m1.get('coverage_pct') if m1 else '—'),
                                esc(m2.get('coverage_pct') if m2 else '—')])
            exports['comparison'].append({'hostname':host,'instance_id':h[0]['instance_id'],
                'server_type':h[0]['server_type'],'category':m['category'],'metric':m['label'],'unit':m['unit'],
                'before_rhel_8_8_mean':before,'after_rhel_9_6_mean':post,
                'change_pct':change,
                'before_coverage_pct':m1.get('coverage_pct') if m1 else None,
                'after_coverage_pct':m2.get('coverage_pct') if m2 else None})
        body+='<h3>OS performance metrics: before vs after</h3>'+table(
            ['Area','Metric','Unit','Before average','After average','Change','Before coverage %','After coverage %'],metric_rows)

        osrows=[]
        for label,fn in [
           ('OS version',lambda s:s.get('os_release',{}).get('PRETTY_NAME')),
           ('Kernel version',lambda s:s.get('kernel')),
           ('Uptime hours',lambda s:round(s['uptime_seconds']/3600,1) if s.get('uptime_seconds') is not None else None),
           ('CPU cores',lambda s:s.get('cpu_count')),
           ('Load 1/5/15',lambda s:s.get('load_1_5_15')),
           ('Memory available GiB',lambda s:round(s.get('memory',{}).get('MemAvailable_KiB',0)/1024**2,2)),
           ('SELinux',lambda s:s.get('selinux')),
           ('firewalld',lambda s:s.get('firewalld')),
           ('SSSD status',lambda s:s.get('sssd')),
           ('crond status',lambda s:s.get('crond')),
           ('DNS resolvers',lambda s:s.get('dns_resolvers')),
           ('Package versions',lambda s:s.get('packages')),
           ('NTP synchronized',lambda s:s.get('ntp_synchronized')),
           ('Failed units',lambda s:len(s.get('failed_units',[]))),
           ('Mounted filesystems',lambda s:len(s.get('mounts',[]))),
           ('Filesystem inode inventories',lambda s:len(s.get('inodes',[]))),
           ('Boot duration',lambda s:s.get('boot_duration')),
           ('SSM Agent',lambda s:s.get('services',{}).get('amazon-ssm-agent')),
           ('CW Agent',lambda s:s.get('services',{}).get('amazon-cloudwatch-agent')),
           ('fstab verify status',lambda s:s.get('fstab_verification',{}).get('rc')),
           ('IPv4 default route',lambda s:'present' if s.get('default_route_v4') else 'absent')]:
            osrows.append([esc(label)]+[esc(fn(r['snapshot'])) if r.get('snapshot') else 'not captured' for r in h])
        body+='<h3>Full OS health comparison</h3>'+table(['OS validation item','Before upgrade','After RHEL 9.6'],osrows)

        service_maps=[non_os_byname((r.get('snapshot') or {})) for r in h]
        all_svc=sorted(set().union(*[set(m) for m in service_maps]))
        if all_svc:
            svcrows=[]
            for svc in all_svc:
                row=[esc(svc)]
                for d in service_maps:
                    obj=d.get(svc)
                    row.append(esc((obj.get('active_state','unknown')+' / '+obj.get('enablement','unknown')) if obj else 'missing'))
                svcrows.append(row)
            body+='<h3>Non-default services: before vs after</h3>'+table(
                 ['Service','Before state/startup','After state/startup'],svcrows)
        else:
            body+='<p>No non-core services present in the collected snapshots.</p>'

        for phase_num,rec in ((1,h[0]),(2,h[1])):
            checkrows=[[badge(c['status']),esc(c['group']),esc(c['check']),esc(c['detail'])]
                       for c in rec['checks']]
            body+='<details><summary>Phase %d (%s): %s checks, collection notes, and audit details</summary>'%(
                phase_num,'before upgrade' if phase_num==1 else 'after RHEL 9.6',len(rec['checks']))
            if rec.get('warnings'):body+='<p>'+esc('; '.join(rec['warnings']))+'</p>'
            body+=table(['Result','Area','Check','Evidence'],checkrows)
            body+='<details><summary>OS evidence from Phase %d</summary>'%phase_num+host_snapshot_html(rec.get('snapshot'))+'</details></details>'
        body+='</section>'
    return html_layout(title,subtitle,body,exports)


def calculate_prior_changes(record, previous):
    if not previous:return []
    old_by_key={m['metric_key']:m for m in previous.get('metrics',[])}
    rows=[]
    for new in record.get('metrics',[]):
        old=old_by_key.get(new['metric_key'])
        if not old:continue
        before=old.get('mean');after=new.get('mean')
        if before is None or after is None:continue
        change=(after-before)/abs(before)*100 if before!=0 else None
        direction=new.get('direction')
        unfavorable=(change if direction=='lower' else -change) if change is not None else None
        lim=10 if new['name'] in ('MemUsedPercent','mem_used_percent') else 15 if new['name']=='CPUUtilization' else 20
        severity='WARN' if direction!='neutral' and unfavorable is not None and unfavorable>lim else 'PASS'
        rows.append({'metric':new['label'],'unit':new['unit'],'before':before,
                     'after':after,'change_pct':round(change,2) if change is not None else None,
                     'status':severity})
    return rows


def phase_diagnostic(state, report_key, state_key):
    data={'tool_version':VERSION,'batch_id':state['batch_id'],'phase':state['phase'],
          'account_id':state['account_id'],'region':state['region'],
          'generated_at_utc':state['generated_at_utc'],
          'execution_status':'COMPLETED_WITH_FINDINGS',
          'html_s3_key':report_key,'state_s3_key':state_key,
          'host_statuses':{},'hosts':{},'summary':{'pass':0,'warn':0,'fail':0}}
    for host,rec in state['hosts'].items():
        checks=rec['checks'];status=status_of(checks)
        data['summary'][status.lower()]+=1
        data['host_statuses'][host]=status
        guest=[m for m in rec['metrics'] if m['category'] in ('Guest OS','Guest network','Guest disk I/O')]
        data['hosts'][host]={
            'instance_id':rec['instance_id'],'type':rec['server_type'],
            'os_detected':(rec.get('snapshot') or {}).get('os_release',{}).get('VERSION_ID'),
            'os_expected':expected_version(state['phase'],rec['server_type']),
            'ssm_status':rec['ssm_status'], 'metric_window_utc':rec['window'],
            'upgrade_completed_at_sydney':rec.get('upgrade_completed_at_sydney'),
            'upgrade_completed_at_utc':rec.get('upgrade_completed_at_utc'),
            'agent_metrics_discovered':rec.get('agent_metric_count',0),
            'guest_metrics_with_data':sum(1 for m in guest if m['samples']>0),
            'cw_metrics_with_data':sum(1 for m in rec['metrics'] if m['samples']>0),
            'critical_findings':[c for c in checks if c['status'] in ('WARN','FAIL')],
            'discovered_non_os_services':[(x.get('name'),x.get('active_state')) for x in (rec.get('snapshot') or {}).get('non_os_services',[])],
            'non_os_service_findings':[c for c in checks if c['group']=='Non-OS Services' and c['status'] in ('WARN','FAIL')],
            'service_discovery':(rec.get('snapshot') or {}).get('service_discovery',{}),
            'collection_warnings':rec.get('warnings',[]),
            'prior_stage_changes_flagged':[x for x in rec.get('prior_comparison',[]) if x['status']=='WARN'],
        }
    if data['summary']['fail']:data['execution_status']='COMPLETED_WITH_FAILURES'
    elif data['summary']['warn']:data['execution_status']='COMPLETED_WITH_WARNINGS'
    else:data['execution_status']='COMPLETED_PASS'
    return data


def has_state(s3,bucket,prefix,batch,phase):
    return s3_key_exists(s3,bucket,key_for(prefix,batch,'.state/phase-%d.json'%phase))


def _run_phase(event, context):
    """Run Phase 1 baseline or Phase 2 final RHEL 9.6 post-upgrade report."""
    if not isinstance(event,dict):raise ValueError('Lambda test event must be a JSON object')
    bucket=setting('REPORT_BUCKET',True)
    prefix=setting('REPORT_PREFIX',default='rhel-upgrade-reports').strip('/')
    setting('KMS_KEY_ARN',True)
    agent_ns=setting('CW_AGENT_NAMESPACE',default='CWAgent')
    batch=clean_batch(event.get('batch_id'))
    try:phase=int(event.get('phase'))
    except (TypeError,ValueError):raise ValueError('phase must be 1 or 2')
    if phase not in (1,2):raise ValueError('Only phase 1 (before) and phase 2 (after RHEL 9.6) are supported')
    baseline_days=int(event.get('baseline_days',setting('BASELINE_DAYS',default='15')))
    if baseline_days<1 or baseline_days>30:raise ValueError('baseline_days must be 1-30')
    session=boto3.session.Session()
    region=session.region_name
    if not region:raise ValueError('Lambda region cannot be determined')
    s3=session.client('s3');ec2=session.client('ec2');ssm=session.client('ssm');cw=session.client('cloudwatch')
    sts=session.client('sts')
    account=sts.get_caller_identity()['Account']
    before={};state1=None;prior_state=None
    if phase==1:
        hostnames=unique_hosts(event.get('hostnames'))
        kinds=event.get('server_types',{})
        if set(kinds)!=set(hostnames) or any(str(x).lower() not in ('app','db') for x in kinds.values()):
            raise ValueError('Phase 1 requires server_types mapping for every exact hostname: app or db')
        types={h:str(kinds[h]).lower() for h in hostnames}
        svcs=event.get('critical_services_by_host',{})
        if not isinstance(svcs,dict):raise ValueError('critical_services_by_host must be a JSON object')
        checked_services={}
        for host in hostnames:
            extra=svcs.get(host,[])
            if not isinstance(extra,list) or any(not isinstance(x,str) or not re.fullmatch(r'[A-Za-z0-9@_.-]{1,100}',x) for x in extra):
                raise ValueError('Invalid critical_services_by_host for %s'%host)
            checked_services[host]=list(dict.fromkeys(['sshd','chronyd']+extra))
        service_exclusions={};service_inclusions={}
        for field,target in [('service_exclusions_by_host',service_exclusions),('service_inclusions_by_host',service_inclusions)]:
            values=event.get(field,{})
            if not isinstance(values,dict) or any(h not in hostnames for h in values):
                raise ValueError(field+' must map only the provided hostnames to service name lists')
            for h in hostnames:
                arr=values.get(h,[])
                if not isinstance(arr,list) or any(not isinstance(x,str) or not re.fullmatch(r'[A-Za-z0-9@_.-]{1,100}',x) for x in arr):
                    raise ValueError('Invalid '+field+' for '+h)
                target[h]=list(dict.fromkeys(x if x.endswith('.service') else x+'.service' for x in arr))
        # Do not silently overwrite historical comparison evidence.
        phase1_key=key_for(prefix,batch,'.state/phase-1.json')
        if s3_key_exists(s3,bucket,phase1_key):
            if event.get('replace_existing') is not True:
                raise ValueError('Phase 1 already exists for %s. Use a NEW batch_id or set replace_existing=true deliberately'%batch)
            phase2_key=key_for(prefix,batch,'.state/phase-2.json')
            if s3_key_exists(s3,bucket,phase2_key):
                raise ValueError('Cannot replace Phase 1 because Phase 2 exists. Use a NEW batch_id')
    else:
        state1=read_state(s3,bucket,prefix,batch,1)
        if state1.get('schema_version') not in (2,3):
            raise ValueError('This batch does not contain a compatible V3/V4 Phase 1 baseline. Run Phase 1 before upgrading, using this code or the supported V3 baseline format.')
        if state1.get('region')!=region or state1.get('account_id')!=account:
            raise ValueError('Phase 1 belongs to another AWS account or region')
        hostnames=list(state1['hosts'])
        if event.get('hostnames') is not None and set(unique_hosts(event['hostnames']))!=set(hostnames):
            raise ValueError('Hostnames differ from Phase 1; use the same batch_id and hostnames')
        types={h:state1['hosts'][h]['server_type'] for h in hostnames}
        checked_services={h:state1['hosts'][h]['critical_services'] for h in hostnames}
        service_exclusions={h:state1['hosts'][h].get('service_exclusions',[]) for h in hostnames}
        service_inclusions={h:state1['hosts'][h].get('service_inclusions',[]) for h in hostnames}
        if has_state(s3,bucket,prefix,batch,2) and event.get('replace_existing') is not True:
            raise ValueError('Phase 2 already exists for batch %s; set replace_existing=true only to intentionally refresh this phase'%batch)
        prior_state=state1
        before=state1['hosts']
        if set(before)!=set(hostnames):raise ValueError('Saved Phase 1 hostnames do not match')
        # Re-render the baseline HTML with the current template so CSV export
        # controls are present even when the saved Phase 1 state was produced by V3.
        baseline_report_key=key_for(prefix,batch,'phase-1.html')
        write(s3,bucket,baseline_report_key,phase_html(state1),'text/html; charset=utf-8')

    start_by_host={};start_sydney_by_host={}
    if phase==2:
        times=event.get('upgrade_completed_at_sydney')
        if not isinstance(times,dict) or set(times)!=set(hostnames):
            raise ValueError('Phase 2 requires upgrade_completed_at_sydney mapping for every hostname, using Sydney local time')
        for host in hostnames:
            utc_value,local_value=parse_sydney_time(times[host])
            start_by_host[host]=utc_value
            start_sydney_by_host[host]=iso_sydney_time(local_value)

    host_data=resolve_instances(ec2,hostnames)
    if phase==2:
        for h in hostnames:
            if host_data[h]['instance_id']!=state1['hosts'][h]['instance_id']:
                raise ValueError('%s Name tag now resolves to a different EC2 instance ID'%h)
    t=now_utc()
    for host,start in start_by_host.items():
        if start>=t:raise ValueError('%s upgrade completion timestamp is in the future'%host)
        preceding_report_time=parse_time(prior_state['generated_at_utc'])
        if start<=preceding_report_time:
            raise ValueError('%s upgrade completion must occur AFTER the Phase 1 baseline report was generated'%host)
        if (t-start).days>455:
            raise ValueError('%s upgrade completion is beyond 455-day hourly CloudWatch retention'%host)

    LOG.info('Starting RHEL OS report batch=%s phase=%d region=%s hosts=%s',batch,phase,region,hostnames)
    tracked_by_host={}
    if phase==2:
        for h in hostnames:
            tracked_by_host[h]=sorted({svc.get('name') for svc in (state1['hosts'][h].get('snapshot') or {}).get('non_os_services',[]) if svc.get('name')})
    snapshot_results=query_os_snapshots(ssm,host_data,checked_services,service_inclusions,service_exclusions,tracked_by_host)
    state={'schema_version':3,'batch_id':batch,'phase':phase,'account_id':account,
           'region':region,'generated_at_utc':iso_time(t),'generated_at_sydney':format_sydney_time(t),'hosts':{}}
    for host in hostnames:
        info=host_data[host]
        start_raw=t-dt.timedelta(days=baseline_days) if phase==1 else start_by_host[host]
        start=ceil_period(start_raw);end=floor_period(t)
        vols=volume_map(ec2,info['instance_id'])
        metrics,warnings,discovered=complete_metrics(cw,info['instance_id'],vols,start,end,agent_ns)
        ss=snapshot_results[host]
        if discovered==0:
            warnings.append('No CWAgent metrics discovered by InstanceId. Verify CWAgent is installed, running and includes append_dimensions InstanceId; historical guest metrics may be absent.')
        if phase==2 and (t-start_raw)<dt.timedelta(hours=24):
            warnings.append('Less than 24 hours after final upgrade: performance comparisons may be unreliable; rerun after more normal-load data is available.')
        if not any(m['samples'] for m in metrics):
            warnings.append('No CloudWatch points returned in this phase window')
        rec={'hostname':host,'instance_id':info['instance_id'],
             'instance_type':info['instance_type'],'availability_zone':info['availability_zone'],
             'server_type':types[host],'phase':phase,'critical_services':checked_services[host],
             'service_exclusions':service_exclusions[host], 'service_inclusions':service_inclusions[host],
             'volumes':vols,
             'upgrade_completed_at_sydney':start_sydney_by_host.get(host),
             'upgrade_completed_at_utc':iso_time(start_raw) if phase==2 else None,
             'window':{'start':iso_time(start),'end':iso_time(end),
                       'hours':max(0,int((end-start).total_seconds()/PERIOD))},
             'ssm_status':ss['status'],'ssm_error':ss.get('error'),
             'agent_metric_count':discovered,
             'snapshot':ss.get('snapshot'),'metrics':metrics,'warnings':warnings}
        baseline=state1['hosts'][host] if state1 is not None else None
        rec['checks']=validate_host(host,rec,before.get(host),baseline)
        if phase==2:
            rec['prior_comparison']=calculate_prior_changes(rec,before.get(host))
            regressions=[x for x in rec['prior_comparison'] if x['status']=='WARN']
            for item in regressions:
                rec['checks'].append(check('WARN','Regression vs RHEL 8.8 baseline: '+item['metric'],
                    'Hourly mean %+.1f%% from baseline; check workload comparability'%item['change_pct'],
                    'Performance'))
        else:rec['prior_comparison']=[]
        state['hosts'][host]=rec

    report_key=key_for(prefix,batch,'phase-%d.html'%phase)
    write(s3,bucket,report_key,phase_html(state),'text/html; charset=utf-8')
    data_key=key_for(prefix,batch,'.state/phase-%d.json'%phase)
    write(s3,bucket,data_key,json.dumps(state,ensure_ascii=False,separators=(',',':')),'application/json')
    status_key=key_for(prefix,batch,'phase-%d-status.json'%phase)
    result={'batch_id':batch,'phase':phase,'account_id':account,'region':region,'script_version':VERSION,
            'report':'s3://%s/%s'%(bucket,report_key),
            'status_json':'s3://%s/%s'%(bucket,status_key),
            'host_statuses':{host:status_of(rec['checks']) for host,rec in state['hosts'].items()}}
    summary_key=None
    if phase==2:
        summary_key=key_for(prefix,batch,'final-summary.html')
        write(s3,bucket,summary_key,final_html([state1,state]),'text/html; charset=utf-8')
        result['final_summary']='s3://%s/%s'%(bucket,summary_key)
    diagnostic=phase_diagnostic(state,report_key,data_key)
    diagnostic['final_summary_s3_key']=summary_key
    write(s3,bucket,status_key,json.dumps(diagnostic,ensure_ascii=False,indent=2),'application/json')
    result['execution_status']=diagnostic['execution_status']
    return result


def datetime_from_state(value):
    return parse_time(value) if value else None


def lambda_handler(event, context):
    try:
        return _run_phase(event, context)
    except Exception as error:
        LOG.exception('RHEL OS report invocation failed')
        try:
            if isinstance(event,dict):
                phase=int(event.get('phase',0))
                batch=clean_batch(event.get('batch_id'))
                if phase in (1,2):
                    bucket=setting('REPORT_BUCKET',True)
                    prefix=setting('REPORT_PREFIX',default='rhel-upgrade-reports').strip('/')
                    key=key_for(prefix,batch,'phase-%d-execution-error-%s.json'%(phase,now_utc().strftime('%Y%m%dT%H%M%S%fZ')))
                    body={'tool_version':VERSION,'batch_id':batch,'phase':phase,
                          'generated_at_utc':iso_time(now_utc()),'execution_status':'ERROR',
                          'exception_type':type(error).__name__,
                          'error':str(error)[:1500],
                          'note':'Lambda failed before a successful phase report. See CloudWatch Lambda logs. Existing success state has not been deleted. Phase 1 is before upgrade; Phase 2 is after final RHEL 9.6 upgrade.'}
                    client=boto3.client('s3')
                    write(client,bucket,key,json.dumps(body,indent=2),'application/json')
                    html_key=key[:-5]+'.html'
                    error_body='<section class="card"><h2>Phase execution failed</h2><p>This is an execution diagnostic, not a successful phase report. No upgrade action was performed.</p><p><strong>Exception:</strong> '+esc(type(error).__name__)+'</p><pre>'+esc(str(error)[:1500])+'</pre><p>Correct the issue, then invoke the phase again. If an earlier successful phase already exists, do not overwrite it unless explicitly intended.</p></section>'
                    write(client,bucket,html_key,
                          html_layout('RHEL OS report — Phase %d execution error'%phase,
                                      'Batch %s | %s'%(batch,VERSION),error_body,{}),
                          'text/html; charset=utf-8')
        except Exception:
            LOG.warning('Unable to write the best-effort phase execution error JSON',exc_info=True)
        raise
