def phase_html(state):
    phase=state['phase'];batch=state['batch_id']
    phase_label='Before upgrade — RHEL 8.8 baseline' if phase==1 else 'After upgrade — RHEL 9.6'
    title='RHEL OS upgrade — Phase %d: %s'%(phase,phase_label)
    generated=parse_time(state['generated_at_utc'])
    subtitle='Batch %s | AWS account %s | Region %s | Generated %s | Script %s'%(
        batch,state['account_id'],state['region'],format_sydney_time(generated),VERSION)
    counts=defaultdict(int)
    for rec in state['hosts'].values():counts[status_of(rec['checks'])]+=1
    body='<div class="card"><h2>Executive summary</h2><div class="summary">'+''.join(
        '<div class="stat"><strong>%s</strong>%s</div>'%(v,esc(label))
        for v,label in [(len(state['hosts']),'EC2 instances'),(counts['PASS'],'PASS'),
                        (counts['WARN'],'WARN'),(counts['FAIL'],'FAIL')])+\
        '</div><p>'+esc('Phase %d — %s. Expected RHEL version is 8.8 before upgrade and 9.6 after upgrade.'%(phase,phase_label))+\
        '</p></div>'
    issues=[]
    for host,rec in state['hosts'].items():
        for c in rec['checks']:
            if c['status'] in ('WARN','FAIL'):
                issues.append([esc(host),badge(c['status']),esc(c['group']),esc(c['check']),esc(c['detail'])])
    body+='<section class="card"><h2>Phase %d validation / action required</h2>'%phase
    if issues:
        body+='<p>Investigate the issues below. For Phase 2, review all FAIL/WARN findings before accepting the RHEL 9.6 upgrade.</p>'+table(
            ['Hostname','Severity','Area','Validation','Finding'],issues)
    else:
        body+='<p>No checks currently flagged WARN or FAIL.</p>'
    body+='</section>'
    exports={'metrics':[],'hourly':[],'checks':[],'services':[]}
    if phase==2:
        exports['comparison']=[]
    for host,rec in state['hosts'].items():
        export_rows(host,rec,exports)
        if phase==2:
            for item in rec.get('prior_comparison',[]):
                exports['comparison'].append({
                    'hostname':host,'instance_id':rec['instance_id'],
                    'server_type':rec['server_type'],**item})
        window=rec['window']
        body+='<section class="card"><h2>'+esc(host)+' '+badge(status_of(rec['checks']))+'</h2>'
        body+='<p class="muted">'+esc(rec['instance_id'])+' | '+esc(rec['server_type'].upper())+\
              ' | '+esc(rec['instance_type'])+' | '+esc(window['start'])+' to '+esc(window['end'])+\
              ' | '+esc(window['hours'])+' complete hours</p>'
        svcs=(rec.get('snapshot') or {}).get('non_os_services',[])
        body+='<h3>Non-default service inventory (auto-discovered)</h3>'
        body+=table(['Service','State','Startup','RPM package','Classification'],
          [[esc(x.get(k,'')) for k in ('name','active_state','enablement','rpm_package','classification')] for x in svcs])
        if not svcs:body+='<p>No non-core service units detected, or SSM inventory is unavailable.</p>'
        if rec.get('upgrade_completed_at_sydney'):
            body+='<p>Declared final upgrade completion (Sydney): <strong>'+esc(format_sydney_time(parse_sydney_time(rec['upgrade_completed_at_sydney'])[0]))+'</strong>'
            body+=' | Stored/query time (UTC): '+esc(rec.get('upgrade_completed_at_utc'))+'</p>'
        if rec.get('warnings'):
            body+='<div class="warning"><strong>Collection notes</strong><ul>'+''.join(
                '<li>'+esc(x)+'</li>' for x in rec['warnings'])+'</ul></div>'
        rows=[]
        for m in rec['metrics']:
            rows.append([esc(m['category']),esc(m['label']),esc(m['unit']),
                         esc(num(m['mean'])),esc(num(m['p95'])),esc(num(m['min'])),
                         esc(num(m['max'])),esc(m['samples']),
                         esc(str(m['coverage_pct'])+'%'),sparkline(m['points'])])
        body+='<h3>Hourly CloudWatch performance metrics</h3>'+table(
            ['Category','Metric','Unit','Average','P95','Min','Max','Hours','Coverage','Trend'],rows)
        prior=rec.get('prior_comparison',[])
        if prior:
            pr=[]
            for x in prior:
                change=x.get('change_pct')
                pr.append([esc(x['metric']),esc(x['unit']),esc(num(x.get('before'))),
                           esc(num(x.get('after'))),
                           esc(('%+.1f%%'%change) if change is not None else '—'),
                           badge(x['status']) if x['status'] in ('PASS','WARN','FAIL') else esc(x['status'])])
            body+='<h3>Change from RHEL 8.8 baseline (hourly means)</h3>'+table(
                ['Metric','Unit','Before','After','Change','Review'],pr)
        checks=rec['checks']
        body+='<h3>OS validation results</h3>'+table(['Status','Group','Check','Evidence / observation'],
             [[badge(c['status']),esc(c['group']),esc(c['check']),esc(c['detail'])] for c in checks])
        body+='<details><summary>Complete live OS snapshot</summary>'+host_snapshot_html(rec.get('snapshot'))+'</details>'
        body+='</section>'
    return html_layout(title,subtitle,body,exports)


def phase_metric_diff(a,b):
    if not a or not b:return None
    x=a.get('mean');y=b.get('mean')
    if x is None or y is None or x==0:return None
    return round(100*(y-x)/abs(x),2)


