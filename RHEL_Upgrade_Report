def export_rows(host, record, exports):
    iid=record['instance_id']; phase=record['phase']; typ=record['server_type']
    for m in record.get('metrics',[]):
        basic={'hostname':host,'instance_id':iid,'server_type':typ,'phase':phase,
               'label':m['label'],'category':m['category'],'unit':m['unit']}
        exports['metrics'].append({**basic,'mean':m['mean'],'p95':m['p95'],
               'min':m['min'],'max':m['max'],'latest':m['latest'],
               'samples':m['samples'],'coverage_pct':m['coverage_pct']})
        for t,val in m.get('points',[]):
            exports['hourly'].append({**basic,'timestamp_utc':t,'value':val})
    for c in record.get('checks',[]):
        exports['checks'].append({'hostname':host,'instance_id':iid,'phase':phase,**c})
    for x in (record.get('snapshot') or {}).get('non_os_services',[]):
        exports['services'].append({'hostname':host,'instance_id':iid,'phase':phase,**x})


