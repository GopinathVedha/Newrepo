        if not svcs:body+='<p>No non-core service units detected, or SSM inventory is unavailable.</p>'
        if rec.get('upgrade_completed_at_utc'):
            body+='<p>Declared upgrade completed: <strong>'+esc(rec['upgrade_completed_at_utc'])+'</strong></p>'
        if rec.get('warnings'):
