"""Central CloudWatch Logs retention audit. Handler: lambda_function.lambda_handler."""
import csv
import io
import json
import math
import os
import re
import uuid
from collections import Counter
from datetime import datetime, timezone

REGION = "ap-southeast-2"
RETENTIONS = {1, 3, 5, 7, 14, 30, 60, 90, 120, 150, 180, 365, 400, 545,
              731, 1096, 1827, 2192, 2557, 2922, 3288, 3653}
FIELDS = ["account_id", "region", "log_group", "log_class", "retention_before",
          "target_days", "status", "stored_bytes_snapshot", "storage_gib_proxy",
          "usd_per_gib_month_input", "monthly_storage_usd_proxy", "detail"]
CAVEAT = ("Storage cost proxy only: snapshot storedBytes / 2^30 multiplied by your supplied "
          "class-specific monthly rate. Not an AWS bill or savings forecast. Archived storage "
          "billing uses compressed data; inventory is not a billing meter. No age distribution "
          "is available, so reclaimable bytes and savings are unknown. Ingestion, queries, "
          "taxes, discounts, free tier, S3, SNS, KMS and Lambda costs are excluded. "
          "Retention does not refund ingestion charges. Bytes are captured before changes.")


def boolean(env, name, default):
    value = env.get(name, default).lower().strip()
    if value not in {"true", "false"}:
        raise ValueError(name + " must be true or false")
    return value == "true"


def configuration(env=None):
    env = os.environ if env is None else env
    accounts = list(dict.fromkeys(x.strip() for x in env.get("TARGET_ACCOUNT_IDS", "").split(",")))
    if not accounts or any(not re.fullmatch(r"\d{12}", a) for a in accounts):
        raise ValueError("TARGET_ACCOUNT_IDS must contain comma-separated 12-digit IDs")
    days = int(env.get("RETENTION_DAYS", "365"))
    if days not in RETENTIONS:
        raise ValueError("RETENTION_DAYS is not supported by CloudWatch Logs")
    dry = boolean(env, "DRY_RUN", "true")
    if not dry and env.get("ENFORCEMENT_CONFIRMATION") != f"APPLY_RETENTION_{days}_DAYS":
        raise ValueError("Enforcement blocked: confirmation must match APPLY_RETENTION_<days>_DAYS")
    bucket = env.get("REPORT_BUCKET", "").strip()
    prefix = env.get("REPORT_PREFIX", "cloudwatch-retention-audit").strip("/")
    if not re.fullmatch(r"[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]", bucket):
        raise ValueError("REPORT_BUCKET must be an existing bucket name, not a URI")
    if not prefix or any(p in {".", ".."} for p in prefix.split("/")) or any(ord(c) < 32 for c in prefix):
        raise ValueError("REPORT_PREFIX must be a nonempty safe key prefix")
    role = env.get("TARGET_ROLE_NAME", "CloudWatchRetentionAuditRole")
    if not re.fullmatch(r"[A-Za-z0-9+=,.@_/-]+", role) or role.startswith("/"):
        raise ValueError("Invalid TARGET_ROLE_NAME (optional path, without leading slash)")
    topic = env.get("SNS_TOPIC_ARN", "").strip()
    if topic and not re.fullmatch(r"arn:aws:sns:ap-southeast-2:\d{12}:[A-Za-z0-9_-]+", topic):
        raise ValueError("SNS_TOPIC_ARN must be a standard topic in ap-southeast-2")
    rates = json.loads(env.get("STORAGE_RATES_USD_PER_GIB_MONTH", "{}"))
    if not isinstance(rates, dict) or any(k not in {"STANDARD", "INFREQUENT_ACCESS"} or
            isinstance(v, bool) or not isinstance(v, (int, float)) or not math.isfinite(v) or v < 0
            for k, v in rates.items()):
        raise ValueError("Storage rates must be nonnegative finite numbers by supported log class")
    maximum = int(env.get("MAX_LOG_GROUPS", "10000"))
    if not 1 <= maximum <= 50000:
        raise ValueError("MAX_LOG_GROUPS must be 1..50000")
    key = env.get("S3_KMS_KEY_ARN", "").strip()
    if key and not re.fullmatch(r"arn:aws:kms:ap-southeast-2:\d{12}:key/[A-Za-z0-9-]+", key):
        raise ValueError("S3_KMS_KEY_ARN must be a full key ARN in ap-southeast-2")
    excludes = [x.strip() for x in env.get("EXCLUDE_LOG_GROUP_PREFIXES", "").split(",") if x.strip()]
    return dict(excludes=excludes, accounts=accounts, days=days, dry=dry, bucket=bucket, prefix=prefix,
                role=role, topic=topic, rates=rates, maximum=maximum, key=key,
                external_id=env.get("ASSUME_ROLE_EXTERNAL_ID", ""))


def blank_row(account, cfg, status, detail=""):
    row = dict.fromkeys(FIELDS, "")
    row.update(account_id=account, region=REGION, target_days=cfg["days"], status=status, detail=detail)
    return row


def assess(group, account, cfg, logs):
    row = blank_row(account, cfg, "COMPLIANT")
    before = group.get("retentionInDays")
    cls = group.get("logGroupClass", "STANDARD")
    size = group.get("storedBytes")
    row.update(log_group=group["logGroupName"], log_class=cls,
               retention_before=before if before is not None else "Never expire",
               stored_bytes_snapshot=size if size is not None else "")
    rate = cfg["rates"].get(cls)
    if size is not None:
        gib = size / (2 ** 30)
        row["storage_gib_proxy"] = round(gib, 9)
        if rate is not None:
            row["usd_per_gib_month_input"] = rate
            row["monthly_storage_usd_proxy"] = round(gib * rate, 6)
    if cls not in {"STANDARD", "INFREQUENT_ACCESS"}:
        row.update(status="UNSUPPORTED_CLASS", detail="Not changed; class requires separate review")
    elif any(group["logGroupName"].startswith(p) for p in cfg["excludes"]):
        row.update(status="EXCLUDED", detail="Matched EXCLUDE_LOG_GROUP_PREFIXES")
    elif before is None or before > cfg["days"]:
        if cfg["dry"]:
            row["status"] = "WOULD_CHANGE"
        else:
            try:
                logs.put_retention_policy(logGroupName=group["logGroupName"], retentionInDays=cfg["days"])
                row.update(status="UPDATED", detail="API accepted; deletion is asynchronous")
            except Exception as exc:
                row.update(status="UPDATE_FAILED", detail=str(exc)[:1000])
    elif before < cfg["days"]:
        row["status"] = "SHORTER_PRESERVED"
    return row


def csv_cell(value):
    text = str(value)
    # Protect spreadsheet consumers against formula injection, including leading whitespace.
    return "'" + text if text.lstrip().startswith(("=", "+", "-", "@")) or text.startswith(("\t", "\r", "\n")) else text


def csv_report(rows):
    stream = io.StringIO(newline="")
    writer = csv.writer(stream)
    writer.writerow(FIELDS)
    writer.writerows([csv_cell(row.get(key, "")) for key in FIELDS] for row in rows)
    return "\ufeff" + stream.getvalue()


