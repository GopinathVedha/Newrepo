def html_report(rows, summary):
    payload = json.dumps(dict(rows=rows, fields=FIELDS, summary=summary, caveat=CAVEAT), ensure_ascii=True)
    payload = payload.replace("<", "\\u003c").replace(">", "\\u003e").replace("&", "\\u0026")
    return HTML_TEMPLATE.replace("__AUDIT_DATA__", payload)


def audit(cfg, session, context=None):
    from botocore.config import Config
    sdk_config = Config(retries={"mode": "standard", "total_max_attempts": 3},
                        connect_timeout=3, read_timeout=10)
    def client(service, **kwargs):
        return session.client(service, region_name=REGION, config=sdk_config, **kwargs)
    sts = client("sts")
    rows, accounts, count = [], [], 0
    def near_deadline():
        return context is not None and context.get_remaining_time_in_millis() < 120000
    for account in cfg["accounts"]:
        if near_deadline() or count >= cfg["maximum"]:
            rows.append(blank_row(account, cfg, "NOT_SCANNED", "Time or inventory limit reached; split account list"))
            accounts.append({"account_id": account, "status": "NOT_SCANNED", "groups": 0})
            continue
        scanned = 0
        state = "COMPLETE"
        try:
            args = dict(RoleArn=f"arn:aws:iam::{account}:role/{cfg['role']}",
                        RoleSessionName="CloudWatchRetentionAudit", DurationSeconds=3600)
            if cfg["external_id"]:
                args["ExternalId"] = cfg["external_id"]
            cred = sts.assume_role(**args)["Credentials"]
            logs = client("logs", aws_access_key_id=cred["AccessKeyId"],
                          aws_secret_access_key=cred["SecretAccessKey"], aws_session_token=cred["SessionToken"])
            pages = iter(logs.get_paginator("describe_log_groups").paginate(includeLinkedAccounts=False))
            stop = False
            while not stop:
                if near_deadline():
                    state = "PARTIAL"
                    break
                page = next(pages, None)
                if page is None:
                    break
                for group in page.get("logGroups", []):
                    if near_deadline() or count >= cfg["maximum"]:
                        state, stop = "PARTIAL", True
                        break
                    rows.append(assess(group, account, cfg, logs))
                    count += 1
                    scanned += 1
            if state == "PARTIAL":
                rows.append(blank_row(account, cfg, "SCAN_PARTIAL", "Time or inventory limit reached; split account list"))
            elif not scanned:
                rows.append(blank_row(account, cfg, "NO_LOG_GROUPS"))
        except Exception as exc:
            state = "FAILED" if not scanned else "PARTIAL"
            rows.append(blank_row(account, cfg, "SCAN_FAILED", str(exc)[:1000]))
        accounts.append({"account_id": account, "status": state, "groups": scanned})
    statuses = dict(Counter(row["status"] for row in rows))
    incomplete = any(a["status"] != "COMPLETE" for a in accounts)
    problem = incomplete or any(statuses.get(s, 0) for s in ("UPDATE_FAILED", "UNSUPPORTED_CLASS"))
    summary = dict(run_id=datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + uuid.uuid4().hex[:12],
                   generated_utc=datetime.now(timezone.utc).isoformat(), region=REGION,
                   dry_run=cfg["dry"], retention_days=cfg["days"], policy="maximum retention; preserve shorter",
                   outcome="ATTENTION" if problem else "COMPLETE", inventory_complete=not incomplete,
                   groups_scanned=count, accounts=accounts, statuses=statuses,
                   rates=cfg["rates"], cost_caveat=CAVEAT)
    # No grand total: unpriced classes and partial scans must not look like a complete bill.
    base = f"{cfg['prefix']}/{summary['run_id']}"
    s3 = client("s3")
    extra = {"ServerSideEncryption": "aws:kms", "SSEKMSKeyId": cfg["key"]} if cfg["key"] else {}
    artifacts = {"inventory.csv": (csv_report(rows), "text/csv; charset=utf-8"),
                 "report.html": (html_report(rows, summary), "text/html; charset=utf-8")}
    uris = {name: f"s3://{cfg['bucket']}/{base}/{name}" for name in [*artifacts, "summary.json"]}
    summary["artifacts"] = uris
    artifacts["summary.json"] = (json.dumps(summary, indent=2), "application/json")
    # Summary is written last and is the completion marker for report uploads.
    for name, (body, mime) in artifacts.items():
        s3.put_object(Bucket=cfg["bucket"], Key=f"{base}/{name}", Body=body.encode("utf-8"),
                      ContentType=mime, CacheControl="no-store", **extra)
    if cfg["topic"]:
        client("sns").publish(TopicArn=cfg["topic"], Subject=f"CloudWatch retention audit: {summary['outcome']}",
                              Message=json.dumps({k: summary[k] for k in ["run_id", "outcome", "dry_run", "groups_scanned", "statuses", "artifacts"]}, indent=2))
    return summary


def lambda_handler(event, context):
    # Deliberately ignore invocation payload: it cannot enable enforcement or replace scope.
    cfg = configuration()
    import boto3
    result = audit(cfg, boto3.Session(), context)
    print(json.dumps({k: result[k] for k in ("run_id", "outcome", "groups_scanned", "statuses")}))
    return result
