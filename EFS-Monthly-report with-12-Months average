MEMBER_ACCOUNT_IDS = [a.strip() for a in os.environ["MEMBER_ACCOUNT_IDS"].split(",") if a.strip()]
CROSS_ACCOUNT_ROLE_NAME = os.environ.get("CROSS_ACCOUNT_ROLE_NAME", "EFSMonthlyReportRole")
def _parse_account_names():
    raw = os.environ.get("ACCOUNT_NAMES", "{}").strip()
    if not raw:
        return {}
    try:
        parsed = json.loads(raw)
        if not isinstance(parsed, dict):
            print(f"ACCOUNT_NAMES env var is valid JSON but not an object - ignoring. Got: {raw!r}")
            return {}
        return {str(k): str(v) for k, v in parsed.items()}
    except json.JSONDecodeError as e:
        # ACCOUNT_NAMES is cosmetic (friendly labels only) - a malformed
        # value here should never take down report generation. Common
        # causes: literal single quotes instead of double quotes,
        # trailing characters pasted from the console, or an accidental
        # extra closing brace/quote.
        print(f"ACCOUNT_NAMES env var is not valid JSON ({e}) - falling back to account IDs only. Raw value: {raw!r}")
        return {}


ACCOUNT_NAMES = _parse_account_names()
WARN_PCT = float(os.environ.get("WARN_THRESHOLD_PCT", "75"))
BAD_PCT = float(os.environ.get("BAD_THRESHOLD_PCT", "90"))

s3 = boto3.client("s3", region_name=REGION)
sns = boto3.client("sns", region_name=REGION)
sts = boto3.client("sts", region_name=REGION)


def account_label(account_id):
    name = ACCOUNT_NAMES.get(account_id)
    return f"{name} ({account_id})" if name else account_id


# ---------------------------------------------------------------------------
# Cross-account session handling
# ---------------------------------------------------------------------------

def assume_member_session(account_id):
    role_arn = f"arn:aws:iam::{account_id}:role/{CROSS_ACCOUNT_ROLE_NAME}"
    resp = sts.assume_role(
        RoleArn=role_arn,
        RoleSessionName="efs-monthly-report",
        ExternalId="efs-monthly-report",  # must match the Condition in
                                           # efs-cross-account-role-trust-policy.json
        DurationSeconds=900,  # only needs to live for this one account's collection
    )
    creds = resp["Credentials"]
    return boto3.Session(
        aws_access_key_id=creds["AccessKeyId"],
        aws_secret_access_key=creds["SecretAccessKey"],
        aws_session_token=creds["SessionToken"],
        region_name=REGION,
    )


# ---------------------------------------------------------------------------
# Inventory (all functions take explicit clients - no module-level globals -
# since each account uses a different assumed-role session)
# ---------------------------------------------------------------------------

def get_tag_name(tags):
    for t in tags or []:
        if t.get("Key") == "Name":
            return t.get("Value")
    return ""


def list_file_systems(efs_client):
    fs_list = []
    paginator = efs_client.get_paginator("describe_file_systems")
    for page in paginator.paginate():
        fs_list.extend(page["FileSystems"])
    return fs_list


def get_lifecycle_policy(efs_client, fs_id):
    try:
        resp = efs_client.describe_lifecycle_configuration(FileSystemId=fs_id)
        policies = resp.get("LifecyclePolicies", [])
        ia_days = next((p["TransitionToIA"] for p in policies if "TransitionToIA" in p), None)
        back_to_std = next((p["TransitionToPrimaryStorageClass"] for p in policies if "TransitionToPrimaryStorageClass" in p), None)
        archive_days = next((p["TransitionToArchive"] for p in policies if "TransitionToArchive" in p), None)
        return {"to_ia": ia_days, "back_to_standard": back_to_std, "to_archive": archive_days}
    except Exception as e:
        print(f"lifecycle lookup failed for {fs_id}: {e}")
        return {"to_ia": None, "back_to_standard": None, "to_archive": None}


# ---------------------------------------------------------------------------
# Metrics
# ---------------------------------------------------------------------------

def get_series(cw_client, fs_id, metric_name, start_date, end_date, stat="Average", storage_class=None):
    dims = [{"Name": "FileSystemId", "Value": fs_id}]
    if storage_class:
        dims.append({"Name": "StorageClass", "Value": storage_class})
    return get_daily_metric(cw_client, "AWS/EFS", metric_name, dims, start_date, end_date, stat=stat)


def build_fs_report(efs_client, cw_client, fs, account_id, start_date, end_date):
    fs_id = fs["FileSystemId"]
    name = get_tag_name(fs.get("Tags")) or fs_id
    performance_mode = fs.get("PerformanceMode", "N/A")
    throughput_mode = fs.get("ThroughputMode", "N/A")
    lifecycle = get_lifecycle_policy(efs_client, fs_id)

    total_series = get_series(cw_client, fs_id, "StorageBytes", start_date, end_date, storage_class="Total")
    std_series = get_series(cw_client, fs_id, "StorageBytes", start_date, end_date, storage_class="Standard")
    ia_series = get_series(cw_client, fs_id, "StorageBytes", start_date, end_date, storage_class="IA")
    archive_series = get_series(cw_client, fs_id, "StorageBytes", start_date, end_date, storage_class="Archive")

    permitted_tp = get_series(cw_client, fs_id, "PermittedThroughput", start_date, end_date, stat="Average")
    metered_io = get_series(cw_client, fs_id, "MeteredIOBytes", start_date, end_date, stat="Sum")

    # ACTUAL observed throughput, as distinct from the PermittedThroughput
    # ceiling above. TotalIOBytes is the real number of bytes processed
    # (Sum), which we divide by seconds-in-day to get bytes/sec - this
    # answers "how much throughput is the file system actually using",
    # not just "how much is it allowed to use".
    total_io_bytes = get_series(cw_client, fs_id, "TotalIOBytes", start_date, end_date, stat="Sum")
    read_io_bytes = get_series(cw_client, fs_id, "DataReadIOBytes", start_date, end_date, stat="Sum")
    write_io_bytes = get_series(cw_client, fs_id, "DataWriteIOBytes", start_date, end_date, stat="Sum")

    # ClientConnections officially only supports the Sum statistic per
    # AWS docs (docs.aws.amazon.com/efs/latest/ug/efs-metrics.html) -
    # Average/Maximum are not guaranteed and produced inconsistent gaps
    # in an earlier version of this report. Sum over a day = total
    # connection-minutes; dividing by minutes-in-day gives an honest
    # average concurrent connection count.
    client_conn_sum = get_series(cw_client, fs_id, "ClientConnections", start_date, end_date, stat="Sum")

    burst_credit = get_series(cw_client, fs_id, "BurstCreditBalance", start_date, end_date, stat="Minimum")
    pct_io_limit = get_series(cw_client, fs_id, "PercentIOLimit", start_date, end_date, stat="Maximum")

    SECONDS_PER_DAY = 86400
    MINUTES_PER_DAY = 1440

    daily_rows = []
    for d in daterange_days(start_date, end_date):
        total_io = total_io_bytes.get(d)
        read_io = read_io_bytes.get(d)
        write_io = write_io_bytes.get(d)
        conn_sum = client_conn_sum.get(d)
        daily_rows.append({
            "date": d,
            "total": total_series.get(d),
            "standard": std_series.get(d),
            "ia": ia_series.get(d),
            "archive": archive_series.get(d),
            "permitted_throughput": permitted_tp.get(d),
            "metered_io_bytes": metered_io.get(d),
            "avg_throughput_bps": (total_io / SECONDS_PER_DAY) if total_io is not None else None,
            "avg_read_throughput_bps": (read_io / SECONDS_PER_DAY) if read_io is not None else None,
            "avg_write_throughput_bps": (write_io / SECONDS_PER_DAY) if write_io is not None else None,
            "avg_connections": (conn_sum / MINUTES_PER_DAY) if conn_sum is not None else None,
            "burst_credit_min": burst_credit.get(d),
            "pct_io_limit_max": pct_io_limit.get(d),
        })

    latest = daily_rows[-1]
    first_with_total = next((r for r in daily_rows if r["total"] is not None), None)
    growth_bytes = None
    if first_with_total and latest["total"] is not None:
        growth_bytes = latest["total"] - first_with_total["total"]

    avg_conn = _avg([r["avg_connections"] for r in daily_rows])
    avg_throughput_bps = _avg([r["avg_throughput_bps"] for r in daily_rows])
    avg_total = _avg([r["total"] for r in daily_rows])
    avg_standard = _avg([r["standard"] for r in daily_rows])
    avg_ia = _avg([r["ia"] for r in daily_rows])
    max_pct_io = max((r["pct_io_limit_max"] for r in daily_rows if r["pct_io_limit_max"] is not None), default=None)
    min_burst = min((r["burst_credit_min"] for r in daily_rows if r["burst_credit_min"] is not None), default=None)

    recommendations = build_recommendations(
        throughput_mode, lifecycle, max_pct_io, min_burst, avg_conn, latest
    )

    return {
        "account_id": account_id,
        "account_label": account_label(account_id),
        "id": fs_id, "name": name, "performance_mode": performance_mode,
        "throughput_mode": throughput_mode, "lifecycle": lifecycle,
        "daily": daily_rows, "latest": latest, "growth_bytes": growth_bytes,
        "avg_conn": avg_conn, "avg_throughput_bps": avg_throughput_bps,
        "avg_total": avg_total, "avg_standard": avg_standard, "avg_ia": avg_ia,
        "max_pct_io": max_pct_io, "min_burst": min_burst,
        "recommendations": recommendations,
    }


def _avg(values):
    vals = [v for v in values if v is not None]
    return sum(vals) / len(vals) if vals else None


def build_recommendations(throughput_mode, lifecycle, max_pct_io, min_burst, avg_conn, latest):
    recs = []
    if lifecycle["to_ia"] is None:
        recs.append("No lifecycle (IA transition) policy configured - consider enabling to reduce storage cost for cold data.")
    if lifecycle["back_to_standard"] is None and lifecycle["to_ia"] is not None:
        recs.append("IA transition is enabled but no transition-back-to-Standard policy is set - review access patterns to avoid repeated retrieval cost.")
    if throughput_mode == "bursting" and min_burst is not None and min_burst < 1_000_000_000:
        recs.append("Burst credit balance dropped low this month - sustained throughput may be exceeding baseline; consider Elastic or Provisioned throughput mode.")
    if throughput_mode == "bursting" and max_pct_io is not None and max_pct_io >= 90:
        recs.append("PercentIOLimit hit >= 90% on Bursting mode - file system is I/O constrained; consider Elastic throughput mode.")
    if avg_conn is not None and avg_conn < 1 and (latest["total"] or 0) > 0:
        recs.append("Very low average client connections with nonzero storage - file system may be idle; candidate for lifecycle review or decommission.")
    if lifecycle["to_ia"] is not None and latest["ia"] and latest["standard"] and latest["ia"] > latest["standard"]:
        recs.append("Majority of data has moved to IA storage - lifecycle policy is working as intended, contributing to cost savings.")
    if not recs:
        recs.append("No action items - configuration and utilization look healthy for this period.")
    return recs


# ---------------------------------------------------------------------------
# Cross-account collection
# ---------------------------------------------------------------------------

def collect_account_reports(account_id, start_date, end_date):
    """Returns (reports_list, error_message_or_None) for one account."""
    try:
        session = assume_member_session(account_id)
        efs_client = session.client("efs")
        cw_client = session.client("cloudwatch")
        file_systems = list_file_systems(efs_client)
        reports = [
            build_fs_report(efs_client, cw_client, fs, account_id, start_date, end_date)
            for fs in file_systems
        ]
        return reports, None
    except Exception as e:
        print(f"Failed to collect account {account_id}: {e}")
        return [], str(e)


