        html.append("</div>")

    # Plain-language glossary for auditors / non-technical readers.
    html.append("""
<div class="section">
  <h2>What These Metrics Mean</h2>
  <p class="note">Written for reviewers who may not work with AWS day-to-day. Technical column names are in <em>italics</em>.</p>
  <ul style="line-height:1.9; font-size:13px;">
    <li><strong>Total / Standard / IA / Archive</strong> (<em>StorageBytes</em>) &mdash; how much data is stored, broken down by storage tier. <strong>Standard</strong> is the normal, most expensive tier for actively-used files. <strong>IA</strong> (Infrequent Access) and <strong>Archive</strong> are cheaper tiers AWS automatically moves older, rarely-touched files into, if a lifecycle policy is configured. <strong>Total</strong> is all tiers added together.</li>
    <li><strong>Permitted Throughput (ceiling)</strong> (<em>PermittedThroughput</em>) &mdash; the maximum data transfer speed AWS currently allows this file system to run at. This is a limit, not a measurement of actual use - it goes up and down based on file system size and available burst credits (see below).</li>
    <li><strong>Actual Throughput Used</strong> (<em>TotalIOBytes</em>, converted to a rate) &mdash; the real, measured data transfer speed the file system was driving that day. Comparing this to the Permitted Throughput ceiling shows how close to the limit the system is running - a wide gap means plenty of headroom; the two numbers being close means the file system is close to being constrained.</li>
    <li><strong>Metered IO</strong> (<em>MeteredIOBytes</em>) &mdash; the total amount of data AWS counted for billing/throughput-limit purposes that day, combining reads, writes, and file-management operations. Reads count for less than writes in this figure, per AWS's metering rules.</li>
    <li><strong>Avg Connections</strong> (<em>ClientConnections</em>) &mdash; the average number of servers/computers connected to this file system at the same time throughout the day. A number near 0 suggests the file system had little or no active use that day.</li>
    <li><strong>Burst Credit (min)</strong> (<em>BurstCreditBalance</em>) &mdash; a reserve of "extra speed" the file system can draw on when it needs to run faster than its normal baseline rate, similar to a savings account for speed. AWS caps this reserve at 2.1 TiB for smaller file systems (scaling up for larger ones). <strong>A constant, unchanging value near this cap is normal and healthy</strong> - it simply means the file system rarely needed to dip into its reserve that day. A number that is falling toward zero is the one worth investigating, since it means the file system is close to being throttled back to its baseline speed.</li>
    <li><strong>IO Limit %</strong> (<em>PercentIOLimit</em>) &mdash; how close the file system came to its overall operations ceiling that day (separate from the throughput/speed limit above). Values consistently near 100% indicate the file system is a candidate for a different performance mode.</li>
  </ul>
</div>
""")

    html.append(f"""
<div class="footer">
  <span>EFS Monthly Report &middot; multi-account &middot; auto-generated &middot; for audit / capacity-planning use</span>
  <span>Report period {start_date.isoformat()} to {end_date.isoformat()}</span>
</div>
</div>
<script>{CSV_EXPORT_JS}</script>
</body></html>""")

    return "".join(html)


# ---------------------------------------------------------------------------
# Handler
# ---------------------------------------------------------------------------

def lambda_handler(event, context):
    start_date, end_date = get_previous_month_range()
    generated_at = datetime.datetime.utcnow().strftime("%Y-%m-%d %H:%M UTC")

    all_reports = []
    account_status = {}
    for account_id in MEMBER_ACCOUNT_IDS:
        reports, error = collect_account_reports(account_id, start_date, end_date)
        account_status[account_id] = {
            "ok": error is None,
            "error": error,
            "fs_count": len(reports),
        }
        all_reports.extend(reports)

    # Rolling 12-month history: load, add this month's per-file-system
    # averages, prune to 12 months, save. Keyed by "account_id:fs_id" since
    # this report spans multiple accounts. Stored under the same S3 prefix
    # this report already has write access to - no new IAM permission needed.
    history_key = "efs-report/_history/efs-history.json"
    history = load_history(s3, BUCKET, history_key)
    this_month_key = month_key(start_date)
    prev_month_key = previous_month_key(start_date)
    for r in all_reports:
        resource_key = f'{r["account_id"]}:{r["id"]}'
        label = f'{r["account_label"]} / {r["name"]}'
        metrics = {
            "avg_total": r["avg_total"],
            "avg_standard": r["avg_standard"],
            "avg_ia": r["avg_ia"],
            "avg_throughput_bps": r["avg_throughput_bps"],
            "avg_conn": r["avg_conn"],
            "max_pct_io": r["max_pct_io"],
            "growth_bytes": r["growth_bytes"],
        }
        update_history(history, resource_key, label, this_month_key, metrics)
    save_history(s3, BUCKET, history_key, history, kms_key_id=KMS_KEY_ID)

    html_report = render_html(
        all_reports, account_status, start_date, end_date, generated_at,
        history=history, this_month_key=this_month_key, prev_month_key=prev_month_key,
    )

    key = f"efs-report/{start_date.strftime('%Y')}/{start_date.strftime('%m')}/efs-report-{start_date.strftime('%Y-%m')}.html"
    s3_uri = upload_html_to_s3(s3, BUCKET, key, html_report, kms_key_id=KMS_KEY_ID)

    url = generate_presigned_url_via_role(BUCKET, key, REGION, expires_seconds=PRESIGNED_URL_EXPIRY_SECONDS)

    accounts_ok = sum(1 for s in account_status.values() if s["ok"])
    accounts_failed = [a for a, s in account_status.items() if not s["ok"]]
    expiry_minutes = PRESIGNED_URL_EXPIRY_SECONDS // 60
    subject = f"EFS Monthly Report - {start_date.strftime('%B %Y')}"
    message_lines = [
        f"The EFS monthly capacity & performance report for {start_date.strftime('%B %Y')} is ready.",
        f"Accounts reported: {accounts_ok} / {len(MEMBER_ACCOUNT_IDS)}",
    ]
    if accounts_failed:
        message_lines.append(f"Accounts with collection errors (see report for details): {', '.join(accounts_failed)}")
    message_lines += [
        "",
        f"Report link (valid ~{expiry_minutes} minutes - click soon after receiving this email):\n{url}",
        "",
        f"If the link has expired, the report is still saved at: {s3_uri} - "
        f"re-run the report Lambda to get a fresh link, or download the "
        f"object directly from the S3 console.",
    ]
    publish_sns(sns, TOPIC_ARN, subject, "\n".join(message_lines))

    return {"statusCode": 200, "body": f"Report uploaded to {s3_uri} and notification sent."}
