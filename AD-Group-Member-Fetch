<#
.SYNOPSIS
    Export TG-group direct-user members, and the members of the RG groups nested
    inside those TG groups (a different domain), into one Excel workbook.

.DESCRIPTION
    Replaces two separate scripts (tg-ad-filter / rg-ad-user) with one, parameterized
    by domain. The pipeline is sequential, not two independent lookups:

      1. Query TGDomain for groups matching -TGPrefix.
      2. For each TG group, get its DIRECT members only (no -Recursive) and split by
         objectClass:
           - "user"  -> goes straight into the TG-Members sheet.
           - "group" -> its SamAccountName is a candidate RG group name. These nested
             groups actually live in RGDomain, so they can't be expanded against
             TGDomain (this mirrors the original tg-ad-filter.txt, which only logged
             them as ObjectType "Group" instead of expanding them).
      3. Collapse the candidate RG names to unique values - the same RG group can be
         nested under multiple TG groups, and must only be queried once.
      4. For each unique RG name, query RGDomain (a different server) -Recursive, so
         any groups nested *inside* the RG group (within the RG domain itself) are
         flattened down to their user members.
      5. De-duplicate the RG sheet by RGName + SamAccountName, in case an RG group's
         own nested structure produces the same user twice.

.PARAMETER TGDomain
    Domain controller / domain FQDN to query for TG groups (e.g. aprs.trqns.internal).

.PARAMETER RGDomain
    Domain controller / domain FQDN to query for RG groups (e.g. mgrt.trqns.internal).

.PARAMETER TGPrefix
    Prefix used to find TG groups. Default: tg-appequipcloud

.PARAMETER OutputExcelPath
    Path to the output .xlsx file. Default: Desktop\AD-Group-Members.xlsx

.EXAMPLE
    .\Export-AD-TG-RG-Members.ps1 -TGDomain "aprs.trqns.internal" -RGDomain "mgrt.trqns.internal"

.NOTES
    Requires the ImportExcel module (Install-Module ImportExcel -Scope CurrentUser).
    Requires the ActiveDirectory module (RSAT).
#>

[CmdletBinding()]
param(
    [Parameter(Mandatory = $true)]
    [string]$TGDomain,

    [Parameter(Mandatory = $true)]
    [string]$RGDomain,

    [string]$TGPrefix = "tg-appequipcloud",

    [string]$OutputExcelPath = "$home\Desktop\AD-Group-Members.xlsx",

    # Optional: pass -Credential (Get-Credential) if TG/RG domains need different creds
    # than the account running the script.
    [System.Management.Automation.PSCredential]$Credential
)

$ErrorActionPreference = "Stop"

# --- Prereqs -----------------------------------------------------------

if (-not (Get-Module -ListAvailable -Name ActiveDirectory)) {
    throw "The ActiveDirectory module (RSAT) is not installed on this machine."
}
Import-Module ActiveDirectory -ErrorAction Stop

if (-not (Get-Module -ListAvailable -Name ImportExcel)) {
    Write-Host "ImportExcel module not found - installing for current user..." -ForegroundColor Yellow
    Install-Module ImportExcel -Scope CurrentUser -Force -ErrorAction Stop
}
Import-Module ImportExcel -ErrorAction Stop

# --- Helper: resolve a group's DIRECT members, split into users / nested groups ----

function Get-DirectGroupMembers {
    param(
        [Parameter(Mandatory)] [string]$GroupName,
        [Parameter(Mandatory)] [string]$Server,
        [System.Management.Automation.PSCredential]$Credential
    )

    $adParams = @{
        Identity = $GroupName
        Server   = $Server
        # deliberately NOT -Recursive: nested groups here live in a different domain
        # and must be resolved separately against RGDomain, not TGDomain.
    }
    if ($Credential) { $adParams["Credential"] = $Credential }

    try {
        $members = Get-ADGroupMember @adParams -ErrorAction Stop
    }
    catch {
        Write-Warning "Failed to enumerate members of group '$GroupName' on $Server`: $($_.Exception.Message)"
        return @{ Users = @(); NestedGroupNames = @() }
    }

    $userRows = [System.Collections.Generic.List[object]]::new()
    $nestedGroupNames = [System.Collections.Generic.List[string]]::new()

    foreach ($member in $members) {
        if ($member.objectClass -eq "user") {
            try {
                $userParams = @{
                    Identity   = $member
                    Server     = $Server
                    Properties = @("GivenName", "Surname", "SamAccountName", "EmailAddress", "Enabled")
                }
                if ($Credential) { $userParams["Credential"] = $Credential }

                $user = Get-ADUser @userParams -ErrorAction Stop

                $userRows.Add([PSCustomObject]@{
                    GroupName      = $GroupName
                    GivenName      = $user.GivenName
                    Surname        = $user.Surname
                    SamAccountName = $user.SamAccountName
                    EmailAddress   = $user.EmailAddress
                    Enabled        = $user.Enabled
                })
            }
            catch {
                Write-Warning "Failed to resolve user '$($member.SamAccountName)' in group '$GroupName': $($_.Exception.Message)"
            }
        }
        elseif ($member.objectClass -eq "group") {
            $nestedGroupNames.Add($member.SamAccountName)
        }
    }

    return @{ Users = $userRows; NestedGroupNames = $nestedGroupNames }
}

# --- Helper: resolve a group's members RECURSIVELY (single domain) ----

function Get-RecursiveGroupUserMembers {
    param(
        [Parameter(Mandatory)] [string]$GroupName,
        [Parameter(Mandatory)] [string]$Server,
        [System.Management.Automation.PSCredential]$Credential
    )

    $adParams = @{
        Identity  = $GroupName
        Server    = $Server
        Recursive = $true   # flattens any groups nested within RGDomain itself
    }
    if ($Credential) { $adParams["Credential"] = $Credential }

    try {
        $members = Get-ADGroupMember @adParams -ErrorAction Stop |
            Where-Object { $_.objectClass -eq "user" }
    }
    catch {
        Write-Warning "Failed to enumerate members of group '$GroupName' on $Server`: $($_.Exception.Message)"
        return @()
    }

    $results = [System.Collections.Generic.List[object]]::new()

    foreach ($member in $members) {
        try {
            $userParams = @{
                Identity   = $member
                Server     = $Server
                Properties = @("GivenName", "Surname", "SamAccountName", "EmailAddress", "Enabled")
            }
            if ($Credential) { $userParams["Credential"] = $Credential }

            $user = Get-ADUser @userParams -ErrorAction Stop

            $results.Add([PSCustomObject]@{
                RGName         = $GroupName
                GivenName      = $user.GivenName
                Surname        = $user.Surname
                SamAccountName = $user.SamAccountName
                EmailAddress   = $user.EmailAddress
                Enabled        = $user.Enabled
            })
        }
        catch {
            Write-Warning "Failed to resolve user '$($member.SamAccountName)' in group '$GroupName': $($_.Exception.Message)"
        }
    }

    return $results
}

# --- Step 1-3: TG groups -> TG user members + unique candidate RG names ----

Write-Host "Fetching TG groups matching prefix '$TGPrefix' on $TGDomain ..." -ForegroundColor Cyan

$tgGroupParams = @{
    Filter = "Name -like '$TGPrefix*'"
    Server = $TGDomain
}
if ($Credential) { $tgGroupParams["Credential"] = $Credential }

$tgGroups = Get-ADGroup @tgGroupParams -ErrorAction Stop

$tgResults           = [System.Collections.Generic.List[object]]::new()
$rgNameCandidates    = [System.Collections.Generic.List[string]]::new()

$i = 0
foreach ($group in $tgGroups) {
    $i++
    Write-Progress -Activity "TG groups" -Status $group.Name -PercentComplete (($i / [Math]::Max($tgGroups.Count,1)) * 100)

    $direct = Get-DirectGroupMembers -GroupName $group.Name -Server $TGDomain -Credential $Credential

    foreach ($u in $direct.Users) { $tgResults.Add($u) }
    foreach ($ng in $direct.NestedGroupNames) { $rgNameCandidates.Add($ng) }
}
Write-Progress -Activity "TG groups" -Completed

$tgResults = $tgResults | Sort-Object GroupName, SamAccountName -Unique

# Unique RG group names, regardless of how many TG groups they were nested under.
$uniqueRGNames = $rgNameCandidates | Sort-Object -Unique

Write-Host "TG: $($tgGroups.Count) groups, $($tgResults.Count) unique user rows, $($uniqueRGNames.Count) unique nested RG group names." -ForegroundColor Green

# --- Step 4-5: unique RG group names -> RG user members (from RGDomain) ----

Write-Host "Fetching RG group members for $($uniqueRGNames.Count) unique RG group(s) on $RGDomain ..." -ForegroundColor Cyan

$rgResults = [System.Collections.Generic.List[object]]::new()
$i = 0
foreach ($rgName in $uniqueRGNames) {
    $i++
    Write-Progress -Activity "RG groups" -Status $rgName -PercentComplete (($i / [Math]::Max($uniqueRGNames.Count,1)) * 100)
    $groupMembers = Get-RecursiveGroupUserMembers -GroupName $rgName -Server $RGDomain -Credential $Credential
    foreach ($m in $groupMembers) { $rgResults.Add($m) }
}
Write-Progress -Activity "RG groups" -Completed

$rgResults = $rgResults | Sort-Object RGName, SamAccountName -Unique

Write-Host "RG: $($uniqueRGNames.Count) groups, $($rgResults.Count) unique user rows." -ForegroundColor Green

# --- Export to a single workbook, two sheets ----------------------------

if (Test-Path $OutputExcelPath) { Remove-Item $OutputExcelPath -Force }

$tgResults | Export-Excel -Path $OutputExcelPath -WorksheetName "TG-Members" -AutoSize -FreezeTopRow -BoldTopRow -TableName "TGMembers"
$rgResults | Export-Excel -Path $OutputExcelPath -WorksheetName "RG-Members" -AutoSize -FreezeTopRow -BoldTopRow -TableName "RGMembers"

Write-Host "Done. Workbook written to $OutputExcelPath" -ForegroundColor Green
